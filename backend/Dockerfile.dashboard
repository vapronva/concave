FROM docker.io/library/node:24-trixie-slim AS build

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
      sed --in-place 's!http://deb.debian.org/debian-security!http://mirror.selectel.ru/debian-security!g; s!http://deb.debian.org/debian!http://mirror.selectel.ru/debian!g' /etc/apt/sources.list.d/debian.sources && \
      apt-get update && \
      apt-get install --assume-yes ca-certificates && \
      update-ca-certificates && \
      sed --in-place 's!http://mirror.selectel.ru/debian!https://mirror.selectel.ru/debian!g' /etc/apt/sources.list.d/debian.sources && \
      apt-get update && \
      apt-get upgrade --assume-yes && \
      apt-get install --assume-yes curl build-essential git python3 perl && \
      apt-get clean && \
      rm --recursive --force /var/lib/apt/lists/*

WORKDIR /src

COPY UPSTREAM /tmp/patches/UPSTREAM

RUN git init --quiet . && \
      git remote add origin https://github.com/get-convex/convex-backend.git && \
      git fetch --quiet --depth 1 origin "$(head -1 /tmp/patches/UPSTREAM)" && \
      git checkout --quiet FETCH_HEAD

COPY patches/backend /tmp/patches/backend
COPY apply-patches.sh /tmp/apply-patches.sh

RUN PATCHES_DIR=/tmp/patches/backend bash /tmp/apply-patches.sh /src

ARG NPM_REGISTRY=https://linux.sex/npm/

RUN [ -z "${NPM_REGISTRY}" ] || printf 'registry=%s\n' "${NPM_REGISTRY}" | tee /root/.npmrc >> npm-packages/.npmrc

RUN --mount=type=cache,target=/root/.npm npm ci --prefix scripts/

ENV PATH="/src/scripts/node_modules/.bin:${PATH}"

WORKDIR /src/npm-packages

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked pnpm install --frozen-lockfile

ENV NODE_ENV=production
ARG NEXT_PUBLIC_LOAD_MONACO_INTERNALLY="true"
ARG NEXT_PUBLIC_DISABLE_CONVEX_VERSION_CHECK=""
ENV NEXT_PUBLIC_LOAD_MONACO_INTERNALLY=${NEXT_PUBLIC_LOAD_MONACO_INTERNALLY}
ENV NEXT_PUBLIC_DISABLE_CONVEX_VERSION_CHECK=${NEXT_PUBLIC_DISABLE_CONVEX_VERSION_CHECK}

RUN turbo run build --filter=dashboard-self-hosted...

RUN pnpm --filter=dashboard-self-hosted --config.inject-workspace-packages=true deploy --prod /tmp/deploy

FROM docker.io/library/node:24-trixie-slim

LABEL org.opencontainers.image.source=https://git.horse/vapronva/concave

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
      sed --in-place 's!http://deb.debian.org/debian-security!http://mirror.selectel.ru/debian-security!g; s!http://deb.debian.org/debian!http://mirror.selectel.ru/debian!g' /etc/apt/sources.list.d/debian.sources && \
      apt-get update && \
      apt-get install --assume-yes ca-certificates && \
      update-ca-certificates && \
      sed --in-place 's!http://mirror.selectel.ru/debian!https://mirror.selectel.ru/debian!g' /etc/apt/sources.list.d/debian.sources && \
      apt-get update && \
      apt-get upgrade --assume-yes && \
      apt-get install --assume-yes curl && \
      apt-get clean && \
      rm --recursive --force /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=build --chown=nextjs:nodejs /tmp/deploy/ /app/

WORKDIR /app

RUN cp /app/.next/standalone/dashboard-self-hosted/server.js .

USER nextjs

EXPOSE 6791

ENV PORT=6791 HOSTNAME=0.0.0.0

CMD ["node", "./server.js"]
