ARG TOOLS_IMAGE=docker.horse/ci/on-alpine/tools:1

FROM $TOOLS_IMAGE AS tools

FROM docker.io/library/node:24.20.0-trixie-slim AS build

ARG MIRROR_DEBIAN_URL=""

ARG MIRROR_DEBIAN_FALLBACK_URL=""

COPY --from=tools /usr/local/bin/pkg-base-setup /usr/local/bin/

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
      pkg-base-setup && \
      apt-get install --assume-yes --no-install-recommends build-essential git python3 perl && \
      apt-get clean && \
      rm --recursive --force /var/lib/apt/lists/*

WORKDIR /src

COPY UPSTREAM /tmp/patches/UPSTREAM

RUN git init --quiet . && \
      git remote add origin https://github.com/get-convex/convex-backend.git && \
      git fetch --quiet --depth 1 origin "$(head -1 /tmp/patches/UPSTREAM)" && \
      git checkout --quiet FETCH_HEAD

COPY patches/backend /tmp/patches/backend

COPY apply-patches.sh /tmp/apply-patches.sh

RUN PATCHES_DIR=/tmp/patches/backend bash /tmp/apply-patches.sh /src

ARG MIRROR_NPM_URL=""

RUN [ -z "${MIRROR_NPM_URL}" ] || printf 'registry=%s\n' "${MIRROR_NPM_URL%/}/" | tee /root/.npmrc >> npm-packages/.npmrc

RUN --mount=type=cache,target=/root/.npm npm ci --prefix scripts/

ENV PATH="/src/scripts/node_modules/.bin:${PATH}"

WORKDIR /src/npm-packages

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked pnpm install --frozen-lockfile

ENV NODE_ENV=production

ARG NEXT_PUBLIC_LOAD_MONACO_INTERNALLY="true"


ENV NEXT_PUBLIC_LOAD_MONACO_INTERNALLY=${NEXT_PUBLIC_LOAD_MONACO_INTERNALLY}


RUN turbo run build --filter=dashboard-self-hosted...

FROM docker.io/library/node:24.20.0-trixie-slim

LABEL org.opencontainers.image.source=https://git.horse/vapronva/concave

ARG MIRROR_DEBIAN_URL=""

ARG MIRROR_DEBIAN_FALLBACK_URL=""

COPY --from=tools /usr/local/bin/pkg-base-setup /usr/local/bin/

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
      pkg-base-setup && \
      apt-get clean && \
      rm --recursive --force /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=build --chown=nextjs:nodejs /src/npm-packages/dashboard-self-hosted/.next/standalone/ /app/

COPY --from=build --chown=nextjs:nodejs /src/npm-packages/dashboard-self-hosted/.next/static /app/dashboard-self-hosted/.next/static

COPY --from=build --chown=nextjs:nodejs /src/npm-packages/dashboard-self-hosted/public /app/dashboard-self-hosted/public

WORKDIR /app/dashboard-self-hosted

USER nextjs

EXPOSE 6791

ENV PORT=6791 HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
