new file mode 100644
index 000000000..d2f5c7e8e
--- /dev/null
+++ b/crates/local_backend/src/node_action_callbacks/funrun.rs
@@ -0,0 +1,216 @@
+use application::Application;
+use axum::{
+    body::Bytes,
+    extract::DefaultBodyLimit,
+    routing::post,
+};
+use common::{
+    bootstrap_model::components::handles::FunctionHandle,
+    components::{
+        CanonicalizedComponentFunctionPath,
+        ComponentPath,
+    },
+    runtime::Runtime,
+};
+use function_runner::remote::snapshot_rpc::{
+    serve_table_counts,
+    serve_text_search,
+    TABLE_COUNTS_ROUTE,
+    TEXT_SEARCH_ROUTE,
+};
+use model::file_storage::types::FileStorageEntry;
+use prost::Message;
+
+use super::*;
+
+pub(super) fn deferred_auth_error(headers: &HeaderMap) -> anyhow::Result<Option<ErrorMetadata>> {
+    let Some(value) = headers.get(CONVEX_DEFERRED_AUTH_ERROR_HEADER) else {
+        return Ok(None);
+    };
+    let decoded = base64::decode(value.as_bytes())?;
+    let (short_msg, msg): (String, String) = serde_json::from_slice(&decoded)?;
+    Ok(Some(ErrorMetadata::unauthenticated(short_msg, msg)))
+}
+
+pub(super) trait CallbackFunctionPath {
+    async fn callback_function_path(
+        &self,
+        identity: Identity,
+        component_id: ComponentId,
+        component_path: Option<String>,
+        path: Option<String>,
+        reference: Option<String>,
+        function_handle: Option<String>,
+    ) -> anyhow::Result<CanonicalizedComponentFunctionPath>;
+}
+
+impl<RT: Runtime> CallbackFunctionPath for Application<RT> {
+    async fn callback_function_path(
+        &self,
+        identity: Identity,
+        component_id: ComponentId,
+        component_path: Option<String>,
+        path: Option<String>,
+        reference: Option<String>,
+        function_handle: Option<String>,
+    ) -> anyhow::Result<CanonicalizedComponentFunctionPath> {
+        let Some(component_path) = component_path else {
+            return self
+                .canonicalized_function_path(
+                    identity,
+                    component_id,
+                    path,
+                    reference,
+                    function_handle,
+                )
+                .await;
+        };
+        anyhow::ensure!(
+            reference.is_none() && function_handle.is_none(),
+            ErrorMetadata::bad_request(
+                "InvalidUdfPathOrFunctionReference",
+                "componentPath cannot be combined with a function reference or handle."
+            )
+        );
+        let udf_path = path.context(ErrorMetadata::bad_request(
+            "MissingUdfPath",
+            "componentPath requires a UDF path.",
+        ))?;
+        Ok(CanonicalizedComponentFunctionPath {
+            component: ComponentPath::deserialize(Some(&component_path))?,
+            udf_path: udf_path.parse()?,
+        })
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageGetFileEntryResponse {
+    component_path: String,
+    entry_proto: Vec<u8>,
+}
+
+pub async fn storage_get_file_entry(
+    MtState(st): MtState<LocalAppState>,
+    ExtractActionIdentity {
+        identity,
+        component_id,
+    }: ExtractActionIdentity,
+    Json(req): Json<GetParams>,
+) -> Result<impl IntoResponse, HttpResponseError> {
+    let storage_id = req.storage_id.parse()?;
+    let entry = st
+        .application
+        .runner()
+        .storage_get_file_entry(identity, component_id, storage_id)
+        .await?
+        .map(|(component_path, entry)| {
+            let entry_proto: pb::storage::FileStorageEntry = entry.into();
+            StorageGetFileEntryResponse {
+                component_path: String::from(component_path),
+                entry_proto: entry_proto.encode_to_vec(),
+            }
+        });
+    Ok(Json(entry))
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageStoreFileEntryRequest {
+    entry_proto: Vec<u8>,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageStoreFileEntryResponse {
+    component_path: String,
+    document_id: String,
+}
+
+pub async fn storage_store_file_entry(
+    MtState(st): MtState<LocalAppState>,
+    ExtractActionIdentity {
+        identity,
+        component_id,
+    }: ExtractActionIdentity,
+    Json(req): Json<StorageStoreFileEntryRequest>,
+) -> Result<impl IntoResponse, HttpResponseError> {
+    let entry_proto =
+        pb::storage::FileStorageEntry::decode(&req.entry_proto[..]).map_err(anyhow::Error::from)?;
+    let entry = FileStorageEntry::try_from(entry_proto)?;
+    if entry
+        .storage_key
+        .split('/')
+        .any(|segment| matches!(segment, "" | "." | ".."))
+    {
+        return Err(anyhow::anyhow!(ErrorMetadata::bad_request(
+            "InvalidStorageKey",
+            "storage key segments must be non-empty and must not be `.` or `..`",
+        ))
+        .into());
+    }
+    let (component_path, document_id) = st
+        .application
+        .runner()
+        .storage_store_file_entry(identity, component_id, entry)
+        .await?;
+    Ok(Json(StorageStoreFileEntryResponse {
+        component_path: String::from(component_path),
+        document_id: document_id.to_string(),
+    }))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct LookupFunctionHandleRequest {
+    handle: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct LookupFunctionHandleResponse {
+    component: String,
+    udf_path: String,
+}
+
+pub async fn lookup_function_handle(
+    MtState(st): MtState<LocalAppState>,
+    ExtractActionIdentity {
+        identity,
+        component_id: _,
+    }: ExtractActionIdentity,
+    Json(req): Json<LookupFunctionHandleRequest>,
+) -> Result<impl IntoResponse, HttpResponseError> {
+    let handle: FunctionHandle = req.handle.parse()?;
+    let path = st
+        .application
+        .lookup_function_handle(identity, handle)
+        .await?;
+    Ok(Json(LookupFunctionHandleResponse {
+        component: String::from(path.component),
+        udf_path: path.udf_path.to_string(),
+    }))
+}
+
+pub fn funrun_snapshot_routes(st: LocalAppState) -> axum::Router {
+    axum::Router::new()
+        .route(TABLE_COUNTS_ROUTE, post(funrun_table_counts))
+        .route(TEXT_SEARCH_ROUTE, post(funrun_text_search))
+        .layer(DefaultBodyLimit::disable())
+        .layer(axum::middleware::from_fn_with_state(
+            st,
+            action_callbacks_middleware::<LocalAppState>,
+        ))
+}
+
+async fn funrun_table_counts(body: Bytes) -> Result<Vec<u8>, HttpResponseError> {
+    let request =
+        pb::funrun::SnapshotTableCountsRequest::decode(body).map_err(anyhow::Error::from)?;
+    Ok(serve_table_counts(request).encode_to_vec())
+}
+
+async fn funrun_text_search(body: Bytes) -> Result<Vec<u8>, HttpResponseError> {
+    let request =
+        pb::funrun::SnapshotTextSearchRequest::decode(body).map_err(anyhow::Error::from)?;
+    Ok(serve_text_search(request).await.encode_to_vec())
+}
