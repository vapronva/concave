+
+pub async fn storage_get_file_entry(
+    MtState(st): MtState<LocalAppState>,
+    ExtractActionIdentity {
+        identity,
+        component_id,
+    }: ExtractActionIdentity,
+    Json(req): Json<GetParams>,
+) -> Result<impl IntoResponse, HttpResponseError> {
+    let storage_id = req.storage_id.parse()?;
+    let entry = st
+        .application
+        .runner()
+        .storage_get_file_entry(identity, component_id, storage_id)
+        .await?
+        .map(|(component_path, entry)| {
+            let entry_proto: pb::storage::FileStorageEntry = entry.into();
+            StorageGetFileEntryResponse {
+                component_path: String::from(component_path),
+                entry_proto: entry_proto.encode_to_vec(),
+            }
+        });
+    Ok(Json(entry))
+}
