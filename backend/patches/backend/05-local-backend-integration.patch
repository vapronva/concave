+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageStoreFileEntryResponse {
+    component_path: String,
+    document_id: String,
+}
+
+pub async fn storage_store_file_entry(
+    MtState(st): MtState<LocalAppState>,
+    ExtractActionIdentity {
+        identity,
+        component_id,
+    }: ExtractActionIdentity,
+    Json(req): Json<StorageStoreFileEntryRequest>,
+) -> Result<impl IntoResponse, HttpResponseError> {
+    let entry_proto =
+        pb::storage::FileStorageEntry::decode(&req.entry_proto[..]).map_err(anyhow::Error::from)?;
+    let entry = FileStorageEntry::try_from(entry_proto)?;
+    let (component_path, document_id) = st
+        .application
+        .runner()
+        .storage_store_file_entry(identity, component_id, entry)
+        .await?;
+    Ok(Json(StorageStoreFileEntryResponse {
+        component_path: String::from(component_path),
+        document_id: document_id.to_string(),
+    }))
+}
