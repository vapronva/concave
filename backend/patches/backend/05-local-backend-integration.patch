+pub async fn postgres_database_initialized<RT: Runtime>(
+    db: DbDriverTag,
+    db_spec: &str,
+    require_ssl: bool,
+    deployment_name: &str,
+    runtime: RT,
+) -> anyhow::Result<bool> {
+    match persistence_seed(
+        db,
+        db_spec,
+        ConnectPersistenceFlags {
+            require_ssl,
+            allow_read_only: true,
+            skip_index_creation: false,
+        },
+        deployment_name,
+        None,
+        runtime,
+    )? {
+        PersistenceSeed::Postgres { config, options } => {
+            let pool = PostgresPersistence::create_pool(config)
+                .context("failed to create postgres pool")?;
+            let reader_options = PostgresReaderOptions {
+                version: options.version,
+                schema: options.schema,
+                instance_name: options.instance_name,
+                multitenant: options.multitenant,
+            };
+            PostgresPersistence::schema_initialized(pool, reader_options).await
+        },
+        _ => anyhow::bail!("the boot-role probe requires a Postgres persistence backend"),
+    }
+}
