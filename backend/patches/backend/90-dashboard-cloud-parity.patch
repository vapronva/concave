+import React, {
+  useState,
+  useCallback,
+  useMemo,
+  useContext,
+  createContext,
+  PropsWithChildren,
+} from "react";
+import { cn } from "@ui/cn";
+import { ChevronLeftIcon } from "@radix-ui/react-icons";
+import { Button } from "@ui/Button";
+import { Sheet } from "@ui/Sheet";
+import { MultiSelectCombobox, MultiSelectValue } from "@ui/MultiSelectCombobox";
+import { FunctionNameOption } from "@common/elements/FunctionNameOption";
+import { HealthView } from "@common/features/health/components/HealthView";
+import {
+  InsightsState,
+  useInsights,
+  useInsightsPeriod,
+  insightsPeriodLabel,
+  getInsightPageIdentifier,
+  insightsViewUrl,
+} from "@common/features/health/lib/insights";
+import { useRouter } from "next/router";
+import { Link } from "@ui/Link";
+import {
+  itemIdentifier,
+  useModuleFunctions,
+} from "@common/lib/functions/FunctionsProvider";
+import { functionIdentifierFromValue } from "@common/lib/functions/generateFileTree";
+import { SmallInsightsSummary } from "./SmallInsightsSummary";
+import { InsightsSummary } from "./InsightsSummary";
+import { InsightSummaryBreakdown } from "./InsightsSummaryBreakdown";
+import { UrlObject } from "url";
+
+const InsightsContext = createContext<{
+  page: string;
+  state: InsightsState;
+  selectedFunctions: MultiSelectValue;
+}>({ page: "home", state: { kind: "loading" }, selectedFunctions: "all" });
+
+export function HealthWithInsights() {
+  const { query, push } = useRouter();
+  const view = typeof query.view === "string" ? query.view : "";
+  const page =
+    view.startsWith("insight:") || view === "insights" ? view : "home";
+  const moduleFunctions = useModuleFunctions();
+  const functions = useMemo(
+    () => moduleFunctions.map((value) => itemIdentifier(value)),
+    [moduleFunctions],
+  );
+  const [selectedFunctions, setSelectedFunctions] =
+    useState<MultiSelectValue>("all");
+  const state = useInsights();
+  const { from } = useInsightsPeriod();
+  const selectedInsight =
+    state.kind === "ready"
+      ? state.insights.find(
+          (insight) => getInsightPageIdentifier(insight) === page,
+        )
+      : undefined;
+  const header = (
+    <div
+      className={cn(
+        "sticky top-0 mx-6 flex flex-wrap items-center justify-between gap-4 pt-2",
+        page === "insights" ? "max-w-280" : "",
+      )}
+    >
+      <div className="flex items-center gap-2">
+        {page.startsWith("insight") && (
+          <Button
+            icon={<ChevronLeftIcon className="size-5" />}
+            tip="Back to Health"
+            onClick={() =>
+              void push(insightsViewUrl(), undefined, { shallow: true })
+            }
+            size="xs"
+            variant="neutral"
+            className="text-content-secondary hover:text-content-primary"
+            inline
+          />
+        )}
+        <h3 className="flex items-center gap-2 py-2">
+          <MaybeLink href={page === "home" ? null : insightsViewUrl()}>
+            Health
+          </MaybeLink>{" "}
+          {page.startsWith("insight") && (
+            <>
+              <span className="animate-fadeInFromLoading">/</span>
+              <span className="animate-fadeInFromLoading">
+                <MaybeLink
+                  href={
+                    page === "insights" ? null : insightsViewUrl("insights")
+                  }
+                >
+                  Insights
+                </MaybeLink>
+              </span>
+            </>
+          )}
+          {selectedInsight && (
+            <>
+              <span className="animate-fadeInFromLoading">/</span>
+              <div className="flex animate-fadeInFromLoading flex-wrap gap-1 text-content-primary">
+                Insight Breakdown{" "}
+              </div>
+            </>
+          )}
+        </h3>
+      </div>
+      {page === "insights" && (
+        <div className="flex animate-fadeInFromLoading flex-wrap items-center gap-4">
+          <span className="text-sm text-content-secondary">
+            {insightsPeriodLabel(from)}
+          </span>
+          <div className="min-w-[20rem]">
+            <MultiSelectCombobox
+              options={functions}
+              selectedOptions={selectedFunctions}
+              setSelectedOptions={setSelectedFunctions}
+              unit="function"
+              unitPlural="functions"
+              label="Functions"
+              labelHidden
+              Option={FunctionNameOption}
+              processFilterOption={(option) => {
+                const id = functionIdentifierFromValue(option);
+                return id.componentPath
+                  ? `${id.componentPath}/${id.identifier}`
+                  : id.identifier;
+              }}
+            />
+          </div>
+        </div>
+      )}
+    </div>
+  );
+  const providerValue = useMemo(
+    () => ({
+      page,
+      state,
+      selectedFunctions,
+    }),
+    [page, state, selectedFunctions],
+  );
+  return (
+    <InsightsContext.Provider value={providerValue}>
+      <HealthView
+        header={header}
+        PagesWrapper={InsightsWrapper}
+        PageWrapper={PageWrapper}
+      />
+    </InsightsContext.Provider>
+  );
+}
+
+function InsightsWrapper({ children }: { children: React.ReactNode }) {
+  const { state, selectedFunctions, page } = useContext(InsightsContext);
+  const moduleFunctions = useModuleFunctions();
+  return (
+    <div
+      className={cn(
+        "flex min-h-0 grow gap-6 transition-transform duration-500 motion-reduce:transition-none",
+        page === "home" && "translate-x-0",
+        page === "insights" && "-translate-x-[calc(100%+1.5rem)]",
+        page.startsWith("insight:") && "-translate-x-[calc(200%+3rem)]",
+      )}
+    >
+      {children}
+      <div
+        inert={page !== "insights"}
+        className="mb-6 flex w-full shrink-0 px-6"
+      >
+        <Sheet
+          padding={false}
+          className="scrollbar h-fit max-h-full w-full max-w-280 min-w-0 overflow-auto"
+        >
+          <InsightsSummary
+            state={
+              state.kind === "ready" && selectedFunctions !== "all"
+                ? {
+                    kind: "ready",
+                    insights: state.insights.filter((insight) =>
+                      moduleFunctions.some(
+                        (mf) =>
+                          mf.identifier === insight.functionId &&
+                          (mf.componentPath ?? null) ===
+                            insight.componentPath &&
+                          selectedFunctions.includes(itemIdentifier(mf)),
+                      ),
+                    ),
+                  }
+                : state
+            }
+          />
+        </Sheet>
+      </div>
+      <div
+        inert={!page.startsWith("insight:")}
+        className="scrollbar flex w-full shrink-0 overflow-y-auto px-6"
+      >
+        {state.kind === "notConfigured" || state.kind === "error" ? (
+          <Sheet padding={false} className="h-fit w-full">
+            <InsightsSummary state={state} />
+          </Sheet>
+        ) : (
+          <InsightSummaryBreakdown
+            insight={
+              state.kind === "ready"
+                ? (state.insights.find(
+                    (insight) => getInsightPageIdentifier(insight) === page,
+                  ) ?? null)
+                : undefined
+            }
+          />
+        )}
+      </div>
+    </div>
+  );
+}
+
+function PageWrapper({ children }: { children: React.ReactNode }) {
+  const { push } = useRouter();
+  const onViewAll = useCallback(() => {
+    void push(insightsViewUrl("insights"), undefined, {
+      shallow: true,
+    });
+  }, [push]);
+  const { page } = useContext(InsightsContext);
+  return (
+    <div
+      className="scrollbar flex w-full shrink-0 grow flex-col overflow-y-auto px-6 pb-4"
+      inert={page !== "home"}
+    >
+      {children}
+      <SmallInsightsSummary onViewAll={onViewAll} />
+    </div>
+  );
+}
+
+function MaybeLink({
+  href,
+  children,
+}: PropsWithChildren<{
+  href: UrlObject | null;
+}>) {
+  return href === null ? (
+    <span>{children}</span>
+  ) : (
+    <Link href={href}>{children}</Link>
+  );
+}
