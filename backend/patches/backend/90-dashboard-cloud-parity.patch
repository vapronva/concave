+import {
+  useInsightsPeriod,
+  Insight,
+  utcHour,
+} from "@common/features/health/lib/insights";
+import { formatBytes, formatNumberCompact } from "@common/lib/format";
+import { ChartTooltip } from "@common/elements/ChartTooltip";
+import {
+  ResponsiveContainer,
+  XAxis,
+  YAxis,
+  Tooltip,
+  Line,
+  LineChart,
+  ReferenceLine,
+  CartesianGrid,
+} from "recharts";
+import { DeploymentTimes } from "@common/features/health/components/DeploymentTimes";
+import { useDeploymentAuditLogs } from "@common/lib/useDeploymentAuditLog";
+
+export function ChartForInsight({ insight }: { insight: Insight }) {
+  const name = seriesName(insight);
+  const data = insight.details.hourlyCounts;
+  const { from } = useInsightsPeriod();
+  const auditLogs = useDeploymentAuditLogs(Date.parse(from), {
+    actions: ["push_config", "push_config_with_components"],
+  });
+  const deploysByHour = auditLogs?.map((log) => ({
+    hour: utcHour(log._creationTime),
+    timestamp: log._creationTime,
+  }));
+  const midnightTicks = data
+    .filter((d) => parseHour(d.hour).getUTCHours() === 0)
+    .map((d) => d.hour);
+  return (
+    <div className="animate-fadeInFromLoading">
+      <ResponsiveContainer height={200} width="100%">
+        <LineChart
+          data={data}
+          style={{
+            fontSize: 12,
+          }}
+        >
+          {deploysByHour?.map(({ hour, timestamp }) => (
+            <ReferenceLine
+              key={timestamp}
+              x={hour}
+              stroke="var(--brand-yellow)"
+              strokeDasharray="3 3"
+            />
+          ))}
+          <CartesianGrid
+            className="stroke-content-tertiary/30"
+            horizontal
+            strokeWidth={1}
+            syncWithTicks
+          />
+          <XAxis
+            dataKey="hour"
+            domain={["auto", "auto"]}
+            tickFormatter={dateLabel}
+            strokeWidth={1}
+            axisLine={{ className: "stroke-content-tertiary/30" }}
+            tickLine={false}
+            tick={{
+              fontSize: 12,
+              fill: "var(--content-secondary)",
+            }}
+            {...(midnightTicks.length > 0 ? { ticks: midnightTicks } : {})}
+          />
+          <YAxis
+            tick={{
+              fontSize: 12,
+              fill: "currentColor",
+            }}
+            axisLine={{ className: "stroke-content-tertiary/30" }}
+            tickLine={false}
+            tickFormatter={formatNumberCompact}
+            width={48}
+          />
+          <Tooltip
+            content={({ active, payload, label }) => {
+              const deploymentTimes = deploysByHour
+                ?.filter((deploy) => deploy.hour === label)
+                .map((deploy) =>
+                  new Date(deploy.timestamp).toLocaleString(undefined, {
+                    timeZone: "UTC",
+                    year: "numeric",
+                    month: "numeric",
+                    day: "numeric",
+                    hour: "numeric",
+                    minute: "2-digit",
+                  }),
+                );
+              return (
+                <ChartTooltip
+                  active={active}
+                  payload={payload?.map((p) => ({
+                    formattedValue: (
+                      <div className="flex flex-col items-start">
+                        <div>
+                          {formatNumberCompact(p.payload.count)} {name}
+                        </div>
+                      </div>
+                    ),
+                    ...p,
+                  }))}
+                  extraContent={
+                    <DeploymentTimes deploymentTimes={deploymentTimes} />
+                  }
+                  label={timeLabel(label)}
+                />
+              );
+            }}
+            animationDuration={100}
+          />
+          <Line
+            isAnimationActive={false}
+            className="stroke-chart-line-1"
+            activeDot={{ r: 4, className: "stroke-none" }}
+            name={name}
+            dataKey="count"
+            dot={false}
+          />
+        </LineChart>
+      </ResponsiveContainer>
+    </div>
+  );
+}
+
+function seriesName(insight: Insight) {
+  switch (insight.kind) {
+    case "occFailedPermanently":
+      return "write conflict failures";
+    case "occRetried":
+      return "write conflict retries";
+    case "bytesReadLimit":
+    case "bytesReadThreshold":
+      return `function calls reading more than ${formatBytes(insight.details.threshold)}`;
+    case "documentsReadLimit":
+    case "documentsReadThreshold":
+      return `function calls reading more than ${formatNumberCompact(insight.details.threshold)} documents`;
+    default: {
+      insight satisfies never;
+      return "";
+    }
+  }
+}
+
+function parseHour(hour: string) {
+  return new Date(`${hour.replace(" ", "T")}Z`);
+}
+
+function dateLabel(hour: string) {
+  return parseHour(hour).toLocaleDateString(undefined, { timeZone: "UTC" });
+}
+
+function timeLabel(value: string | number | undefined) {
+  if (!value) {
+    return "";
+  }
+  const date = parseHour(String(value));
+  const oneHourLater = new Date(date.getTime() + 60 * 60 * 1000);
+  const hour = (d: Date) =>
+    d.toLocaleTimeString(undefined, { timeZone: "UTC", hour: "numeric" });
+  return `${date.toLocaleDateString(undefined, { timeZone: "UTC" })} ${hour(date)} – ${hour(oneHourLater)}`;
+}
diff --git a/npm-packages/dashboard-common/src/features/health/components/EventsForInsight.tsx b/npm-packages/dashboard-common/src/features/health/components/EventsForInsight.tsx
