diff --git a/npm-packages/dashboard-common/src/lib/snapshotApi.ts b/npm-packages/dashboard-common/src/lib/snapshotApi.ts
new file mode 100644
index 000000000..e48ecd2be
--- /dev/null
+++ b/npm-packages/dashboard-common/src/lib/snapshotApi.ts
@@ -0,0 +1,202 @@
+import { useCallback, useContext } from "react";
+import { Id } from "system-udfs/convex/_generated/dataModel";
+import {
+  useDeploymentAuthHeader,
+  useDeploymentUrl,
+} from "@common/lib/deploymentApi";
+import { DeploymentInfoContext } from "@common/lib/deploymentContext";
+import { toast } from "@common/lib/utils";
+
+async function deploymentResponseError(res: Response) {
+  const text = await res.text();
+  let json: unknown;
+  try {
+    json = JSON.parse(text);
+  } catch {
+    json = null;
+  }
+  if (
+    typeof json === "object" &&
+    json !== null &&
+    "code" in json &&
+    typeof json.code === "string" &&
+    "message" in json &&
+    typeof json.message === "string"
+  ) {
+    return { code: json.code, message: json.message };
+  }
+  return {
+    code: String(res.status),
+    message: text || `${res.status} ${res.statusText}`,
+  };
+}
+
+function useCheckedDeploymentFetch() {
+  const deploymentUrl = useDeploymentUrl();
+  const authHeader = useDeploymentAuthHeader();
+  const { reportHttpError } = useContext(DeploymentInfoContext);
+  return useCallback(
+    async (path: string, init: RequestInit = {}): Promise<Response | null> => {
+      try {
+        const res = await fetch(`${deploymentUrl}${path}`, {
+          ...init,
+          headers: { Authorization: authHeader, ...init.headers },
+        });
+        if (res.ok) {
+          return res;
+        }
+        const err = await deploymentResponseError(res);
+        reportHttpError(init.method ?? "GET", res.url, err);
+        toast("error", err.message);
+      } catch (e) {
+        toast("error", e instanceof Error ? e.message : String(e));
+      }
+      return null;
+    },
+    [deploymentUrl, authHeader, reportHttpError],
+  );
+}
+
+export function useGetZipExport(): (
+  snapshotId: Id<"_exports">,
+) => Promise<void> {
+  const deploymentUrl = useDeploymentUrl();
+  const checkedFetch = useCheckedDeploymentFetch();
+  return useCallback(
+    async (snapshotId: Id<"_exports">) => {
+      const exportUrl = `/api/export/zip/${snapshotId}`;
+      const res = await checkedFetch(`${exportUrl}/token`, { method: "POST" });
+      if (!res) {
+        return;
+      }
+      let token: string;
+      try {
+        const body: { token: string } = await res.json();
+        token = body.token;
+      } catch (e) {
+        toast("error", e instanceof Error ? e.message : String(e));
+        return;
+      }
+      const anchor = document.createElement("a");
+      anchor.href = `${deploymentUrl}${exportUrl}?${new URLSearchParams({ token })}`;
+      document.body.appendChild(anchor);
+      anchor.click();
+      document.body.removeChild(anchor);
+    },
+    [deploymentUrl, checkedFetch],
+  );
+}
+
+export function useRequestZipExport(): () => Promise<void> {
+  const checkedFetch = useCheckedDeploymentFetch();
+  return useCallback(async () => {
+    const res = await checkedFetch(
+      "/api/export/request/zip?includeStorage=true",
+      { method: "POST" },
+    );
+    if (!res) {
+      return;
+    }
+    toast("success", "Snapshot export requested.");
+  }, [checkedFetch]);
+}
+
+export function useUploadSnapshotImport(): (file: File) => Promise<void> {
+  const checkedFetch = useCheckedDeploymentFetch();
+  return useCallback(
+    async (file: File) => {
+      try {
+        const start = await checkedFetch("/api/import/start_upload", {
+          method: "POST",
+        });
+        if (!start) {
+          return;
+        }
+        const { uploadToken }: { uploadToken: string } = await start.json();
+        const chunkSize = Math.max(
+          5 * 1024 * 1024,
+          Math.ceil(file.size / 9999),
+        );
+        const partTokens: string[] = [];
+        for (
+          let offset = 0, partNumber = 1;
+          offset < file.size;
+          offset += chunkSize, partNumber += 1
+        ) {
+          const part = await checkedFetch(
+            `/api/import/upload_part?uploadToken=${encodeURIComponent(
+              uploadToken,
+            )}&partNumber=${partNumber}`,
+            {
+              method: "POST",
+              headers: { "Content-Type": "application/octet-stream" },
+              body: file.slice(offset, offset + chunkSize),
+            },
+          );
+          if (!part) {
+            return;
+          }
+          const partToken: string = await part.json();
+          partTokens.push(partToken);
+        }
+        const finish = await checkedFetch("/api/import/finish_upload", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({
+            import: { mode: "replaceAll", format: "zip" },
+            uploadToken,
+            partTokens,
+          }),
+        });
+        if (!finish) {
+          return;
+        }
+        toast("success", "Snapshot uploaded. Review and confirm the import.");
+      } catch (error) {
+        toast(
+          "error",
+          error instanceof Error ? error.message : "Snapshot upload failed.",
+        );
+      }
+    },
+    [checkedFetch],
+  );
+}
+
+export function useCancelImport(): (
+  id: Id<"_snapshot_imports">,
+) => Promise<void> {
+  const checkedFetch = useCheckedDeploymentFetch();
+  return useCallback(
+    async (id: Id<"_snapshot_imports">) => {
+      const res = await checkedFetch("/api/cancel_import", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ importId: id }),
+      });
+      if (!res) {
+        throw new Error("import not cancelled");
+      }
+    },
+    [checkedFetch],
+  );
+}
+
+export function useConfirmImport(): (
+  id: Id<"_snapshot_imports">,
+) => Promise<void> {
+  const checkedFetch = useCheckedDeploymentFetch();
+  return useCallback(
+    async (importId: Id<"_snapshot_imports">) => {
+      const res = await checkedFetch("/api/perform_import", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ importId }),
+      });
+      if (!res) {
+        throw new Error("import not confirmed");
+      }
+    },
+    [checkedFetch],
+  );
+}
