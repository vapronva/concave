@@ -0,0 +1,39 @@
+import { Insight } from "@common/features/health/lib/insights";
+
+const HEIGHT = 36;
+const WIDTH = 240;
+
+export function SparklineForInsight({ insight }: { insight: Insight }) {
+  const points = toPoints(insight.details.hourlyCounts.map((b) => b.count));
+  return (
+    <svg
+      className="block animate-fadeInFromLoading"
+      width={WIDTH}
+      height={HEIGHT}
+      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
+      aria-hidden
+    >
+      <polygon
+        fill="var(--chart-line-1)"
+        fillOpacity={0.1}
+        points={`0,${HEIGHT} ${points} ${WIDTH},${HEIGHT}`}
+      />
+      <polyline
+        fill="none"
+        stroke="var(--chart-line-1)"
+        strokeWidth={1}
+        strokeLinejoin="round"
+        strokeLinecap="round"
+        points={points}
+      />
+    </svg>
+  );
+}
+
+function toPoints(data: number[]) {
+  const max = Math.max(1, ...data);
+  const stepX = WIDTH / (data.length - 1);
+  return data
+    .map((value, i) => `${i * stepX},${0.5 + (1 - value / max) * (HEIGHT - 1)}`)
+    .join(" ");
+}
diff --git a/npm-packages/dashboard-common/src/features/health/lib/insights.ts b/npm-packages/dashboard-common/src/features/health/lib/insights.ts
new file mode 100644
index 000000000..203e71105
--- /dev/null
+++ b/npm-packages/dashboard-common/src/features/health/lib/insights.ts
@@ -0,0 +1,272 @@
+import { UrlObject } from "url";
+import { useMemo } from "react";
+import useSWR, { BareFetcher } from "swr";
+import { deploymentAuthMiddleware } from "@common/lib/deploymentApi";
+import { deploymentFetch } from "@common/lib/fetching";
+import { useModuleFunctions } from "@common/lib/functions/FunctionsProvider";
+
+const HOUR_MS = 60 * 60 * 1000;
+const DAY_MS = 24 * HOUR_MS;
+const PERIOD_MS = 72 * HOUR_MS;
+const REFRESH_INTERVAL_MS = 10 * 60 * 1000;
+const ROOT_COMPONENT_PATH = "-root-component-";
+
+export function useInsightsPeriod() {
+  const now = Date.now();
+  const from = Math.floor((now - PERIOD_MS) / DAY_MS) * DAY_MS;
+  return {
+    from: new Date(from).toISOString(),
+    to: new Date(now).toISOString(),
+  };
+}
+
+export function insightsPeriodLabel(from: string) {
+  const start = new Date(from).toLocaleString([], {
+    year: "numeric",
+    month: "numeric",
+    day: "numeric",
+    hour: "numeric",
+    timeZone: "UTC",
+    timeZoneName: "short",
+  });
+  return `${start} – Now`;
+}
+
+export function utcHour(ms: number) {
+  return `${new Date(ms).toISOString().slice(0, 13).replace("T", " ")}:00:00`;
+}
+
+type HourlyCount = {
+  hour: string;
+  count: number;
+};
+
+type OccDetails = {
+  occCalls: number;
+  occTableName?: string;
+  hourlyCounts: HourlyCount[];
+  recentEvents: {
+    timestamp: string;
+    id: string;
+    request_id: string;
+    occ_document_id?: string;
+    occ_write_source?: string;
+    occ_retry_count: number;
+  }[];
+};
+
+type ReadDetails = {
+  count: number;
+  limit: number;
+  threshold: number;
+  hourlyCounts: HourlyCount[];
+  recentEvents: {
+    timestamp: string;
+    id: string;
+    request_id: string;
+    calls: { table_name: string; bytes_read: number; documents_read: number }[];
+    success: boolean;
+  }[];
+};
+
+type InsightDetails = {
+  occRetried: OccDetails;
+  occFailedPermanently: OccDetails;
+  bytesReadLimit: ReadDetails;
+  bytesReadThreshold: ReadDetails;
+  documentsReadLimit: ReadDetails;
+  documentsReadThreshold: ReadDetails;
+};
+
+export type Insight = {
+  [K in keyof InsightDetails]: {
+    kind: K;
+    functionId: string;
+    componentPath: string | null;
+    details: InsightDetails[K];
+  };
+}[keyof InsightDetails];
+
+type ReadInsight = Extract<Insight, { details: ReadDetails }>;
+
+export type InsightsState =
+  | { kind: "loading" }
+  | { kind: "notConfigured" }
+  | { kind: "error" }
+  | { kind: "ready"; insights: Insight[] };
+
+const insightOrder: Record<Insight["kind"], number> = {
+  documentsReadLimit: 0,
+  bytesReadLimit: 1,
+  occFailedPermanently: 2,
+  documentsReadThreshold: 3,
+  bytesReadThreshold: 4,
+  occRetried: 5,
+};
+
+function isInsightKind(kind: string): kind is Insight["kind"] {
+  return Object.hasOwn(insightOrder, kind);
+}
+
+function isReadInsight(insight: Insight): insight is ReadInsight {
+  return (
+    insight.kind !== "occRetried" && insight.kind !== "occFailedPermanently"
+  );
+}
+
+function mergeReadInsights(a: ReadInsight, b: ReadInsight) {
+  return {
+    ...a,
+    details: {
+      ...a.details,
+      count: a.details.count + b.details.count,
+      hourlyCounts: a.details.hourlyCounts.map(({ hour, count }, i) => ({
+        hour,
+        count: count + b.details.hourlyCounts[i].count,
+      })),
+      recentEvents: [...a.details.recentEvents, ...b.details.recentEvents].sort(
+        (x, y) => Date.parse(y.timestamp) - Date.parse(x.timestamp),
+      ),
+    },
+  };
+}
+
+function padHourlyCounts(
+  hourlyCounts: HourlyCount[],
+  from: string,
+  until: number,
+) {
+  const counts = new Map(hourlyCounts.map(({ hour, count }) => [hour, count]));
+  const padded: HourlyCount[] = [];
+  for (let ms = Date.parse(from); ms < until; ms += HOUR_MS) {
+    const hour = utcHour(ms);
+    padded.push({ hour, count: counts.get(hour) ?? 0 });
+  }
+  return padded;
+}
+
+const fetchUsage: BareFetcher<string[][]> = async (
+  key: readonly [string, ...unknown[]],
+) => {
+  const data: string[][] | undefined = await deploymentFetch(key);
+  if (data === undefined) {
+    throw new Error("Insights request failed");
+  }
+  return data;
+};
+
+function isInsightsNotConfiguredError(error: unknown): boolean {
+  const status =
+    typeof error === "object" && error !== null && "status" in error
+      ? error.status
+      : undefined;
+  return (
+    status === 404 ||
+    (error instanceof Error &&
+      error.message.startsWith("Server responded with 404"))
+  );
+}
+
+export function useInsights(): InsightsState {
+  const { from, to } = useInsightsPeriod();
+  const query = new URLSearchParams({
+    from: from.split("T")[0],
+    to: to.split("T")[0],
+  });
+  const { data, error } = useSWR<string[][], unknown>(
+    `/api/insights/usage/query?${query.toString()}`,
+    fetchUsage,
+    {
+      use: [deploymentAuthMiddleware],
+      refreshInterval: REFRESH_INTERVAL_MS,
+      revalidateOnFocus: false,
+    },
+  );
+  const moduleFunctions = useModuleFunctions();
+  const padUntil = Math.ceil(Date.now() / HOUR_MS) * HOUR_MS;
+  return useMemo(() => {
+    if (error) {
+      return {
+        kind: isInsightsNotConfiguredError(error) ? "notConfigured" : "error",
+      };
+    }
+    if (!data) {
+      return { kind: "loading" };
+    }
+    const insights = data.flatMap(
+      ([kind, functionId, componentPath, rawDetails]) => {
+        if (!isInsightKind(kind)) {
+          return [];
+        }
+        let details: Insight["details"];
+        try {
+          details = JSON.parse(rawDetails);
+        } catch {
+          return [];
+        }
+        return [
+          {
+            kind,
+            functionId,
+            componentPath:
+              componentPath === ROOT_COMPONENT_PATH ? null : componentPath,
+            details: {
+              ...details,
+              hourlyCounts: padHourlyCounts(
+                details.hourlyCounts,
+                from,
+                padUntil,
+              ),
+            },
+          } as Insight,
+        ];
+      },
+    );
+    const hasFunction = (functionId: string, componentPath: string | null) =>
+      moduleFunctions.some(
+        (mf) =>
+          mf.identifier === functionId &&
+          (mf.componentPath ?? null) === componentPath,
+      );
+    const attributed = new Map<string, Insight>();
+    for (const insight of insights) {
+      const matched = hasFunction(insight.functionId, insight.componentPath)
+        ? insight
+        : isReadInsight(insight) && hasFunction(insight.functionId, null)
+          ? { ...insight, componentPath: null }
+          : null;
+      if (!matched) {
+        continue;
+      }
+      const id = getInsightPageIdentifier(matched);
+      const prior = attributed.get(id);
+      attributed.set(
+        id,
+        prior && isReadInsight(prior) && isReadInsight(matched)
+          ? mergeReadInsights(prior, matched)
+          : matched,
+      );
+    }
+    return {
+      kind: "ready",
+      insights: [...attributed.values()].sort(
+        (a, b) => insightOrder[a.kind] - insightOrder[b.kind],
+      ),
+    };
+  }, [data, error, from, padUntil, moduleFunctions]);
+}
+
+export function getInsightPageIdentifier(insight: Insight): string {
+  if (
+    (insight.kind === "occRetried" ||
+      insight.kind === "occFailedPermanently") &&
+    "occTableName" in insight.details
+  ) {
+    return `insight:${insight.kind}:${insight.componentPath}:${insight.functionId}:${insight.details.occTableName}`;
+  }
+  return `insight:${insight.kind}:${insight.componentPath}:${insight.functionId}`;
+}
+
+export function insightsViewUrl(view?: string): UrlObject {
+  return { pathname: "/", query: view ? { view } : {} };
+}
