+use metrics::{
+    log_counter,
+    log_counter_with_labels,
+    log_gauge,
+    register_convex_counter,
+    register_convex_gauge,
+    StaticMetricLabel,
+};
+
+register_convex_counter!(
+    SNAPSHOT_WARM_HIT_TOTAL,
+    "Funrun requests served without waiting for follower replay"
+);
+pub(crate) fn log_snapshot_warm_hit() {
+    log_counter(&SNAPSHOT_WARM_HIT_TOTAL, 1);
+}
+
+register_convex_counter!(
+    SNAPSHOT_COLD_TOTAL,
+    "Funrun requests requiring follower replay or a historical snapshot load"
+);
+pub(crate) fn log_snapshot_cold() {
+    log_counter(&SNAPSHOT_COLD_TOTAL, 1);
+}
+
+register_convex_counter!(
+    SNAPSHOT_COLD_LOAD_TOTAL,
+    "Funrun historical snapshots bootstrapped outside the follower memory window"
+);
+pub(crate) fn log_snapshot_cold_load() {
+    log_counter(&SNAPSHOT_COLD_LOAD_TOTAL, 1);
+}
+
+register_convex_counter!(SNAPSHOT_REQUESTS_TOTAL, "Funrun snapshot_inputs calls");
+pub(crate) fn log_snapshot_request() {
+    log_counter(&SNAPSHOT_REQUESTS_TOTAL, 1);
+}
+
+register_convex_gauge!(
+    ISOLATE_BUSY_THREADS,
+    "Busy funrun V8 isolate worker threads (servicing a request) across the shared pool"
+);
+register_convex_gauge!(
+    ISOLATE_TOTAL_THREADS,
+    "Total funrun V8 isolate worker threads in the shared pool (MAX_ISOLATE_WORKERS)"
+);
+pub(crate) fn log_isolate_pool(busy: usize, total: usize) {
+    log_gauge(&ISOLATE_BUSY_THREADS, busy as f64);
+    log_gauge(&ISOLATE_TOTAL_THREADS, total as f64);
+}
+
+register_convex_counter!(
+    REJECTED_BEFORE_EXECUTION_TOTAL,
+    "Funrun requests rejected before execution started, by rejection reason",
+    &["reason"]
+);
+pub(crate) fn log_rejected_before_execution(reason: String) {
+    log_counter_with_labels(
+        &REJECTED_BEFORE_EXECUTION_TOTAL,
+        1,
+        vec![StaticMetricLabel::new("reason", reason)],
+    );
+}
