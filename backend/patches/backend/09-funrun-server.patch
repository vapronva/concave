+
+const MAX_PERCENT_PER_CLIENT: usize = 100;
+
+pub struct InstanceRegistry<RT: Runtime> {
+    rt: RT,
+    db: clusters::DbDriverTag,
+    require_ssl: bool,
+    instance: FunrunInstanceConfig,
+    shared_isolate: SharedIsolateResources<RT>,
+    searcher: Arc<dyn search::Searcher>,
+    state: Arc<OnceCell<Arc<InstanceState<RT>>>>,
+    lag_sample: Arc<Mutex<Option<InstanceLagSample>>>,
+    load_error: Mutex<Option<InstanceLoadError>>,
+}
+
+#[derive(Clone)]
+struct InstanceLagSample {
+    warm_timestamp: Timestamp,
+    persistence_timestamp: Option<Timestamp>,
+    lag_seconds: Option<f64>,
+    error: Option<String>,
+}
+
+#[derive(Clone)]
+struct InstanceLoadError {
+    message: String,
+    unix_ts: u64,
+}
+
+impl<RT: Runtime> InstanceRegistry<RT> {
+    pub fn new(rt: RT, config: &FunrunConfig) -> anyhow::Result<Self> {
+        let shared_isolate = SharedIsolateResources::new_with_max_workers(
+            rt.clone(),
+            MAX_PERCENT_PER_CLIENT,
+            *MAX_ISOLATE_WORKERS,
+            funrun_isolate_worker(&rt),
+        )?;
+        tracing::info!(
+            "[convex-funrun] shared isolate pool: {} workers",
+            shared_isolate.max_isolate_workers(),
+        );
+        let searcher: Arc<dyn search::Searcher> = Arc::new(InProcessSearcher::new(rt.clone())?);
+        let state = Arc::new(OnceCell::new());
+        let lag_sample = Arc::new(Mutex::new(None));
+        Self::spawn_lag_sampler(rt.clone(), state.clone(), lag_sample.clone());
+        Ok(Self {
+            rt,
+            db: config.db,
+            require_ssl: config.require_ssl,
+            instance: config.instance.clone(),
+            shared_isolate,
+            searcher,
+            state,
+            lag_sample,
+            load_error: Mutex::new(None),
+        })
+    }
+
+    pub fn isolate_workers(&self) -> (usize, usize) {
+        (
+            self.shared_isolate.active_isolate_workers(),
+            self.shared_isolate.max_isolate_workers(),
+        )
+    }
+
+    pub fn healthy(&self) -> bool {
+        self.shared_isolate.pool_healthy()
+            && self
+                .state
+                .get()
+                .is_none_or(|state| state.tailer.is_running())
+    }
+
+    pub fn instance_ready(&self) -> bool {
+        self.state
+            .get()
+            .is_some_and(|state| state.tailer.is_ready())
+    }
+
+    pub fn instance_config(&self, instance_name: &str) -> anyhow::Result<&FunrunInstanceConfig> {
+        anyhow::ensure!(
+            instance_name == self.instance.instance_name,
+            "funrun pod is not configured for instance {instance_name:?} (FUNRUN_INSTANCE_NAME)"
+        );
+        Ok(&self.instance)
+    }
+
+    pub async fn get_or_create(
+        &self,
+        instance_name: &str,
+    ) -> anyhow::Result<Arc<InstanceState<RT>>> {
+        let config = self.instance_config(instance_name)?;
+        self.state
+            .get_or_try_init(|| async {
+                let state = InstanceState::load(
+                    self.rt.clone(),
+                    config,
+                    self.db,
+                    self.require_ssl,
+                    self.shared_isolate.clone(),
+                    self.searcher.clone(),
+                )
+                .await
+                .map(Arc::new);
+                *self.load_error.lock() = state.as_ref().err().map(|e| InstanceLoadError {
+                    message: format!("{e:#}"),
+                    unix_ts: self.rt.unix_timestamp().as_secs(),
+                });
+                state
+            })
+            .await
+            .cloned()
+    }
+
+    pub async fn prewarm(&self) {
+        if let Err(e) = self.get_or_create(&self.instance.instance_name).await {
+            tracing::error!("[convex-funrun] prewarm failed: {e:#}; will retry on demand");
+        }
+    }
+
+    pub fn health_report(&self, max_lag: Duration) -> HealthReport {
+        let sample = self.lag_sample.lock().clone();
+        let load_error = self.load_error.lock().clone();
+        let instance_healthy = self.instance_ready()
+            && match &sample {
+                Some(sample) => match sample.lag_seconds {
+                    Some(lag) => lag <= max_lag.as_secs_f64(),
+                    None => sample.error.is_none(),
+                },
+                None => load_error.is_none(),
+            };
+        HealthReport {
+            healthy: self.healthy(),
+            instance: InstanceHealth {
+                name: self.instance.instance_name.clone(),
+                healthy: instance_healthy,
+                warm_timestamp: sample.as_ref().map(|s| s.warm_timestamp.to_string()),
+                persistence_timestamp: sample
+                    .as_ref()
+                    .and_then(|s| s.persistence_timestamp.map(|ts| ts.to_string())),
+                lag_seconds: sample.as_ref().and_then(|s| s.lag_seconds),
+                error: sample.and_then(|s| s.error),
+                last_load_error: load_error.as_ref().map(|e| e.message.clone()),
+                last_load_error_unix_ts: load_error.map(|e| e.unix_ts),
+            },
+        }
+    }
+
+    fn spawn_lag_sampler(
+        rt: RT,
+        state: Arc<OnceCell<Arc<InstanceState<RT>>>>,
+        lag_sample: Arc<Mutex<Option<InstanceLagSample>>>,
+    ) {
+        let worker_rt = rt.clone();
+        rt.spawn_background("funrun_lag_sampler", async move {
+            loop {
+                if let Some(state) = state.get() {
+                    let sample = sample_instance_lag(state).await;
+                    *lag_sample.lock() = Some(sample);
+                }
+                worker_rt.wait(Duration::from_secs(2)).await;
+            }
+        });
+    }
+}
+
+async fn sample_instance_lag<RT: Runtime>(state: &InstanceState<RT>) -> InstanceLagSample {
+    let warm = state.database.now_ts_for_reads();
+    match new_static_repeatable_recent(state.reader.as_ref()).await {
+        Ok(latest) => InstanceLagSample {
+            warm_timestamp: *warm,
+            persistence_timestamp: Some(*latest),
+            lag_seconds: Some(latest.secs_since_f64(*warm).max(0.0)),
+            error: None,
+        },
+        Err(e) => InstanceLagSample {
+            warm_timestamp: *warm,
+            persistence_timestamp: None,
+            lag_seconds: None,
+            error: Some(format!("{e:#}")),
+        },
+    }
+}
+
+pub struct InstanceState<RT: Runtime> {
+    rt: RT,
+    pub instance_name: String,
+    pub key_broker: FunctionRunnerKeyBroker,
+    reader: Arc<dyn PersistenceReader>,
+    pub retention_validator: Arc<dyn RetentionValidator>,
+    searcher: Arc<dyn search::Searcher>,
+    pub core: FunctionRunnerCore<RT, DeploymentStorage>,
+    database: Database<RT>,
+    tailer: FollowerTailerClient,
+}
+
+impl<RT: Runtime> InstanceState<RT> {
+    pub async fn load(
+        rt: RT,
+        config: &FunrunInstanceConfig,
+        db: clusters::DbDriverTag,
+        require_ssl: bool,
+        shared_isolate: SharedIsolateResources<RT>,
+        searcher: Arc<dyn search::Searcher>,
+    ) -> anyhow::Result<Self> {
+        let reader = db_connection::connect_persistence_reader(
+            db,
+            &config.db_spec,
+            require_ssl,
+            false,
+            &config.instance_name,
+            None,
+            rt.clone(),
+        )
+        .await?;
+        let key_broker = keybroker::KeyBroker::new(&config.instance_name, config.instance_secret)?
+            .function_runner_keybroker();
+        let database = Database::load_follower(
+            reader.clone(),
+            rt.clone(),
+            searcher.clone(),
+            virtual_system_mapping().clone(),
+            IndexCache::new(*common::knobs::FUNRUN_FOLLOWER_INDEX_CACHE_SIZE),
+        )
+        .await?;
+        let retention_validator = database.retention_validator();
+        let storage_type = Self::read_storage_type(&database).await?;
+        let files_storage =
+            create_storage(rt.clone(), &storage_type, storage::StorageUseCase::Files).await?;
+        let modules_storage =
+            create_storage(rt.clone(), &storage_type, storage::StorageUseCase::Modules).await?;
+        let search_storage = create_storage(
+            rt.clone(),
+            &storage_type,
+            storage::StorageUseCase::SearchIndexes,
+        )
+        .await?;
+        let core = FunctionRunnerCore::new_with_isolate_client(
+            rt.clone(),
+            DeploymentStorage {
+                files_storage,
+                modules_storage,
+            },
+            shared_isolate,
+        );
+        database.set_search_storage(search_storage);
+        tracing::info!(
+            "[convex-funrun] loaded instance {} ({:?} storage); warm follower snapshot at {}",
+            config.instance_name,
+            storage_type,
+            database.now_ts_for_reads(),
+        );
+        let tailer = database.follower_tailer_client().await?;
+        Ok(Self {
+            rt,
+            instance_name: config.instance_name.clone(),
+            key_broker,
+            reader,
+            retention_validator,
+            searcher,
+            core,
+            database,
+            tailer,
+        })
+    }
+
+    async fn read_storage_type(database: &Database<RT>) -> anyhow::Result<StorageType> {
+        let mut tx = database.begin_system().await?;
+        DatabaseGlobalsModel::new(&mut tx)
+            .database_globals()
+            .await?
+            .into_value()
+            .storage_type
+            .context(
+                "funrun cannot start: database storage tag is not initialized (the leader must \
+                 initialize the database first)",
+            )
+    }
+
+    pub async fn snapshot_inputs(&self, ts: RepeatableTimestamp) -> anyhow::Result<SnapshotInputs> {
+        log_snapshot_request();
+        if self.tailer.has_reached(ts) {
+            log_snapshot_warm_hit();
+        } else {
+            log_snapshot_cold();
+            self.await_tailer(ts).await?;
+        }
+        let persistence =
+            RepeatablePersistence::new(self.reader.clone(), ts, self.retention_validator.clone());
+        let index_reader: Arc<dyn IndexReader> = Arc::new(persistence.read_snapshot(ts)?);
+        match self.database.snapshot(ts) {
+            Ok(snapshot) => {
+                let counts = snapshot
+                    .table_counts
+                    .context("follower snapshot has no table counts")?;
+                Ok(SnapshotInputs {
+                    index_reader,
+                    bootstrap_metadata: self.database.bootstrap_metadata.clone(),
+                    table_count_snapshot: Arc::new(Some(counts)),
+                    text_index_snapshot: self
+                        .text_snapshot(snapshot.index_registry, snapshot.text_indexes),
+                })
+            },
+            Err(error) if error.is_out_of_retention() => {
+                self.full_cold_snapshot_inputs(ts, index_reader).await
+            },
+            Err(error) => Err(error),
+        }
+    }
+
+    async fn await_tailer(&self, ts: RepeatableTimestamp) -> anyhow::Result<()> {
+        let wait = self.tailer.wait_for(ts).fuse();
+        let deadline = self
+            .rt
+            .wait(*common::knobs::FUNRUN_SNAPSHOT_WAIT_TIMEOUT)
+            .fuse();
+        futures::pin_mut!(wait, deadline);
+        futures::select_biased! {
+            result = wait => result.map_err(|error| error.context(
+                ErrorMetadata::rejected_before_execution(
+                    "FunrunTailerExited", "funrun follower tailer exited",
+                )
+            )),
+            _ = deadline => anyhow::bail!(ErrorMetadata::rejected_before_execution(
+                "FunrunSnapshotTimeout", "funrun follower did not reach the requested snapshot",
+            )),
+        }
+    }
+
+    async fn full_cold_snapshot_inputs(
+        &self,
+        ts: RepeatableTimestamp,
+        index_reader: Arc<dyn IndexReader>,
+    ) -> anyhow::Result<SnapshotInputs> {
+        log_snapshot_cold_load();
+        let mut snapshot = DatabaseSnapshot::load(
+            self.rt.clone(),
+            self.reader.clone(),
+            ts,
+            self.retention_validator.clone(),
+            virtual_system_mapping().clone(),
+        )
+        .await?;
+        snapshot.load_table_summaries().await?;
+        snapshot.load_search_indexes().await?;
+        Ok(SnapshotInputs {
+            index_reader,
+            bootstrap_metadata: snapshot.bootstrap_metadata,
+            table_count_snapshot: Arc::new(snapshot.snapshot.table_counts),
+            text_index_snapshot: self.text_snapshot(
+                snapshot.snapshot.index_registry,
+                snapshot.snapshot.text_indexes,
+            ),
+        })
+    }
+
+    fn text_snapshot(
+        &self,
+        index_registry: IndexRegistry,
+        text_indexes: TextIndexManager,
+    ) -> Arc<dyn TransactionTextSnapshot> {
+        Arc::new(TextIndexManagerSnapshot::new(
+            index_registry,
+            text_indexes,
+            self.searcher.clone(),
+            self.database.search_storage.clone(),
+        ))
+    }
+}
+
+#[derive(serde::Serialize)]
+pub struct HealthReport {
+    pub healthy: bool,
+    pub instance: InstanceHealth,
+}
+
+#[derive(serde::Serialize)]
+pub struct InstanceHealth {
+    pub name: String,
+    pub healthy: bool,
+    pub warm_timestamp: Option<String>,
+    pub persistence_timestamp: Option<String>,
+    pub lag_seconds: Option<f64>,
+    pub error: Option<String>,
+    pub last_load_error: Option<String>,
+    pub last_load_error_unix_ts: Option<u64>,
+}
+
+#[derive(Clone)]
+pub struct SnapshotInputs {
+    pub index_reader: Arc<dyn IndexReader>,
+    pub bootstrap_metadata: BootstrapMetadata,
+    pub table_count_snapshot: Arc<dyn TableCountSnapshot>,
+    pub text_index_snapshot: Arc<dyn TransactionTextSnapshot>,
+}
