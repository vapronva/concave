+use anyhow::Context;
+use async_trait::async_trait;
+use common::{
+    bootstrap_model::components::handles::FunctionHandle,
+    components::{
+        CanonicalizedComponentFunctionPath,
+        ComponentId,
+        ComponentPath,
+        SerializedComponentFunctionPath,
+    },
+    execution_context::ExecutionContext,
+    http::{
+        CONVEX_ACTIONS_CALLBACK_TOKEN_HEADER,
+        CONVEX_ACTION_FUNCTION_NAME_HEADER,
+        CONVEX_EXECUTION_ID_HEADER,
+        CONVEX_REQUEST_ID_HEADER,
+        CONVEX_ROOT_REQUEST_HEADER,
+    },
+    runtime::UnixTimestamp,
+    types::{
+        AttributedCaller,
+        ConvexOrigin,
+    },
+};
+use keybroker::Identity;
+use model::file_storage::{
+    types::FileStorageEntry,
+    FileStorageId,
+};
+use prost::Message;
+use serde::{
+    Deserialize,
+    Serialize,
+};
+use serde_json::{
+    value::RawValue,
+    Value as JsonValue,
+};
+use sync_types::types::SerializedArgs;
+use udf::{
+    ActionCallbacks,
+    FunctionResult,
+};
+use usage_tracking::FunctionUsageStats;
+use value::{
+    ConvexValue,
+    DeveloperDocumentId,
+    JsonPackedValue,
+};
+use vector::PublicVectorSearchQueryResult;
+
+pub struct HttpActionCallbacks {
+    pub(crate) client: reqwest::Client,
+    pub(crate) backend_url: ConvexOrigin,
+    pub(crate) callback_token: String,
+    pub(crate) auth_header: Option<String>,
+    pub(crate) request_identity: Identity,
+    pub(crate) context: ExecutionContext,
+    pub(crate) action_name: Option<String>,
+}
+
+impl HttpActionCallbacks {
+    fn url(&self, path: &str) -> String {
+        format!(
+            "{}{}",
+            self.backend_url.as_str().trim_end_matches('/'),
+            path
+        )
+    }
+
+    fn request(
+        &self,
+        path: &str,
+        identity: &Identity,
+        context: &ExecutionContext,
+    ) -> reqwest::RequestBuilder {
+        let mut req = self
+            .client
+            .post(self.url(path))
+            .header(CONVEX_ACTIONS_CALLBACK_TOKEN_HEADER, &self.callback_token)
+            .header(CONVEX_REQUEST_ID_HEADER, context.request_id.to_string())
+            .header(CONVEX_EXECUTION_ID_HEADER, context.execution_id.to_string())
+            .header(CONVEX_ROOT_REQUEST_HEADER, context.is_root().to_string());
+        if let Some((component_id, job_id)) = &context.parent_scheduled_job {
+            req = req.header("Convex-Parent-Scheduled-Job", job_id.to_string());
+            if let Some(serialized) = component_id.serialize_to_string() {
+                req = req.header("Convex-Parent-Scheduled-Job-Component-Id", serialized);
+            }
+        }
+        if let Some(ip) = &context.request_metadata.ip {
+            req = req.header("Convex-Request-Client-Ip", ip.as_str());
+        }
+        if let Some(user_agent) = &context.request_metadata.user_agent {
+            req = req.header("Convex-Request-Client-User-Agent", user_agent.as_str());
+        }
+        if *identity == self.request_identity
+            && let Some(auth) = &self.auth_header
+        {
+            req = req.header(http::header::AUTHORIZATION, auth);
+        }
+        req
+    }
+
+    async fn run_function(
+        &self,
+        identity: Identity,
+        path: &str,
+        function_path: CanonicalizedComponentFunctionPath,
+        args: SerializedArgs,
+        context: &ExecutionContext,
+    ) -> anyhow::Result<FunctionResult> {
+        let args_raw: Box<RawValue> = RawValue::from_string(args.get().to_owned())?;
+        let body = RunFunctionBody {
+            path: function_path.udf_path.to_string(),
+            component_path: function_path.component.to_string(),
+            args: args_raw,
+        };
+        let response = self
+            .request(path, &identity, context)
+            .json(&body)
+            .send()
+            .await
+            .with_context(|| format!("funrun action callback to {path} failed"))?;
+        let text = checked(response).await?.text().await?;
+        let parsed: RunFunctionResponse = serde_json::from_str(&text)
+            .with_context(|| format!("funrun callback {path} returned unparseable body: {text}"))?;
+        let result = match parsed {
+            RunFunctionResponse::Success { value } => {
+                let convex_value = ConvexValue::try_from(value)
+                    .context("funrun callback success value was not a valid Convex value")?;
+                Ok(JsonPackedValue::pack(convex_value))
+            },
+            RunFunctionResponse::Error {
+                error_message,
+                error_data,
+            } => Err(build_js_error(error_message, error_data)),
+        };
+        Ok(FunctionResult { result })
+    }
+}
+
+fn callback_status_error(path: &str, status: http::StatusCode, text: String) -> anyhow::Error {
+    let (code, message) = common::http::HttpError::error_message_from_bytes(text.as_bytes())
+        .unwrap_or_else(|_| {
+            (
+                "CallbackFailed".into(),
+                format!("funrun callback {path} returned {status}").into(),
+            )
+        });
+    let err = anyhow::anyhow!("funrun callback {path} returned {status}: {text}");
+    match errors::ErrorMetadata::from_http_status_code(status, code, message) {
+        Some(metadata) => err.context(metadata),
+        None => err,
+    }
+}
+
+async fn checked(response: reqwest::Response) -> anyhow::Result<reqwest::Response> {
+    let status = response.status();
+    if status.is_success() {
+        return Ok(response);
+    }
+    let path = response.url().path().to_owned();
+    let text = response.text().await.unwrap_or_default();
+    Err(callback_status_error(&path, status, text))
+}
+
+fn build_js_error(message: String, data: Option<JsonValue>) -> common::errors::JsError {
+    match data.and_then(|d| ConvexValue::try_from(d).ok()) {
+        Some(custom) => common::errors::JsError::convex_error(message, custom),
+        None => common::errors::JsError::from_message(message),
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct RunFunctionBody {
+    path: String,
+    component_path: String,
+    args: Box<RawValue>,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "status", rename_all = "camelCase")]
+enum RunFunctionResponse {
+    #[serde(rename_all = "camelCase")]
+    Success { value: JsonValue },
+    #[serde(rename_all = "camelCase")]
+    Error {
+        error_message: String,
+        #[serde(default, deserialize_with = "deserialize_some")]
+        error_data: Option<JsonValue>,
+    },
+}
+
+fn deserialize_some<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<JsonValue>, D::Error> {
+    JsonValue::deserialize(deserializer).map(Some)
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ScheduleJobBody {
+    udf_path: String,
+    component_path: String,
+    udf_args: Box<RawValue>,
+    scheduled_ts: f64,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ScheduleJobResponse {
+    job_id: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CancelJobBody {
+    id: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CreateFunctionHandleBody {
+    udf_path: String,
+    component_path: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct CreateFunctionHandleResponse {
+    handle: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct StorageIdBody {
+    storage_id: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct StorageGetUrlResponse {
+    url: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct StorageGetFileEntryResponse {
+    component_path: String,
+    entry_proto: Vec<u8>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct StorageStoreFileEntryBody {
+    entry_proto: Vec<u8>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct StorageStoreFileEntryResponse {
+    component_path: String,
+    document_id: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct VectorSearchBody {
+    query: JsonValue,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct VectorSearchResponse {
+    results: Vec<VectorSearchResultJson>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct VectorSearchResultJson {
+    #[serde(rename = "_id")]
+    id: String,
+    #[serde(rename = "_score")]
+    score: f32,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct LookupFunctionHandleBody {
+    handle: String,
+}
+
+#[async_trait]
+impl ActionCallbacks for HttpActionCallbacks {
+    async fn create_ai_gateway_token(
+        &self,
+        _identity: Identity,
+        _caller: AttributedCaller,
+    ) -> anyhow::Result<String> {
+        anyhow::bail!(errors::ErrorMetadata::bad_request(
+            "AiGatewayUnavailable",
+            "`getServiceToken(\"ai-gateway\")` isn't available on this deployment because the AI \
+             gateway is a Convex Cloud service. Deploy to Convex Cloud, or call your model \
+             provider directly with your own API key."
+        ))
+    }
+
+    async fn execute_query(
+        &self,
+        identity: Identity,
+        path: CanonicalizedComponentFunctionPath,
+        args: SerializedArgs,
+        context: ExecutionContext,
+    ) -> anyhow::Result<FunctionResult> {
+        self.run_function(identity, "/api/actions/query", path, args, &context)
+            .await
+    }
+
+    async fn execute_mutation(
+        &self,
+        identity: Identity,
+        path: CanonicalizedComponentFunctionPath,
+        args: SerializedArgs,
+        context: ExecutionContext,
+    ) -> anyhow::Result<FunctionResult> {
+        self.run_function(identity, "/api/actions/mutation", path, args, &context)
+            .await
+    }
+
+    async fn execute_action(
+        &self,
+        identity: Identity,
+        path: CanonicalizedComponentFunctionPath,
+        args: SerializedArgs,
+        context: ExecutionContext,
+    ) -> anyhow::Result<FunctionResult> {
+        self.run_function(identity, "/api/actions/action", path, args, &context)
+            .await
+    }
+
+    async fn schedule_job(
+        &self,
+        identity: Identity,
+        _scheduling_component: ComponentId,
+        scheduled_path: CanonicalizedComponentFunctionPath,
+        udf_args: SerializedArgs,
+        scheduled_ts: UnixTimestamp,
+        context: ExecutionContext,
+    ) -> anyhow::Result<DeveloperDocumentId> {
+        let udf_args: Box<RawValue> = RawValue::from_string(udf_args.get().to_owned())?;
+        let body = ScheduleJobBody {
+            udf_path: scheduled_path.udf_path.to_string(),
+            component_path: scheduled_path.component.to_string(),
+            udf_args,
+            scheduled_ts: scheduled_ts.as_secs_f64(),
+        };
+        let response = self
+            .request("/api/actions/schedule_job", &identity, &context)
+            .json(&body)
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: ScheduleJobResponse = response.json().await?;
+        parsed.job_id.parse().context("invalid scheduled job id")
+    }
+
+    async fn cancel_job(
+        &self,
+        identity: Identity,
+        virtual_id: DeveloperDocumentId,
+    ) -> anyhow::Result<()> {
+        let response = self
+            .request("/api/actions/cancel_job", &identity, &self.context)
+            .json(&CancelJobBody {
+                id: virtual_id.to_string(),
+            })
+            .send()
+            .await?;
+        checked(response).await?;
+        Ok(())
+    }
+
+    async fn create_function_handle(
+        &self,
+        identity: Identity,
+        path: CanonicalizedComponentFunctionPath,
+    ) -> anyhow::Result<FunctionHandle> {
+        let body = CreateFunctionHandleBody {
+            udf_path: path.udf_path.to_string(),
+            component_path: path.component.to_string(),
+        };
+        let response = self
+            .request(
+                "/api/actions/create_function_handle",
+                &identity,
+                &self.context,
+            )
+            .json(&body)
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: CreateFunctionHandleResponse = response.json().await?;
+        parsed.handle.parse().context("invalid function handle")
+    }
+
+    async fn storage_get_url(
+        &self,
+        identity: Identity,
+        _component: ComponentId,
+        storage_id: FileStorageId,
+    ) -> anyhow::Result<Option<String>> {
+        let response = self
+            .request("/api/actions/storage_get_url", &identity, &self.context)
+            .json(&StorageIdBody {
+                storage_id: storage_id.to_string(),
+            })
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: StorageGetUrlResponse = response.json().await?;
+        Ok(parsed.url)
+    }
+
+    async fn storage_delete(
+        &self,
+        identity: Identity,
+        _component: ComponentId,
+        storage_id: FileStorageId,
+    ) -> anyhow::Result<()> {
+        let response = self
+            .request("/api/actions/storage_delete", &identity, &self.context)
+            .json(&StorageIdBody {
+                storage_id: storage_id.to_string(),
+            })
+            .send()
+            .await?;
+        checked(response).await?;
+        Ok(())
+    }
+
+    async fn storage_get_file_entry(
+        &self,
+        identity: Identity,
+        _component: ComponentId,
+        storage_id: FileStorageId,
+    ) -> anyhow::Result<Option<(ComponentPath, FileStorageEntry)>> {
+        let response = self
+            .request(
+                "/api/actions/storage_get_file_entry",
+                &identity,
+                &self.context,
+            )
+            .json(&StorageIdBody {
+                storage_id: storage_id.to_string(),
+            })
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: Option<StorageGetFileEntryResponse> = response.json().await?;
+        match parsed {
+            None => Ok(None),
+            Some(StorageGetFileEntryResponse {
+                component_path,
+                entry_proto,
+            }) => {
+                let component_path: ComponentPath = component_path.parse()?;
+                let entry_proto = pb::storage::FileStorageEntry::decode(&entry_proto[..])?;
+                let entry = FileStorageEntry::try_from(entry_proto)?;
+                Ok(Some((component_path, entry)))
+            },
+        }
+    }
+
+    async fn storage_store_file_entry(
+        &self,
+        identity: Identity,
+        _component: ComponentId,
+        entry: FileStorageEntry,
+    ) -> anyhow::Result<(ComponentPath, DeveloperDocumentId)> {
+        let entry_proto: pb::storage::FileStorageEntry = entry.into();
+        let response = self
+            .request(
+                "/api/actions/storage_store_file_entry",
+                &identity,
+                &self.context,
+            )
+            .json(&StorageStoreFileEntryBody {
+                entry_proto: entry_proto.encode_to_vec(),
+            })
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: StorageStoreFileEntryResponse = response.json().await?;
+        let component_path: ComponentPath = parsed.component_path.parse()?;
+        let document_id: DeveloperDocumentId = parsed.document_id.parse()?;
+        Ok((component_path, document_id))
+    }
+
+    async fn vector_search(
+        &self,
+        identity: Identity,
+        query: JsonValue,
+    ) -> anyhow::Result<(Vec<PublicVectorSearchQueryResult>, FunctionUsageStats)> {
+        let mut req = self
+            .request("/api/actions/vector_search", &identity, &self.context)
+            .json(&VectorSearchBody { query });
+        if let Some(action_name) = &self.action_name {
+            req = req.header(CONVEX_ACTION_FUNCTION_NAME_HEADER, action_name);
+        }
+        let response = checked(req.send().await?).await?;
+        let parsed: VectorSearchResponse = response.json().await?;
+        let results = parsed
+            .results
+            .into_iter()
+            .map(|VectorSearchResultJson { id, score }| {
+                anyhow::Ok(PublicVectorSearchQueryResult {
+                    id: id.parse()?,
+                    score,
+                })
+            })
+            .collect::<anyhow::Result<Vec<_>>>()?;
+        Ok((results, FunctionUsageStats::default()))
+    }
+
+    async fn lookup_function_handle(
+        &self,
+        identity: Identity,
+        handle: FunctionHandle,
+    ) -> anyhow::Result<CanonicalizedComponentFunctionPath> {
+        let response = self
+            .request(
+                "/api/actions/lookup_function_handle",
+                &identity,
+                &self.context,
+            )
+            .json(&LookupFunctionHandleBody {
+                handle: String::from(handle),
+            })
+            .send()
+            .await?;
+        let response = checked(response).await?;
+        let parsed: SerializedComponentFunctionPath = response.json().await?;
+        CanonicalizedComponentFunctionPath::try_from(parsed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use common::components::ComponentPath;
+    use serde_json::{
+        json,
+        Value as JsonValue,
+    };
+
+    use super::{
+        build_js_error,
+        RunFunctionBody,
+        RunFunctionResponse,
+    };
+
+    #[test]
+    fn run_function_body_keeps_root_component_path_absolute() {
+        let body = RunFunctionBody {
+            path: "app.js:bump".to_string(),
+            component_path: ComponentPath::root().to_string(),
+            args: serde_json::value::RawValue::from_string("{}".to_string()).unwrap(),
+        };
+        let encoded = serde_json::to_value(&body).unwrap();
+        assert_eq!(encoded.get("componentPath"), Some(&json!("")));
+        assert_eq!("".parse::<ComponentPath>().unwrap(), ComponentPath::root());
+    }
+
+    #[test]
+    fn run_function_response_keeps_null_error_data_distinct_from_absent() {
+        let success: RunFunctionResponse =
+            serde_json::from_value(json!({"status": "success", "value": 42})).unwrap();
+        assert!(matches!(
+            success,
+            RunFunctionResponse::Success { value } if value == json!(42)
+        ));
+        let decode = |body: serde_json::Value| -> Option<JsonValue> {
+            match serde_json::from_value(body).unwrap() {
+                RunFunctionResponse::Error { error_data, .. } => error_data,
+                RunFunctionResponse::Success { .. } => panic!("expected an error response"),
+            }
+        };
+        assert_eq!(
+            decode(json!({"status": "error", "errorMessage": "nope"})),
+            None
+        );
+        assert_eq!(
+            decode(json!({"status": "error", "errorMessage": "nope", "errorData": null})),
+            Some(JsonValue::Null)
+        );
+        let custom = build_js_error("custom".to_string(), Some(JsonValue::Null));
+        assert!(custom.custom_data.is_some());
+        assert!(build_js_error("plain".to_string(), None)
+            .custom_data
+            .is_none());
+    }
+}
