+use std::{
+    net::SocketAddr,
+    time::Duration,
+};
+
+use anyhow::Context;
+use clusters::DbDriverTag;
+use common::types::PersistenceVersion;
+use keybroker::DeploymentSecret;
+
+#[derive(Clone)]
+pub struct FunrunInstanceConfig {
+    pub instance_name: String,
+    pub instance_secret: DeploymentSecret,
+    pub db_spec: String,
+}
+
+pub struct FunrunConfig {
+    pub listen: SocketAddr,
+    pub health_listen: SocketAddr,
+    pub max_snapshot_lag: Duration,
+    pub drain_delay: Duration,
+    pub instance: FunrunInstanceConfig,
+    pub db: DbDriverTag,
+    pub require_ssl: bool,
+}
+
+impl FunrunConfig {
+    pub fn from_env() -> anyhow::Result<Self> {
+        let listen = std::env::var("FUNRUN_LISTEN")
+            .unwrap_or_else(|_| "0.0.0.0:8090".to_string())
+            .parse()
+            .context("Invalid FUNRUN_LISTEN")?;
+        let health_listen = std::env::var("FUNRUN_HEALTH_LISTEN")
+            .unwrap_or_else(|_| "0.0.0.0:8091".to_string())
+            .parse()
+            .context("Invalid FUNRUN_HEALTH_LISTEN")?;
+        let max_snapshot_lag = duration_secs_from_env("FUNRUN_MAX_SNAPSHOT_LAG_SECS", 30)?;
+        let drain_delay = duration_secs_from_env("CONVEX_FUNRUN_DRAIN_DELAY_SECS", 8)?;
+        let require_ssl = std::env::var_os("DO_NOT_REQUIRE_SSL").is_none();
+        let instance_name =
+            std::env::var("FUNRUN_INSTANCE_NAME").context("FUNRUN_INSTANCE_NAME must be set")?;
+        let instance_secret = std::env::var("FUNRUN_INSTANCE_SECRET")
+            .context("FUNRUN_INSTANCE_SECRET must be set")?;
+        let instance_secret = DeploymentSecret::try_from(instance_secret.as_str())?;
+        let db_spec = std::env::var("POSTGRES_URL").context("POSTGRES_URL must be set")?;
+        Ok(Self {
+            listen,
+            health_listen,
+            max_snapshot_lag,
+            drain_delay,
+            instance: FunrunInstanceConfig {
+                instance_name,
+                instance_secret,
+                db_spec,
+            },
+            db: DbDriverTag::Postgres(PersistenceVersion::V5),
+            require_ssl,
+        })
+    }
+}
+
+fn duration_secs_from_env(key: &str, default_secs: u64) -> anyhow::Result<Duration> {
+    Ok(std::env::var(key)
+        .ok()
+        .map(|v| {
+            v.parse::<u64>()
+                .map(Duration::from_secs)
+                .with_context(|| format!("Invalid {key}"))
+        })
+        .transpose()?
+        .unwrap_or(Duration::from_secs(default_secs)))
+}
diff --git a/crates/funrun_server/src/main.rs b/crates/funrun_server/src/main.rs
new file mode 100644
index 000000000..131bf8c9b
--- /dev/null
+++ b/crates/funrun_server/src/main.rs
@@ -0,0 +1,278 @@
+#![recursion_limit = "256"]
+
+use std::sync::{
+    atomic::{
+        AtomicBool,
+        Ordering,
+    },
+    Arc,
+};
+
+use anyhow::Context;
+use axum::{
+    extract::State,
+    http::StatusCode,
+    response::IntoResponse,
+    routing::get,
+    Json,
+    Router,
+};
+use cmd_util::env::config_service;
+use common::runtime::Runtime;
+use runtime::prod::ProdRuntime;
+use tokio::sync::watch;
+
+mod callbacks;
+mod config;
+mod metrics;
+mod service;
+mod snapshot;
+
+use config::FunrunConfig;
+use function_runner::remote::MAX_GRPC_MESSAGE_BYTES;
+use metrics::log_isolate_pool;
+use service::FunrunService;
+use snapshot::InstanceRegistry;
+
+fn main() -> anyhow::Result<()> {
+    let _guard = config_service();
+    let config = FunrunConfig::from_env()?;
+    let tokio = ProdRuntime::init_tokio()?;
+    let runtime = ProdRuntime::new(&tokio);
+    let runtime_ = runtime.clone();
+    runtime.block_on(
+        "convex-funrun",
+        async move { serve(runtime_, config).await },
+    )
+}
+
+async fn serve(runtime: ProdRuntime, config: FunrunConfig) -> anyhow::Result<()> {
+    tracing::info!(
+        "[convex-funrun] starting for instance {} on {}",
+        config.instance.instance_name,
+        config.listen,
+    );
+    let registry = Arc::new(InstanceRegistry::new(runtime.clone(), &config)?);
+    registry.prewarm().await;
+    spawn_pod_deletion_cost_updater(&runtime, registry.clone());
+    let service = FunrunService::new(runtime.clone(), registry.clone())?;
+    let server = pb::funrun::funrun_server::FunrunServer::new(service)
+        .max_decoding_message_size(*MAX_GRPC_MESSAGE_BYTES)
+        .max_encoding_message_size(*MAX_GRPC_MESSAGE_BYTES);
+    let mut builder = tonic::transport::Server::builder()
+        .http2_keepalive_interval(Some(std::time::Duration::from_secs(30)))
+        .http2_keepalive_timeout(Some(std::time::Duration::from_secs(10)));
+    let shutting_down = Arc::new(AtomicBool::new(false));
+    let (shutdown_tx, shutdown_rx) = watch::channel(false);
+    {
+        let shutting_down = shutting_down.clone();
+        let drain_delay = config.drain_delay;
+        runtime.spawn_background("funrun_shutdown_watcher", async move {
+            shutdown_signal().await;
+            shutting_down.store(true, Ordering::Release);
+            tokio::time::sleep(drain_delay).await;
+            let _ = shutdown_tx.send(true);
+        });
+    }
+    tracing::info!(
+        "[convex-funrun] listening on {} (health {})",
+        config.listen,
+        config.health_listen
+    );
+    let grpc = builder
+        .add_service(server)
+        .serve_with_shutdown(config.listen, wait_for_shutdown(shutdown_rx.clone()));
+    let health = serve_health(
+        config.health_listen,
+        config.max_snapshot_lag,
+        registry,
+        shutdown_rx,
+        shutting_down,
+    );
+    tokio::try_join!(
+        async { grpc.await.context("convex-funrun gRPC server exited") },
+        health
+    )?;
+    Ok(())
+}
+
+#[derive(Clone)]
+struct HealthState {
+    registry: Arc<InstanceRegistry<ProdRuntime>>,
+    max_snapshot_lag: std::time::Duration,
+    shutting_down: Arc<AtomicBool>,
+}
+
+async fn liveness(State(state): State<HealthState>) -> impl IntoResponse {
+    if !state.registry.healthy() {
+        return (
+            StatusCode::SERVICE_UNAVAILABLE,
+            "funrun worker has exited; pod must restart",
+        );
+    }
+    (StatusCode::OK, "ok")
+}
+
+async fn readiness(State(state): State<HealthState>) -> impl IntoResponse {
+    let report = state.registry.health_report(state.max_snapshot_lag);
+    let draining = state.shutting_down.load(Ordering::Acquire);
+    let status = if draining || !report.healthy || !state.registry.instance_ready() {
+        StatusCode::SERVICE_UNAVAILABLE
+    } else {
+        StatusCode::OK
+    };
+    (status, Json(report))
+}
+
+async fn metrics(State(state): State<HealthState>) -> impl IntoResponse {
+    let (busy, total) = state.registry.isolate_workers();
+    log_isolate_pool(busy, total);
+    common::http::metrics().await
+}
+
+async fn serve_health(
+    listen: std::net::SocketAddr,
+    max_snapshot_lag: std::time::Duration,
+    registry: Arc<InstanceRegistry<ProdRuntime>>,
+    shutdown_rx: watch::Receiver<bool>,
+    shutting_down: Arc<AtomicBool>,
+) -> anyhow::Result<()> {
+    let app = Router::new()
+        .route("/healthz", get(liveness))
+        .route("/readyz", get(readiness))
+        .route("/metrics", get(metrics))
+        .with_state(HealthState {
+            registry,
+            max_snapshot_lag,
+            shutting_down,
+        });
+    let listener = tokio::net::TcpListener::bind(listen).await?;
+    axum::serve(listener, app)
+        .with_graceful_shutdown(wait_for_shutdown(shutdown_rx))
+        .await
+        .context("convex-funrun health server exited")
+}
+
+const SERVICE_ACCOUNT_DIR: &str = "/var/run/secrets/kubernetes.io/serviceaccount";
+
+async fn in_cluster_client() -> anyhow::Result<reqwest::Client> {
+    let ca = tokio::fs::read(format!("{SERVICE_ACCOUNT_DIR}/ca.crt"))
+        .await
+        .context("reading the in-cluster serviceaccount CA certificate")?;
+    Ok(reqwest::Client::builder()
+        .add_root_certificate(reqwest::Certificate::from_pem(&ca)?)
+        .timeout(std::time::Duration::from_secs(10))
+        .build()?)
+}
+
+async fn patch_pod_deletion_cost(
+    client: &reqwest::Client,
+    url: &str,
+    cost: i64,
+) -> anyhow::Result<()> {
+    let token = tokio::fs::read_to_string(format!("{SERVICE_ACCOUNT_DIR}/token"))
+        .await
+        .context("reading the serviceaccount token")?;
+    let body = format!(
+        "{{\"metadata\":{{\"annotations\":{{\"controller.kubernetes.io/pod-deletion-cost\":\"\
+         {cost}\"}}}}}}"
+    );
+    let response = client
+        .patch(url)
+        .bearer_auth(token.trim())
+        .header(
+            reqwest::header::CONTENT_TYPE,
+            "application/strategic-merge-patch+json",
+        )
+        .body(body)
+        .send()
+        .await?;
+    anyhow::ensure!(
+        response.status().is_success(),
+        "pod patch returned HTTP {}",
+        response.status()
+    );
+    Ok(())
+}
+
+fn spawn_pod_deletion_cost_updater(
+    runtime: &ProdRuntime,
+    registry: Arc<InstanceRegistry<ProdRuntime>>,
+) {
+    let enabled = std::env::var("CONVEX_FUNRUN_POD_DELETION_COST")
+        .map(|v| v == "true" || v == "1")
+        .unwrap_or(false);
+    if !enabled {
+        return;
+    }
+    let (Ok(pod), Ok(namespace)) = (std::env::var("POD_NAME"), std::env::var("POD_NAMESPACE"))
+    else {
+        tracing::warn!(
+            "[convex-funrun] pod-deletion-cost on but POD_NAME/POD_NAMESPACE unset; disabled"
+        );
+        return;
+    };
+    let url = format!("https://kubernetes.default.svc/api/v1/namespaces/{namespace}/pods/{pod}");
+    runtime.spawn_background("funrun_pod_deletion_cost", async move {
+        let client = match in_cluster_client().await {
+            Ok(client) => client,
+            Err(e) => {
+                tracing::warn!(
+                    "[convex-funrun] pod-deletion-cost: no in-cluster API client ({e:#}); disabled"
+                );
+                return;
+            },
+        };
+        tracing::info!("[convex-funrun] pod-deletion-cost updater active for {namespace}/{pod}");
+        let mut last: Option<i64> = None;
+        let mut failures: u32 = 0;
+        loop {
+            tokio::time::sleep(std::time::Duration::from_secs(30)).await;
+            let (busy, total) = registry.isolate_workers();
+            let cost = busy as i64;
+            if last == Some(cost) {
+                continue;
+            }
+            match patch_pod_deletion_cost(&client, &url, cost).await {
+                Ok(()) => {
+                    last = Some(cost);
+                    failures = 0;
+                    tracing::debug!(
+                        "[convex-funrun] pod-deletion-cost={cost} (isolates {busy}/{total})"
+                    );
+                },
+                Err(e) => {
+                    failures += 1;
+                    if failures == 1 {
+                        tracing::warn!("[convex-funrun] pod-deletion-cost patch failed: {e:#}");
+                    } else {
+                        tracing::debug!("[convex-funrun] pod-deletion-cost patch failed: {e:#}");
+                    }
+                },
+            }
+        }
+    });
+}
+
+async fn wait_for_shutdown(mut shutdown_rx: watch::Receiver<bool>) {
+    if !*shutdown_rx.borrow() {
+        let _ = shutdown_rx.changed().await;
+    }
+}
+
+async fn shutdown_signal() {
+    #[cfg(unix)]
+    {
+        let mut term = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+            .expect("install SIGTERM handler");
+        tokio::select! {
+            _ = term.recv() => {},
+            _ = tokio::signal::ctrl_c() => {},
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+    }
+    tracing::info!("[convex-funrun] shutdown signal; readiness now 503, draining before gRPC stop");
+}
