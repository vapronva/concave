+
+impl<RT: Runtime> InstanceRegistry<RT> {
+    pub fn new(rt: RT, config: &FunrunConfig) -> anyhow::Result<Self> {
+        let isolate_client = IsolateClient::new(
+            rt.clone(),
+            MAX_PERCENT_PER_CLIENT,
+            *MAX_ISOLATE_WORKERS,
+            funrun_isolate_worker(&rt),
+        )?;
+        tracing::info!(
+            "[convex-funrun] shared isolate pool: {} workers",
+            isolate_client.max_workers(),
+        );
+        Ok(Self {
+            rt,
+            require_ssl: config.require_ssl,
+            mode: config.mode,
+            instance: config.instance.clone(),
+            isolate_client,
+            state: OnceLock::new(),
+            load_error_ts: Mutex::new(None),
+        })
+    }
+
+    pub fn isolate_workers(&self) -> (usize, usize) {
+        let busy = if self.isolate_client.scheduler_alive() {
+            self.isolate_client.active_workers()
+        } else {
+            0
+        };
+        (busy, self.isolate_client.max_workers())
+    }
+
+    pub fn healthy(&self) -> bool {
+        self.isolate_client.scheduler_alive()
+            && self
+                .state
+                .get()
+                .is_none_or(|state| state.source.tailer_alive())
+    }
+
+    pub fn instance_ready(&self) -> bool {
+        self.state.get().is_some_and(|state| state.source.ready())
+    }
+
+    pub fn instance_config(&self, instance_name: &str) -> anyhow::Result<&FunrunInstanceConfig> {
+        anyhow::ensure!(
+            instance_name == self.instance.instance_name,
+            "funrun pod is not configured for instance {instance_name:?} (FUNRUN_INSTANCE_NAME)"
+        );
+        Ok(&self.instance)
+    }
+
+    pub async fn warm(&self) -> Arc<InstanceState<RT>> {
+        let mut backoff = Backoff::new(WARMUP_BACKOFF_INITIAL, WARMUP_BACKOFF_MAX);
+        loop {
+            let loaded = InstanceState::load(
+                self.rt.clone(),
+                &self.instance,
+                self.mode,
+                self.require_ssl,
+                self.isolate_client.clone(),
+            )
+            .await;
+            *self.load_error_ts.lock() = loaded
+                .as_ref()
+                .err()
+                .map(|_| self.rt.unix_timestamp().as_secs());
+            match loaded {
+                Ok(state) => return self.state.get_or_init(|| Arc::new(state)).clone(),
+                Err(e) => {
+                    let delay = backoff.fail(&mut self.rt.rng());
+                    tracing::error!(
+                        "[convex-funrun] instance load failed: {e:#}; retrying in {:.1}s",
+                        delay.as_secs_f32()
+                    );
+                    self.rt.wait(delay).await;
+                },
+            }
+        }
+    }
+
+    pub fn health_report(&self) -> HealthReport {
+        HealthReport {
+            healthy: self.healthy(),
+            mode: self.mode,
+            instance: InstanceHealth {
+                name: self.instance.instance_name.clone(),
+                ready: self.instance_ready(),
+                last_load_error_unix_ts: *self.load_error_ts.lock(),
+            },
+        }
+    }
+}
+
+enum SnapshotSource<RT: Runtime> {
+    Follower {
+        database: Database<RT>,
+        tailer: FollowerTailerClient,
+    },
+    Stateless {
+        bootstrap_metadata: BootstrapMetadata,
+    },
+}
+
+impl<RT: Runtime> SnapshotSource<RT> {
+    fn tailer_alive(&self) -> bool {
+        match self {
+            Self::Follower { tailer, .. } => tailer.is_running(),
+            Self::Stateless { .. } => true,
+        }
+    }
+
+    fn ready(&self) -> bool {
+        match self {
+            Self::Follower { tailer, .. } => tailer.is_ready(),
+            Self::Stateless { .. } => true,
+        }
+    }
+}
+
+pub struct InstanceState<RT: Runtime> {
+    rt: RT,
+    pub instance_name: String,
+    pub key_broker: FunctionRunnerKeyBroker,
+    reader: Arc<dyn PersistenceReader>,
+    pub retention_validator: Arc<dyn RetentionValidator>,
+    pub core: FunctionRunnerCore<RT, DeploymentStorage>,
+    source: SnapshotSource<RT>,
+}
+
+impl<RT: Runtime> InstanceState<RT> {
+    pub async fn load(
+        rt: RT,
+        config: &FunrunInstanceConfig,
+        mode: FunrunMode,
+        require_ssl: bool,
+        isolate_client: IsolateClient<RT>,
+    ) -> anyhow::Result<Self> {
+        let reader = db_connection::connect_persistence_reader(
+            clusters::DbDriverTag::Postgres(common::types::PersistenceVersion::V5),
+            &config.db_spec,
+            require_ssl,
+            &config.instance_name,
+            None,
+            rt.clone(),
+        )
+        .await?;
+        let key_broker = keybroker::KeyBroker::new(&config.instance_name, config.instance_secret)?
+            .function_runner_keybroker();
+        let (source, retention_validator, storage_type) = match mode {
+            FunrunMode::Follower => Self::load_follower(&rt, &reader).await?,
+            FunrunMode::Stateless => Self::load_stateless(&rt, &reader).await?,
+        };
+        let files_storage =
+            create_storage(rt.clone(), &storage_type, storage::StorageUseCase::Files).await?;
+        let modules_storage =
+            create_storage(rt.clone(), &storage_type, storage::StorageUseCase::Modules).await?;
+        let core = FunctionRunnerCore::new_with_isolate_client(
+            rt.clone(),
+            DeploymentStorage {
+                files_storage,
+                modules_storage,
+            },
+            isolate_client,
+        );
+        tracing::info!(
+            "[convex-funrun] loaded instance {} ({:?} storage, {} mode)",
+            config.instance_name,
+            storage_type,
+            mode.as_str(),
+        );
+        Ok(Self {
+            rt,
+            instance_name: config.instance_name.clone(),
+            key_broker,
+            reader,
+            retention_validator,
+            core,
+            source,
+        })
+    }
+
+    async fn load_follower(
+        rt: &RT,
+        reader: &Arc<dyn PersistenceReader>,
+    ) -> anyhow::Result<(SnapshotSource<RT>, Arc<dyn RetentionValidator>, StorageType)> {
+        let searcher: Arc<dyn search::Searcher> = Arc::new(InProcessSearcher::new(rt.clone())?);
+        let database = Database::load_follower(
+            reader.clone(),
+            rt.clone(),
+            searcher,
+            virtual_system_mapping().clone(),
+            FollowerOptions::FUNRUN,
+        )
+        .await?;
+        let retention_validator = database.retention_validator();
+        let storage_type = read_storage_type(database.begin_system().await?).await?;
+        let search_storage = create_storage(
+            rt.clone(),
+            &storage_type,
+            storage::StorageUseCase::SearchIndexes,
+        )
+        .await?;
+        database.set_search_storage(search_storage);
+        tracing::info!(
+            "[convex-funrun] warm follower snapshot at {}",
+            database.now_ts_for_reads()
+        );
+        let tailer = database.follower_tailer_client().await?;
+        Ok((
+            SnapshotSource::Follower { database, tailer },
+            retention_validator,
+            storage_type,
+        ))
+    }
+
+    async fn load_stateless(
+        rt: &RT,
+        reader: &Arc<dyn PersistenceReader>,
+    ) -> anyhow::Result<(SnapshotSource<RT>, Arc<dyn RetentionValidator>, StorageType)> {
+        let retention_validator: Arc<dyn RetentionValidator> =
+            Arc::new(FollowerRetentionManager::new(rt.clone(), reader.clone()).await?);
+        let snapshot = DatabaseSnapshot::load(
+            rt.clone(),
+            reader.clone(),
+            new_static_repeatable_recent(reader.as_ref()).await?,
+            retention_validator.clone(),
+            virtual_system_mapping().clone(),
+        )
+        .await?;
+        let tx = snapshot.begin_tx(
+            Identity::system(),
+            Arc::new(SearchNotEnabled),
+            FunctionUsageTracker::new(),
+            virtual_system_mapping().clone(),
+        )?;
+        let storage_type = read_storage_type(tx).await?;
+        Ok((
+            SnapshotSource::Stateless {
+                bootstrap_metadata: snapshot.bootstrap_metadata,
+            },
+            retention_validator,
+            storage_type,
+        ))
+    }
+
+    pub async fn snapshot_inputs(
+        &self,
+        ts: RepeatableTimestamp,
+        udf_type: UdfType,
+        callbacks: &Arc<HttpActionCallbacks>,
+    ) -> anyhow::Result<SnapshotInputs> {
+        match (&self.source, udf_type) {
+            (source, UdfType::Action | UdfType::HttpAction) => self.action_inputs(source, ts),
+            (SnapshotSource::Stateless { bootstrap_metadata }, _) => {
+                let leader = Arc::new(LeaderSnapshot::new(callbacks.clone(), ts));
+                Ok(SnapshotInputs {
+                    index_reader: self.index_reader(ts, None)?,
+                    bootstrap_metadata: bootstrap_metadata.clone(),
+                    table_count_snapshot: leader.clone(),
+                    text_index_snapshot: leader,
+                })
+            },
+            (SnapshotSource::Follower { database, tailer }, _) => {
+                let prepare = self.prepare_follower_inputs(database, tailer, ts).fuse();
+                let deadline = self.rt.wait(SNAPSHOT_WAIT_TIMEOUT).fuse();
+                futures::pin_mut!(prepare, deadline);
+                futures::select_biased! {
+                    result = prepare => result,
+                    _ = deadline => anyhow::bail!(ErrorMetadata::rejected_before_execution(
+                        "FunrunSnapshotTimeout", "funrun follower did not prepare the requested snapshot",
+                    )),
+                }
+            },
+        }
+    }
+
+    fn action_inputs(
+        &self,
+        source: &SnapshotSource<RT>,
+        ts: RepeatableTimestamp,
+    ) -> anyhow::Result<SnapshotInputs> {
+        let (bootstrap_metadata, attribution) = match source {
+            SnapshotSource::Follower { database, .. } => (
+                database.bootstrap_metadata.clone(),
+                database.latest_snapshot().ok().map(|snapshot| {
+                    (
+                        snapshot.index_registry,
+                        snapshot.table_registry.table_mapping().clone(),
+                    )
+                }),
+            ),
+            SnapshotSource::Stateless { bootstrap_metadata } => (bootstrap_metadata.clone(), None),
+        };
+        Ok(SnapshotInputs {
+            index_reader: self.index_reader(ts, attribution)?,
+            bootstrap_metadata,
+            table_count_snapshot: Arc::new(None::<TableCounts>),
+            text_index_snapshot: Arc::new(NoActionTextSearch),
+        })
+    }
+
+    fn index_reader(
+        &self,
+        ts: RepeatableTimestamp,
+        attribution: Attribution,
+    ) -> anyhow::Result<Arc<dyn IndexReader>> {
+        let persistence_snapshot =
+            RepeatablePersistence::new(self.reader.clone(), ts, self.retention_validator.clone())
+                .read_snapshot(ts)?;
+        Ok(attributed(persistence_snapshot, attribution))
+    }
+
+    async fn prepare_follower_inputs(
+        &self,
+        database: &Database<RT>,
+        tailer: &FollowerTailerClient,
+        ts: RepeatableTimestamp,
+    ) -> anyhow::Result<SnapshotInputs> {
+        if tailer.has_reached(ts) {
+            log_snapshot_warm_hit();
+        } else {
+            log_snapshot_cold();
+            tailer.wait_for(ts).await.map_err(|error| {
+                error.context(ErrorMetadata::rejected_before_execution(
+                    "FunrunTailerExited",
+                    "funrun follower tailer exited",
+                ))
+            })?;
+        }
+        let persistence =
+            RepeatablePersistence::new(self.reader.clone(), ts, self.retention_validator.clone());
+        let persistence_snapshot = persistence.read_snapshot(ts)?;
+        match database.snapshot(ts) {
+            Ok(snapshot) => {
+                let counts = snapshot
+                    .table_counts
+                    .context("follower snapshot has no table counts")?;
+                Ok(SnapshotInputs {
+                    index_reader: attributed(
+                        persistence_snapshot,
+                        Some((
+                            snapshot.index_registry.clone(),
+                            snapshot.table_registry.table_mapping().clone(),
+                        )),
+                    ),
+                    bootstrap_metadata: database.bootstrap_metadata.clone(),
+                    table_count_snapshot: Arc::new(Some(counts)),
+                    text_index_snapshot: text_snapshot(
+                        database,
+                        snapshot.index_registry,
+                        snapshot.text_indexes,
+                    ),
+                })
+            },
+            Err(error) if error.is_out_of_retention() => {
+                self.full_cold_snapshot_inputs(database, ts, persistence_snapshot)
+                    .await
+            },
+            Err(error) => Err(error),
+        }
+    }
+
+    async fn full_cold_snapshot_inputs(
+        &self,
+        database: &Database<RT>,
+        ts: RepeatableTimestamp,
+        persistence_snapshot: PersistenceSnapshot,
+    ) -> anyhow::Result<SnapshotInputs> {
+        log_snapshot_cold_load();
+        let mut snapshot = DatabaseSnapshot::load(
+            self.rt.clone(),
+            self.reader.clone(),
+            ts,
+            self.retention_validator.clone(),
+            virtual_system_mapping().clone(),
+        )
+        .await?;
+        snapshot.load_table_summaries().await?;
+        snapshot
+            .load_search_indexes(FollowerOptions::FUNRUN)
+            .await?;
+        Ok(SnapshotInputs {
+            index_reader: attributed(
+                persistence_snapshot,
+                Some((
+                    snapshot.snapshot.index_registry.clone(),
+                    snapshot.snapshot.table_registry.table_mapping().clone(),
+                )),
+            ),
+            bootstrap_metadata: snapshot.bootstrap_metadata,
+            table_count_snapshot: Arc::new(snapshot.snapshot.table_counts),
+            text_index_snapshot: text_snapshot(
+                database,
+                snapshot.snapshot.index_registry,
+                snapshot.snapshot.text_indexes,
+            ),
+        })
+    }
+}
+
+async fn read_storage_type<RT: Runtime>(mut tx: Transaction<RT>) -> anyhow::Result<StorageType> {
+    DatabaseGlobalsModel::new(&mut tx)
+        .database_globals()
+        .await?
+        .into_value()
+        .storage_type
+        .context(
+            "funrun cannot start: database storage tag is not initialized (the leader must \
+             initialize the database first)",
+        )
+}
+
+fn attributed(
+    persistence_snapshot: PersistenceSnapshot,
+    attribution: Attribution,
+) -> Arc<dyn IndexReader> {
+    let (index_registry, table_mapping) = attribution.unzip();
+    Arc::new(AttributedIndexReader::new(
+        persistence_snapshot,
+        IndexScanCaller::FunctionRunner,
+        index_registry,
+        table_mapping,
+    ))
+}
+
+fn text_snapshot<RT: Runtime>(
+    database: &Database<RT>,
+    index_registry: IndexRegistry,
+    text_indexes: TextIndexManager,
+) -> Arc<dyn TransactionTextSnapshot> {
+    Arc::new(TextIndexManagerSnapshot::new(
+        index_registry,
+        text_indexes,
+        database.searcher.clone(),
+        database.search_storage.clone(),
+    ))
+}
+
+struct NoActionTextSearch;
+
+#[async_trait]
+impl TransactionTextSnapshot for NoActionTextSearch {
+    async fn search(
+        &self,
+        _index: &Index,
+        _search: &InternalSearch,
+        _version: SearchVersion,
+        _pending_updates: &Vec<DocumentUpdate>,
+    ) -> anyhow::Result<QueryResults> {
+        anyhow::bail!("text search is not available in an action's own transaction")
+    }
+}
