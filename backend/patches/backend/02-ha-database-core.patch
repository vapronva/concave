@@ -0,0 +1,335 @@
+use common::{
+    knobs::DOCUMENT_RETENTION_RATE_LIMIT,
+    persistence::new_static_repeatable_recent,
+    runtime::new_rate_limiter,
+};
+use governor::Quota;
+
+use super::*;
+use crate::{
+    follower_tailer::{
+        FollowerLogTailer,
+        FollowerTailerClient,
+    },
+    retention::FollowerRetentionManager,
+    search_index_bootstrap::bootstrap_search_indexes,
+};
+
+impl<RT: Runtime> DatabaseSnapshot<RT> {
+    pub async fn load_search_indexes(&mut self) -> anyhow::Result<()> {
+        let persistence = RepeatablePersistence::new(
+            self.persistence_reader.clone(),
+            self.ts,
+            self.retention_validator.clone(),
+        );
+        let indexes = bootstrap_search_indexes(
+            self.snapshot.index_registry.clone(),
+            &persistence,
+            self.snapshot
+                .table_mapping()
+                .namespace(TableNamespace::Global),
+        )
+        .await?;
+        self.snapshot.text_indexes = indexes.text_index_manager;
+        self.snapshot.vector_indexes = indexes.vector_index_manager;
+        Ok(())
+    }
+}
+
+impl<RT: Runtime> Database<RT> {
+    #[fastrace::trace]
+    pub async fn load_follower(
+        reader: Arc<dyn PersistenceReader>,
+        runtime: RT,
+        searcher: Arc<dyn Searcher>,
+        virtual_system_mapping: VirtualSystemMapping,
+        index_cache: IndexCache,
+    ) -> anyhow::Result<Self> {
+        let _load_database_timer = metrics::load_database_timer();
+        let retention_manager: Arc<dyn RetentionValidator> =
+            Arc::new(FollowerRetentionManager::new(runtime.clone(), reader.clone()).await?);
+        let snapshot_ts = new_static_repeatable_recent(reader.as_ref()).await?;
+        let mut db_snapshot = DatabaseSnapshot::load(
+            runtime.clone(),
+            reader.clone(),
+            snapshot_ts,
+            retention_manager.clone(),
+            virtual_system_mapping.clone(),
+        )
+        .await?;
+        db_snapshot.load_table_summaries().await?;
+        let DatabaseSnapshot {
+            bootstrap_metadata,
+            ts,
+            snapshot,
+            ..
+        } = db_snapshot;
+        let snapshot_manager = SnapshotManager::new(*ts, snapshot);
+        let (snapshot_reader, snapshot_writer) = new_split_rw_lock(snapshot_manager);
+        let follower_tailer = FollowerLogTailer::start(
+            runtime.clone(),
+            snapshot_writer,
+            reader.clone(),
+            retention_manager.clone(),
+            virtual_system_mapping.clone(),
+            ts,
+        );
+        let follower_tailer_handle = Arc::new(tokio::sync::Mutex::new(Some(follower_tailer)));
+        let (log_owner, log_reader, _log_writer) = new_write_log(*ts);
+        let index_cache_handle = index_cache.new_handle().build(
+            bootstrap_metadata.index_tablet_id,
+            Arc::new(log_reader.clone()),
+        );
+        let invalidation_callback = InvalidationMetricCallback::new();
+        let subscriptions =
+            SubscriptionsWorker::start(log_owner, runtime.clone(), invalidation_callback.clone());
+        let table_mapping_snapshot_cache =
+            AsyncLru::new(runtime.clone(), 20, 2, 200, "table_mapping_snapshot");
+        let by_id_indexes_snapshot_cache =
+            AsyncLru::new(runtime.clone(), 20, 2, 200, "by_id_indexes_snapshot");
+        let component_paths_snapshot_cache =
+            AsyncLru::new(runtime.clone(), 20, 2, 200, "component_paths_snapshot");
+        let list_snapshot_table_iterator_cache = Arc::new(tokio::sync::Mutex::new(None));
+        let database = Self {
+            leader_state: Arc::new(parking_lot::RwLock::new(DatabaseLeaderState {
+                committer: None,
+                subscriptions,
+                log: log_reader.clone(),
+                retention_manager,
+                retention_workers: None,
+                index_cache_handle: Some(index_cache_handle),
+                index_cache: Some(index_cache),
+            })),
+            runtime,
+            snapshot_manager: snapshot_reader,
+            table_shapes: Arc::new(ArcSwapOption::empty()),
+            reader,
+            write_commits_since_load: Arc::new(AtomicUsize::new(0)),
+            searcher,
+            search_storage: Arc::new(OnceLock::new()),
+            virtual_system_mapping,
+            bootstrap_metadata,
+            invalidation_callback,
+            table_mapping_snapshot_cache,
+            by_id_indexes_snapshot_cache,
+            component_paths_snapshot_cache,
+            list_snapshot_table_iterator_cache,
+            follower_tailer_handle,
+            lease_watch_handle: Arc::new(parking_lot::Mutex::new(None)),
+            lease_probe_last_ok: Arc::new(parking_lot::Mutex::new(None)),
+            search_flusher_wake: SearchFlusherWakeSignals::new(),
+        };
+        Ok(database)
+    }
+
+    pub async fn follower_tailer_client(&self) -> anyhow::Result<FollowerTailerClient> {
+        self.follower_tailer_handle
+            .lock()
+            .await
+            .as_ref()
+            .map(|handle| handle.client.clone())
+            .context("database has no follower tailer")
+    }
+
+    pub async fn become_leader(
+        &self,
+        rw_persistence: Arc<dyn Persistence>,
+        preempt_signal: ShutdownSignal,
+        deployment_name: String,
+    ) -> anyhow::Result<mpsc::Receiver<TabletId>> {
+        let promoted = {
+            let handle = self.follower_tailer_handle.lock().await.take().context(
+                "become_leader called but there is no follower tailer to stop (already promoted \
+                 or not a follower?)",
+            )?;
+            handle.promote().await?
+        };
+        let mut snapshot_writer = promoted.writer;
+        let tailed_ts = promoted.tailed_ts;
+        tracing::info!(
+            "[promote] tailer stopped; recovered Writer at tailed_ts {tailed_ts}; \
+             snapshot.latest_ts {}",
+            self.snapshot_manager.lock().latest_ts(),
+        );
+        let idle_ts = new_idle_repeatable_ts(rw_persistence.as_ref(), &self.runtime).await?;
+        anyhow::ensure!(
+            *idle_ts >= *tailed_ts,
+            "promotion invariant violated: idle_ts {idle_ts} < tailed_ts {tailed_ts} (a write \
+             landed after the FINAL fast-forward — impossible while we hold the lease)"
+        );
+        if *idle_ts > *self.snapshot_manager.lock().latest_ts() {
+            snapshot_writer
+                .write()
+                .bump_persisted_max_repeatable_ts(*idle_ts)?;
+        }
+        let latest_ts = self.snapshot_manager.lock().latest_ts();
+        anyhow::ensure!(
+            *latest_ts == *idle_ts,
+            "promotion invariant violated: after bump, snapshot latest_ts {latest_ts} != idle_ts \
+             {idle_ts}"
+        );
+        let (retention_manager, retention_worker_seed) =
+            LeaderRetentionManager::new(self.runtime.clone(), rw_persistence.clone(), idle_ts)
+                .await?;
+        let (deleted_tablet_sender, deleted_tablet_receiver) = mpsc::channel(100);
+        let retention_workers = retention_worker_seed
+            .start_retention(
+                self.bootstrap_metadata.clone(),
+                self.snapshot_manager.clone(),
+                preempt_signal.clone(),
+                Arc::new(new_rate_limiter(
+                    self.runtime.clone(),
+                    Quota::per_second(*DOCUMENT_RETENTION_RATE_LIMIT),
+                )),
+                deleted_tablet_sender,
+            )
+            .await?;
+        let (log_owner, log_reader, log_writer) = new_write_log(*idle_ts);
+        let index_cache_handle = {
+            let leader_state = self.leader_state.read();
+            leader_state
+                .index_cache_handle
+                .as_ref()
+                .context("become_leader requires an index cache handle")?
+                .remove_deployment();
+            leader_state
+                .index_cache
+                .as_ref()
+                .context("become_leader requires the follower's index cache")?
+                .new_handle()
+                .build(
+                    self.bootstrap_metadata.index_tablet_id,
+                    Arc::new(log_reader.clone()),
+                )
+        };
+        let subscriptions = SubscriptionsWorker::start(
+            log_owner,
+            self.runtime.clone(),
+            self.invalidation_callback.clone(),
+        );
+        let virtual_system_mapping = self.virtual_system_mapping.clone();
+        let lease_watch_persistence = rw_persistence.clone();
+        let lease_watch_preempt = preempt_signal.clone();
+        let committer = Committer::start(
+            log_writer,
+            snapshot_writer,
+            rw_persistence,
+            self.runtime.clone(),
+            retention_manager.clone(),
+            preempt_signal,
+            virtual_system_mapping,
+            index_cache_handle.clone(),
+            deployment_name,
+            self.search_flusher_wake.clone(),
+        );
+        let old_subscriptions = {
+            let mut leader_state = self.leader_state.write();
+            let old_subscriptions = leader_state.subscriptions.clone();
+            leader_state.committer = Some(committer);
+            leader_state.subscriptions = subscriptions;
+            leader_state.log = log_reader;
+            leader_state.retention_manager = retention_manager as Arc<dyn RetentionValidator>;
+            leader_state.retention_workers = Some(retention_workers);
+            leader_state.index_cache_handle = Some(index_cache_handle);
+            old_subscriptions
+        };
+        old_subscriptions.shutdown();
+        self.spawn_lease_watch(lease_watch_persistence, lease_watch_preempt);
+        tracing::info!(
+            "[promote] Database promoted to leader at ts {idle_ts}; committer + retention running"
+        );
+        Ok(deleted_tablet_receiver)
+    }
+
+    pub fn lease_unverified_secs(&self) -> Option<u64> {
+        self.lease_probe_last_ok
+            .lock()
+            .map(|t| t.elapsed().as_secs())
+    }
+
+    pub fn spawn_lease_watch(
+        &self,
+        rw_persistence: Arc<dyn Persistence>,
+        preempt_signal: ShutdownSignal,
+    ) {
+        let runtime = self.runtime.clone();
+        let probe_last_ok = self.lease_probe_last_ok.clone();
+        *probe_last_ok.lock() = Some(std::time::Instant::now());
+        let worker = async move {
+            const MAX_NON_TRANSIENT_PROBE_FAILURES: usize = 3;
+            const TRANSIENT_HEARTBEAT_EVERY: usize = 20;
+            const POLL_INTERVAL: Duration = Duration::from_millis(1500);
+            let mut non_transient_failures = 0;
+            let mut transient_failures: usize = 0;
+            loop {
+                match rw_persistence.lease_held().await {
+                    Ok(true) => {
+                        non_transient_failures = 0;
+                        transient_failures = 0;
+                        *probe_last_ok.lock() = Some(std::time::Instant::now());
+                    },
+                    Ok(false) => {
+                        *probe_last_ok.lock() = Some(std::time::Instant::now());
+                        break;
+                    },
+                    Err(e) if common::errors::is_transient_db_error(&e) => {
+                        non_transient_failures = 0;
+                        transient_failures += 1;
+                        if transient_failures % TRANSIENT_HEARTBEAT_EVERY == 0 {
+                            tracing::warn!(
+                                "[lease-watch] {transient_failures} consecutive transient probe \
+                                 errors; lease ownership unverified: {e:#}"
+                            );
+                        }
+                    },
+                    Err(e) => {
+                        transient_failures = 0;
+                        non_transient_failures += 1;
+                        if non_transient_failures >= MAX_NON_TRANSIENT_PROBE_FAILURES {
+                            tracing::error!(
+                                "[lease-watch] probe failed {non_transient_failures} times with \
+                                 non-transient errors; firing preempt: {e:#}"
+                            );
+                            preempt_signal.signal(anyhow::anyhow!(
+                                "lease-watch cannot verify lease ownership after \
+                                 {non_transient_failures} non-transient failures: {e:#}"
+                            ));
+                            return;
+                        }
+                        tracing::warn!(
+                            "[lease-watch] non-transient probe error \
+                             ({non_transient_failures}/{MAX_NON_TRANSIENT_PROBE_FAILURES}): {e:#}"
+                        );
+                    },
+                }
+                runtime.wait(POLL_INTERVAL).await;
+            }
+            preempt_signal.signal(anyhow::anyhow!("lease lost; restarting"));
+        };
+        let new_handle = self.runtime.spawn("lease_watch", worker);
+        let old_handle = self.lease_watch_handle.lock().replace(new_handle);
+        drop(old_handle);
+    }
+
+    pub(super) fn committer(&self) -> anyhow::Result<CommitterClient> {
+        Self::committer_of(&self.leader_state.read())
+    }
+
+    pub(super) fn committer_of(
+        leader_state: &DatabaseLeaderState,
+    ) -> anyhow::Result<CommitterClient> {
+        leader_state
+            .committer
+            .clone()
+            .context(ErrorMetadata::misdirected_request())
+            .context("write attempted on follower (no committer)")
+    }
+
+    pub(super) fn subscriptions(&self) -> SubscriptionsClient {
+        self.leader_state.read().subscriptions.clone()
+    }
+
+    pub(super) fn index_cache_handle(&self) -> Option<IndexCacheHandle> {
+        self.leader_state.read().index_cache_handle.clone()
+    }
+}
