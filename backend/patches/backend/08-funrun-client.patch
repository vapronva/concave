+pub struct RemoteFunctionRunner<RT: Runtime> {
+    channel: Channel,
+    local: Arc<dyn FunctionRunner<RT>>,
+    instance_name: String,
+    key_broker: KeyBroker,
+    convex_origin: ConvexOrigin,
+    callback_transport_url: Option<String>,
+    rt: RT,
+    instance_secret: DeploymentSecret,
+    endpoints_empty_since: watch::Receiver<Option<Instant>>,
+    snapshot_pins: Arc<SnapshotPins>,
+}
+
+enum AttemptFailure {
+    NotSent(anyhow::Error),
+    Rpc(tonic::Status),
+    TimedOut,
+    Internal(anyhow::Error),
+}
+
+impl AttemptFailure {
+    fn from_status(status: tonic::Status) -> Self {
+        let message = if is_connect_error(&status) {
+            "funrun connection failed before the request was sent"
+        } else if status.code() == tonic::Code::Unauthenticated
+            && status_error_metadata(&status).is_none()
+        {
+            "funrun rejected the request before decoding it"
+        } else {
+            return Self::Rpc(status);
+        };
+        Self::NotSent(
+            status_into_anyhow(status).context(ErrorMetadata::rejected_before_execution(
+                "FunrunConnectError",
+                message,
+            )),
+        )
+    }
+
+    fn retry_reason(&self, udf_type: UdfType) -> Option<&'static str> {
+        let has_deadline = has_deadline(udf_type);
+        match self {
+            Self::NotSent(_) => Some("not_sent"),
+            Self::TimedOut => has_deadline.then_some("timeout"),
+            Self::Rpc(status)
+                if status_error_metadata(status)
+                    .is_some_and(|metadata| metadata.is_rejected_before_execution()) =>
+            {
+                Some("rejected_before_execution")
+            },
+            Self::Rpc(status)
+                if has_deadline
+                    && matches!(
+                        status.code(),
+                        tonic::Code::Unavailable | tonic::Code::Cancelled | tonic::Code::Unknown
+                    ) =>
+            {
+                Some("transport")
+            },
+            Self::Rpc(_) | Self::Internal(_) => None,
+        }
+    }
+
+    fn into_error(self, rpc: &'static str) -> anyhow::Error {
+        match self {
+            Self::NotSent(e) | Self::Internal(e) => e,
+            Self::Rpc(status) => status_into_anyhow(status).context(rpc),
+            Self::TimedOut => anyhow::anyhow!("funrun response timed out").context(rpc),
+        }
+    }
+}
+
+fn has_deadline(udf_type: UdfType) -> bool {
+    matches!(udf_type, UdfType::Query | UdfType::Mutation | UdfType::Init)
+}
+
+fn retry_backoff(attempt: u32) -> Duration {
+    Duration::from_millis(50 * u64::from(attempt))
+}
