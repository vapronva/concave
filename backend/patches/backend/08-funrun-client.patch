+impl TryFrom<FunctionFinalTransaction> for pb::funrun::FunctionFinalTransaction {
+    type Error = anyhow::Error;
+
+    fn try_from(
+        FunctionFinalTransaction {
+            begin_timestamp,
+            reads,
+            writes,
+            rows_read_by_tablet,
+            uploaded_files,
+        }: FunctionFinalTransaction,
+    ) -> anyhow::Result<Self> {
+        let writes = writes
+            .updates
+            .into_iter()
+            .map(pb::common::PendingDocumentUpdate::try_from)
+            .collect::<anyhow::Result<Vec<_>>>()?;
+        let rows_read_by_tablet = rows_read_by_tablet
+            .into_iter()
+            .map(|(tablet_id, rows_read)| pb::funrun::RowsReadByTablet {
+                tablet_id: tablet_id.to_string(),
+                rows_read,
+            })
+            .collect();
+        let uploaded_files = uploaded_files
+            .into_iter()
+            .map(|(id, upload)| pb::funrun::UploadedFile {
+                id: Some(id.into()),
+                size: upload.size as u64,
+            })
+            .collect();
+        Ok(pb::funrun::FunctionFinalTransaction {
+            begin_timestamp: begin_timestamp.into(),
+            reads: Some(reads.into()),
+            writes,
+            rows_read_by_tablet,
+            uploaded_files,
+        })
+    }
+}
+
+impl TryFrom<pb::funrun::FunctionFinalTransaction> for FunctionFinalTransaction {
+    type Error = anyhow::Error;
+
+    fn try_from(
+        pb::funrun::FunctionFinalTransaction {
+            begin_timestamp,
+            reads,
+            writes,
+            rows_read_by_tablet,
+            uploaded_files,
+        }: pb::funrun::FunctionFinalTransaction,
+    ) -> anyhow::Result<Self> {
+        let uploaded_files = uploaded_files
+            .into_iter()
+            .map(|pb::funrun::UploadedFile { id, size }| {
+                let id: ResolvedDocumentId =
+                    id.context("Missing id in UploadedFile")?.try_into()?;
+                anyhow::Ok((
+                    id,
+                    UploadedFileUpload {
+                        size: size as usize,
+                    },
+                ))
+            })
+            .collect::<anyhow::Result<BTreeMap<_, _>>>()?;
+        let writes = writes
+            .into_iter()
+            .map(common::document::PendingDocumentUpdate::try_from)
+            .collect::<anyhow::Result<Vec<_>>>()?;
+        let rows_read_by_tablet = rows_read_by_tablet
+            .into_iter()
+            .map(
+                |pb::funrun::RowsReadByTablet {
+                     tablet_id,
+                     rows_read,
+                 }| { anyhow::Ok((TabletId::from_str(&tablet_id)?, rows_read)) },
+            )
+            .collect::<anyhow::Result<BTreeMap<_, _>>>()?;
+        Ok(FunctionFinalTransaction {
+            begin_timestamp: Timestamp::try_from(begin_timestamp)?,
+            reads: reads
+                .context("Missing reads in FunctionFinalTransaction")?
+                .try_into()?,
+            writes: FunctionWrites { updates: writes },
+            rows_read_by_tablet,
+            uploaded_files,
+        })
+    }
+}
+
+fn text_query_term_to_proto(term: TextQueryTerm) -> pb::funrun::TextQueryTerm {
+    let term = match term {
+        TextQueryTerm::Exact(token) => pb::funrun::text_query_term::Term::Exact(token),
+        TextQueryTerm::Prefix(token) => pb::funrun::text_query_term::Term::Prefix(token),
+    };
+    pb::funrun::TextQueryTerm { term: Some(term) }
+}
+
+fn text_query_term_from_proto(value: pb::funrun::TextQueryTerm) -> anyhow::Result<TextQueryTerm> {
+    Ok(
+        match value.term.context("Missing `term` in TextQueryTerm")? {
+            pb::funrun::text_query_term::Term::Exact(token) => TextQueryTerm::Exact(token),
+            pb::funrun::text_query_term::Term::Prefix(token) => TextQueryTerm::Prefix(token),
+        },
+    )
+}
+
+fn text_query_term_read_to_proto(read: TextQueryTermRead) -> pb::funrun::TextQueryTermRead {
+    pb::funrun::TextQueryTermRead {
+        field_path: Some(read.field_path.into()),
+        term: Some(text_query_term_to_proto(read.term)),
+    }
+}
+
+fn text_query_term_read_from_proto(
+    value: pb::funrun::TextQueryTermRead,
+) -> anyhow::Result<TextQueryTermRead> {
+    Ok(TextQueryTermRead {
+        field_path: value
+            .field_path
+            .context("Missing `field_path` in TextQueryTermRead")?
+            .try_into()?,
+        term: text_query_term_from_proto(
+            value.term.context("Missing `term` in TextQueryTermRead")?,
+        )?,
+    })
+}
+
+fn filter_condition_read_to_proto(read: FilterConditionRead) -> pb::funrun::FilterConditionRead {
+    let FilterConditionRead::Must(field_path, value) = read;
+    pb::funrun::FilterConditionRead {
+        field_path: Some(field_path.into()),
+        value: Vec::<u8>::from(value),
+    }
+}
+
+fn filter_condition_read_from_proto(
+    value: pb::funrun::FilterConditionRead,
+) -> anyhow::Result<FilterConditionRead> {
+    Ok(FilterConditionRead::Must(
+        value
+            .field_path
+            .context("Missing `field_path` in FilterConditionRead")?
+            .try_into()?,
+        FilterValue::from(value.value),
+    ))
+}
+
+fn query_reads_to_proto(
+    reads: SearchQueryReads,
+) -> (
+    Vec<pb::funrun::TextQueryTermRead>,
+    Vec<pb::funrun::FilterConditionRead>,
+) {
+    (
+        Vec::from(reads.text_queries)
+            .into_iter()
+            .map(text_query_term_read_to_proto)
+            .collect(),
+        Vec::from(reads.filter_conditions)
+            .into_iter()
+            .map(filter_condition_read_to_proto)
+            .collect(),
+    )
+}
+
+fn query_reads_from_proto(
+    text_queries: Vec<pb::funrun::TextQueryTermRead>,
+    filter_conditions: Vec<pb::funrun::FilterConditionRead>,
+) -> anyhow::Result<SearchQueryReads> {
+    let text_queries: Vec<TextQueryTermRead> = text_queries
+        .into_iter()
+        .map(text_query_term_read_from_proto)
+        .collect::<anyhow::Result<_>>()?;
+    let filter_conditions: Vec<FilterConditionRead> = filter_conditions
+        .into_iter()
+        .map(filter_condition_read_from_proto)
+        .collect::<anyhow::Result<_>>()?;
+    Ok(SearchQueryReads::new(
+        text_queries.into(),
+        filter_conditions.into(),
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use value::ConvexValue;
+
+    use super::*;
+
+    #[test]
+    fn query_reads_proto_roundtrip() {
+        let field = FieldPath::from_str("body").unwrap();
+        let filter_field = FieldPath::from_str("channel").unwrap();
+        let reads = SearchQueryReads::new(
+            vec![
+                TextQueryTermRead::new(field.clone(), TextQueryTerm::Exact("hello".to_string())),
+                TextQueryTermRead::new(field.clone(), TextQueryTerm::Prefix("wor".to_string())),
+            ]
+            .into(),
+            vec![FilterConditionRead::Must(
+                filter_field,
+                FilterValue::from_search_value(Some(&ConvexValue::from(7.0))),
+            )]
+            .into(),
+        );
+        let (text_queries, filter_conditions) = query_reads_to_proto(reads.clone());
+        assert_eq!(text_queries.len(), 2);
+        assert_eq!(filter_conditions.len(), 1);
+        let decoded = query_reads_from_proto(text_queries, filter_conditions).unwrap();
+        assert_eq!(reads, decoded);
+    }
+}
diff --git a/crates/function_runner/src/remote/snapshot_rpc.rs b/crates/function_runner/src/remote/snapshot_rpc.rs
new file mode 100644
index 000000000..f39f28a6f
--- /dev/null
+++ b/crates/function_runner/src/remote/snapshot_rpc.rs
@@ -0,0 +1,479 @@
+use std::{
+    collections::BTreeMap,
+    str::FromStr,
+    sync::{
+        Arc,
+        OnceLock,
+    },
+};
+
+use anyhow::Context;
+use common::{
+    document::DocumentUpdate,
+    index::IndexKeyBytes,
+    runtime::Runtime,
+    types::{
+        IndexId,
+        IndexName,
+        RepeatableTimestamp,
+    },
+};
+use database::{
+    Database,
+    Snapshot,
+    TextIndexManagerSnapshot,
+};
+use errors::ErrorMetadata;
+use metrics::{
+    log_counter,
+    register_convex_counter,
+};
+use parking_lot::Mutex;
+use pb::funrun::{
+    SnapshotError,
+    SnapshotTableCountsRequest,
+    SnapshotTableCountsResponse,
+    SnapshotTextSearchRequest,
+    SnapshotTextSearchResponse,
+    TabletCount,
+    TextSearchCandidate,
+};
+use search::{
+    query::RevisionWithKeys,
+    CandidateRevision,
+    Searcher,
+    TextSearchResults,
+};
+use storage::Storage;
+use sync_types::Timestamp;
+use value::TabletId;
+
+pub const TABLE_COUNTS_ROUTE: &str = "/funrun_table_counts";
+pub const TEXT_SEARCH_ROUTE: &str = "/funrun_text_search";
+
+register_convex_counter!(
+    FUNRUN_SNAPSHOT_PIN_MISS_TOTAL,
+    "Funrun snapshot RPCs served without a dispatch-time snapshot pin"
+);
+
+type SnapshotAt = Box<dyn Fn(RepeatableTimestamp) -> anyhow::Result<Snapshot> + Send + Sync>;
+
+pub(super) struct SnapshotPins {
+    snapshot_at: SnapshotAt,
+    searcher: Arc<dyn Searcher>,
+    search_storage: Arc<OnceLock<Arc<dyn Storage>>>,
+    pinned: Mutex<BTreeMap<Timestamp, (Snapshot, usize)>>,
+}
+
+pub(super) struct SnapshotPin {
+    pins: Arc<SnapshotPins>,
+    ts: Timestamp,
+}
+
+static SNAPSHOT_PINS: OnceLock<Arc<SnapshotPins>> = OnceLock::new();
+
+impl SnapshotPins {
+    pub(super) fn install<RT: Runtime>(database: &Database<RT>) -> Arc<Self> {
+        let searcher = database.searcher.clone();
+        let search_storage = database.search_storage.clone();
+        let database = database.clone();
+        SNAPSHOT_PINS
+            .get_or_init(|| {
+                Arc::new(Self {
+                    snapshot_at: Box::new(move |ts| database.snapshot(ts)),
+                    searcher,
+                    search_storage,
+                    pinned: Mutex::new(BTreeMap::new()),
+                })
+            })
+            .clone()
+    }
+
+    pub(super) fn pin(self: &Arc<Self>, ts: RepeatableTimestamp) -> Option<SnapshotPin> {
+        let retained = self
+            .pinned
+            .lock()
+            .get_mut(&*ts)
+            .map(|(_, count)| *count += 1)
+            .is_some();
+        if !retained {
+            let snapshot = (self.snapshot_at)(ts).ok()?;
+            self.pinned.lock().entry(*ts).or_insert((snapshot, 0)).1 += 1;
+        }
+        Some(SnapshotPin {
+            pins: self.clone(),
+            ts: *ts,
+        })
+    }
+
+    fn snapshot(&self, ts: RepeatableTimestamp) -> anyhow::Result<Snapshot> {
+        let pinned = self
+            .pinned
+            .lock()
+            .get(&*ts)
+            .map(|(snapshot, _)| snapshot.clone());
+        if let Some(snapshot) = pinned {
+            return Ok(snapshot);
+        }
+        log_counter(&FUNRUN_SNAPSHOT_PIN_MISS_TOTAL, 1);
+        (self.snapshot_at)(ts)
+    }
+}
+
+impl Drop for SnapshotPin {
+    fn drop(&mut self) {
+        let released = {
+            let mut pinned = self.pins.pinned.lock();
+            let Some((_, count)) = pinned.get_mut(&self.ts) else {
+                return;
+            };
+            *count -= 1;
+            if *count == 0 {
+                pinned.remove(&self.ts)
+            } else {
+                None
+            }
+        };
+        drop(released);
+    }
+}
+
+fn installed_pins() -> anyhow::Result<&'static Arc<SnapshotPins>> {
+    SNAPSHOT_PINS
+        .get()
+        .context("funrun snapshot routes need CONVEX_FUNRUN_ADDR on this backend")
+}
+
+fn snapshot_error(error: anyhow::Error) -> SnapshotError {
+    SnapshotError {
+        message: format!("{error:#}"),
+        metadata: error
+            .downcast_ref::<ErrorMetadata>()
+            .cloned()
+            .map(Into::into),
+    }
+}
+
+fn leader_error(SnapshotError { message, metadata }: SnapshotError) -> anyhow::Error {
+    let error = anyhow::anyhow!("leader snapshot RPC failed: {message}");
+    match metadata.and_then(|metadata| ErrorMetadata::try_from(metadata).ok()) {
+        Some(metadata) if !metadata.is_rejected_before_execution() => error.context(metadata),
+        _ => error,
+    }
+}
+
+pub fn serve_table_counts(request: SnapshotTableCountsRequest) -> SnapshotTableCountsResponse {
+    let counts = request
+        .ts
+        .context("missing ts")
+        .and_then(RepeatableTimestamp::try_from)
+        .and_then(|ts| installed_pins()?.snapshot(ts));
+    match counts {
+        Ok(snapshot) => table_counts_response(snapshot.table_counts.map(|counts| {
+            counts
+                .tables
+                .iter()
+                .map(|(tablet_id, count)| (*tablet_id, count.num_values()))
+                .collect()
+        })),
+        Err(error) => SnapshotTableCountsResponse {
+            available: false,
+            tablets: vec![],
+            error: Some(snapshot_error(error)),
+        },
+    }
+}
+
+fn table_counts_response(counts: Option<BTreeMap<TabletId, u64>>) -> SnapshotTableCountsResponse {
+    SnapshotTableCountsResponse {
+        available: counts.is_some(),
+        tablets: counts
+            .into_iter()
+            .flatten()
+            .map(|(tablet_id, count)| TabletCount {
+                tablet_id: tablet_id.to_string(),
+                count,
+            })
+            .collect(),
+        error: None,
+    }
+}
+
+pub fn table_counts(
+    response: SnapshotTableCountsResponse,
+) -> anyhow::Result<Option<BTreeMap<TabletId, u64>>> {
+    let SnapshotTableCountsResponse {
+        available,
+        tablets,
+        error,
+    } = response;
+    if let Some(error) = error {
+        return Err(leader_error(error));
+    }
+    if !available {
+        return Ok(None);
+    }
+    tablets
+        .into_iter()
+        .map(|TabletCount { tablet_id, count }| {
+            anyhow::Ok((TabletId::from_str(&tablet_id)?, count))
+        })
+        .collect::<anyhow::Result<_>>()
+        .map(Some)
+}
+
+struct TextSearchRequest {
+    ts: RepeatableTimestamp,
+    index_id: IndexId,
+    printable_index_name: IndexName,
+    query: pb::searchlight::TextQuery,
+    pending_updates: Vec<DocumentUpdate>,
+}
+
+pub fn text_search_request(
+    ts: RepeatableTimestamp,
+    index_id: IndexId,
+    printable_index_name: &IndexName,
+    query: pb::searchlight::TextQuery,
+    pending_updates: &[DocumentUpdate],
+) -> anyhow::Result<SnapshotTextSearchRequest> {
+    Ok(SnapshotTextSearchRequest {
+        ts: Some(ts.into()),
+        index_id: String::from(index_id),
+        printable_index_name: printable_index_name.to_string(),
+        query: Some(query),
+        pending_updates: pending_updates
+            .iter()
+            .cloned()
+            .map(pb::common::DocumentUpdate::try_from)
+            .collect::<anyhow::Result<_>>()?,
+    })
+}
+
+fn decode_text_search_request(
+    request: SnapshotTextSearchRequest,
+) -> anyhow::Result<TextSearchRequest> {
+    let SnapshotTextSearchRequest {
+        ts,
+        index_id,
+        printable_index_name,
+        query,
+        pending_updates,
+    } = request;
+    Ok(TextSearchRequest {
+        ts: ts.context("missing ts")?.try_into()?,
+        index_id: IndexId::from_str(&index_id)?,
+        printable_index_name: printable_index_name.parse()?,
+        query: query.context("missing query")?,
+        pending_updates: pending_updates
+            .into_iter()
+            .map(DocumentUpdate::try_from)
+            .collect::<anyhow::Result<_>>()?,
+    })
+}
+
+pub async fn serve_text_search(request: SnapshotTextSearchRequest) -> SnapshotTextSearchResponse {
+    match text_search_at(request).await {
+        Ok(results) => text_search_response(results),
+        Err(error) => SnapshotTextSearchResponse {
+            candidates: vec![],
+            filtered_bytes_searched: 0,
+            error: Some(snapshot_error(error)),
+        },
+    }
+}
+
+async fn text_search_at(request: SnapshotTextSearchRequest) -> anyhow::Result<TextSearchResults> {
+    let TextSearchRequest {
+        ts,
+        index_id,
+        printable_index_name,
+        query,
+        pending_updates,
+    } = decode_text_search_request(request)?;
+    let pins = installed_pins()?;
+    let snapshot = pins.snapshot(ts)?;
+    let index = snapshot
+        .index_registry
+        .enabled_index_by_index_id(&index_id)
+        .with_context(|| format!("Missing index_id {index_id:?}"))?
+        .clone();
+    TextIndexManagerSnapshot::new(
+        snapshot.index_registry,
+        snapshot.text_indexes,
+        pins.searcher.clone(),
+        pins.search_storage.clone(),
+    )
+    .text_search(&index, &printable_index_name, query, &pending_updates)
+    .await
+}
+
+fn text_search_response(results: TextSearchResults) -> SnapshotTextSearchResponse {
+    SnapshotTextSearchResponse {
+        candidates: results
+            .revisions_with_keys
+            .into_iter()
+            .map(|(revision, index_key)| TextSearchCandidate {
+                revision: Some(revision.into()),
+                index_key: index_key.0,
+            })
+            .collect(),
+        filtered_bytes_searched: results.filtered_bytes_searched,
+        error: None,
+    }
+}
+
+pub fn text_search_results(
+    response: SnapshotTextSearchResponse,
+) -> anyhow::Result<(RevisionWithKeys, u64)> {
+    let SnapshotTextSearchResponse {
+        candidates,
+        filtered_bytes_searched,
+        error,
+    } = response;
+    if let Some(error) = error {
+        return Err(leader_error(error));
+    }
+    let revisions_with_keys = candidates
+        .into_iter()
+        .map(
+            |TextSearchCandidate {
+                 revision,
+                 index_key,
+             }| {
+                anyhow::Ok((
+                    CandidateRevision::try_from(revision.context("candidate missing revision")?)?,
+                    IndexKeyBytes(index_key),
+                ))
+            },
+        )
+        .collect::<anyhow::Result<_>>()?;
+    Ok((revisions_with_keys, filtered_bytes_searched))
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::BTreeMap;
+
+    use common::{
+        document::{
+            CreationTime,
+            DocumentUpdate,
+            ResolvedDocument,
+        },
+        index::IndexKeyBytes,
+        types::{
+            IndexId,
+            IndexName,
+            RepeatableTimestamp,
+            WriteTimestamp,
+        },
+    };
+    use errors::{
+        ErrorMetadata,
+        ErrorMetadataAnyhowExt,
+    };
+    use search::{
+        CandidateRevision,
+        TextSearchResults,
+    };
+    use sync_types::Timestamp;
+    use value::{
+        InternalId,
+        ResolvedDocumentId,
+        TabletId,
+    };
+
+    use super::*;
+
+    fn with_error(error: anyhow::Error) -> SnapshotTableCountsResponse {
+        SnapshotTableCountsResponse {
+            available: false,
+            tablets: vec![],
+            error: Some(snapshot_error(error)),
+        }
+    }
+
+    #[test]
+    fn table_counts_cross_the_wire() {
+        let counts = BTreeMap::from([(TabletId::MIN, 7)]);
+        assert_eq!(
+            table_counts(table_counts_response(Some(counts.clone()))).unwrap(),
+            Some(counts)
+        );
+        assert_eq!(table_counts(table_counts_response(None)).unwrap(), None);
+        let rejected = table_counts(with_error(
+            ErrorMetadata::rejected_before_execution("LeaderBusy", "busy").into(),
+        ))
+        .unwrap_err();
+        assert!(rejected.downcast_ref::<ErrorMetadata>().is_none());
+        let expired =
+            table_counts(with_error(ErrorMetadata::out_of_retention().into())).unwrap_err();
+        assert!(expired.is_out_of_retention());
+    }
+
+    #[test]
+    fn text_search_crosses_the_wire() -> anyhow::Result<()> {
+        let document = ResolvedDocument::new(
+            ResolvedDocumentId::MIN,
+            CreationTime::try_from(1.0)?,
+            value::obj!("body" => "hello world")?,
+        )?;
+        let pending_updates = vec![DocumentUpdate {
+            id: ResolvedDocumentId::MIN,
+            old_document: None,
+            new_document: Some(document),
+        }];
+        let printable_index_name: IndexName = "messages.search_body".parse()?;
+        let query = pb::searchlight::TextQuery {
+            search_terms: vec![pb::searchlight::TextQueryTerm {
+                term_type: Some(pb::searchlight::text_query_term::TermType::Prefix(
+                    pb::searchlight::PrefixTextTerm {
+                        token: "hel".to_string(),
+                    },
+                )),
+            }],
+            filter_conditions: vec![vec![1, 2, 3]],
+        };
+        let index_id = IndexId(InternalId::MIN);
+        let request = text_search_request(
+            RepeatableTimestamp::MIN,
+            index_id,
+            &printable_index_name,
+            query.clone(),
+            &pending_updates,
+        )?;
+        let decoded = decode_text_search_request(request)?;
+        assert_eq!(decoded.ts, RepeatableTimestamp::MIN);
+        assert_eq!(decoded.index_id, index_id);
+        assert_eq!(decoded.printable_index_name, printable_index_name);
+        assert_eq!(decoded.query, query);
+        assert_eq!(decoded.pending_updates, pending_updates);
+        let revisions_with_keys = vec![
+            (
+                CandidateRevision {
+                    score: 1.5,
+                    id: InternalId::MIN,
+                    ts: WriteTimestamp::Committed(Timestamp::try_from(9u64)?),
+                    creation_time: CreationTime::try_from(1.0)?,
+                },
+                IndexKeyBytes(vec![1]),
+            ),
+            (
+                CandidateRevision {
+                    score: 0.5,
+                    id: InternalId::MIN,
+                    ts: WriteTimestamp::Pending,
+                    creation_time: CreationTime::try_from(2.0)?,
+                },
+                IndexKeyBytes(vec![2]),
+            ),
+        ];
+        let response = text_search_response(TextSearchResults {
+            revisions_with_keys: revisions_with_keys.clone(),
+            filtered_bytes_searched: 42,
+        });
+        assert_eq!(text_search_results(response)?, (revisions_with_keys, 42));
+        Ok(())
+    }
+}
