+impl<RT: Runtime> RemoteFunctionRunner<RT> {
+    pub fn new(
+        funrun_addr: String,
+        instance_name: String,
+        key_broker: KeyBroker,
+        instance_secret: DeploymentSecret,
+        convex_origin: ConvexOrigin,
+        rt: RT,
+        local: Arc<dyn FunctionRunner<RT>>,
+        database: database::Database<RT>,
+    ) -> anyhow::Result<Self> {
+        let (host, port) = parse_funrun_target(&funrun_addr)?;
+        let (endpoints_tx, endpoints_empty_since) = watch::channel(Some(Instant::now()));
+        let (channel, tx) = Channel::balance_channel::<SocketAddr>(64);
+        spawn_endpoint_refresher(&rt, host, port, tx, endpoints_tx);
+        let callback_transport_url = std::env::var("CONVEX_FUNRUN_CALLBACK_URL")
+            .ok()
+            .filter(|v| !v.is_empty());
+        if let Some(url) = &callback_transport_url {
+            tracing::info!("[funrun] action callbacks will use transport URL {url}");
+        } else {
+            tracing::info!("[funrun] action callbacks use the public origin");
+        }
+        Ok(Self {
+            channel,
+            local,
+            instance_name,
+            key_broker,
+            convex_origin,
+            callback_transport_url,
+            rt,
+            instance_secret,
+            endpoints_empty_since,
+            snapshot_pins: SnapshotPins::install(&database),
+        })
+    }
+
+    fn auth_header(&self) -> String {
+        let unix_seconds = self.rt.unix_timestamp().as_secs();
+        funrun_auth_header(&self.instance_secret, &self.instance_name, unix_seconds)
+    }
+
+    fn authenticated_request<T>(&self, message: T) -> Result<tonic::Request<T>, AttemptFailure> {
+        let mut request = tonic::Request::new(message);
+        let header = self
+            .auth_header()
+            .parse()
+            .context("invalid funrun auth header")
+            .map_err(AttemptFailure::Internal)?;
+        request
+            .metadata_mut()
+            .insert(FUNRUN_AUTH_METADATA_KEY, header);
+        Ok(request)
+    }
+
+    fn client(&self) -> pb::funrun::funrun_client::FunrunClient<Channel> {
+        pb::funrun::funrun_client::FunrunClient::new(self.channel.clone())
+            .max_decoding_message_size(usize::MAX)
+    }
+
+    async fn wait_for_endpoints(&self) -> Result<(), AttemptFailure> {
+        let mut endpoints = self.endpoints_empty_since.clone();
+        let Some(empty_since) = *endpoints.borrow_and_update() else {
+            return Ok(());
+        };
+        let remaining = FUNRUN_EMPTY_ENDPOINTS_FAIL_FAST.saturating_sub(empty_since.elapsed());
+        match timeout(remaining, endpoints.wait_for(Option::is_none)).await {
+            Ok(Ok(_)) => Ok(()),
+            _ => Err(AttemptFailure::NotSent(anyhow::anyhow!(
+                ErrorMetadata::rejected_before_execution(
+                    "FunrunUnavailable",
+                    format!(
+                        "funrun DNS has no endpoints after {FUNRUN_EMPTY_ENDPOINTS_FAIL_FAST:?}; \
+                         check the funrun Service"
+                    ),
+                )
+            ))),
+        }
+    }
+
+    async fn run_function_attempt(
+        &self,
+        udf_type: UdfType,
+        request: &pb::funrun::RunFunctionRequest,
+        log_line_sender: &Option<mpsc::UnboundedSender<LogLine>>,
+        parts_received: &mut bool,
+    ) -> Result<pb::funrun::RunFunctionResult, AttemptFailure> {
+        self.wait_for_endpoints().await?;
+        let req = self.authenticated_request(request.clone())?;
+        let call = self.stream_run_function(req, log_line_sender, parts_received);
+        if has_deadline(udf_type) {
+            timeout(FUNRUN_RESPONSE_TIMEOUT, call)
+                .await
+                .map_err(|_| AttemptFailure::TimedOut)?
+        } else {
+            call.await
+        }
+    }
+
+    async fn stream_run_function(
+        &self,
+        req: tonic::Request<pb::funrun::RunFunctionRequest>,
+        log_line_sender: &Option<mpsc::UnboundedSender<LogLine>>,
+        parts_received: &mut bool,
+    ) -> Result<pb::funrun::RunFunctionResult, AttemptFailure> {
+        let mut stream = timeout(FUNRUN_RESPONSE_TIMEOUT, self.client().run_function(req))
+            .await
+            .map_err(|_| AttemptFailure::TimedOut)?
+            .map_err(AttemptFailure::from_status)?
+            .into_inner();
+        let mut result = None;
+        while let Some(part) = stream
+            .message()
+            .await
+            .map_err(AttemptFailure::from_status)?
+        {
+            *parts_received = true;
+            match part.part {
+                Some(pb::funrun::run_function_response_part::Part::LogLine(log_line)) => {
+                    let log_line = LogLine::try_from(log_line).map_err(AttemptFailure::Internal)?;
+                    if let Some(sender) = log_line_sender {
+                        let _ = sender.send(log_line);
+                    }
+                },
+                Some(pb::funrun::run_function_response_part::Part::Result(r)) => {
+                    if result.is_some() {
+                        return Err(AttemptFailure::Internal(anyhow::anyhow!(
+                            "funrun sent more than one terminal result"
+                        )));
+                    }
+                    result = Some(r);
+                },
+                None => {
+                    return Err(AttemptFailure::Internal(anyhow::anyhow!(
+                        "funrun sent an empty RunFunctionResponsePart"
+                    )));
+                },
+            }
+        }
+        result.ok_or_else(|| {
+            AttemptFailure::Internal(anyhow::anyhow!(
+                "funrun stream ended without a terminal result"
+            ))
+        })
+    }
+
+    fn run_function_request(
+        &self,
+        udf_type: UdfType,
+        identity: Identity,
+        ts: RepeatableTimestamp,
+        existing_writes: FunctionWrites,
+        function_metadata: Option<FunctionMetadata>,
+        default_system_env_vars: BTreeMap<EnvVarName, EnvVarValue>,
+        in_memory_index_last_modified: BTreeMap<IndexId, Timestamp>,
+        context: ExecutionContext,
+    ) -> anyhow::Result<pb::funrun::RunFunctionRequest> {
+        let component = function_metadata
+            .as_ref()
+            .map(|m| m.path_and_args.path().component)
+            .unwrap_or(common::components::ComponentId::Root);
+        let auth_header = token_to_authorization_header(identity.clone().into())?;
+        let callback_token = self
+            .key_broker
+            .issue_action_token_at(component, callback_token_issued_at(&identity));
+        let existing_writes = existing_writes
+            .updates
+            .into_iter()
+            .map(pb::common::PendingDocumentUpdate::try_from)
+            .collect::<anyhow::Result<Vec<_>>>()?;
+        let (path_and_args, journal) = match function_metadata {
+            Some(FunctionMetadata {
+                path_and_args,
+                journal,
+            }) => (
+                Some(pb::common::ValidatedPathAndArgs::try_from(path_and_args)?),
+                Some(journal.into()),
+            ),
+            None => (None, None),
+        };
+        Ok(pb::funrun::RunFunctionRequest {
+            instance_name: self.instance_name.clone(),
+            udf_type: pb::common::UdfType::from(udf_type) as i32,
+            identity: Some(identity.try_into()?),
+            ts: Some(ts.into()),
+            existing_writes,
+            path_and_args,
+            journal,
+            default_system_env_vars: default_system_env_vars
+                .into_iter()
+                .map(|(name, value)| pb::funrun::EnvVar {
+                    name: name.to_string(),
+                    value: String::from(value),
+                })
+                .collect(),
+            in_memory_index_last_modified: in_memory_index_last_modified
+                .into_iter()
+                .map(|(index_id, ts)| pb::funrun::IndexLastModified {
+                    index_id: String::from(index_id),
+                    last_modified_ts: ts.into(),
+                })
+                .collect(),
+            context: Some(context.into()),
+            backend_callback_url: Some(self.convex_origin.to_string()),
+            callback_transport_url: self.callback_transport_url.clone(),
+            callback_token: Some(callback_token),
+            auth_header,
+        })
+    }
+
+    async fn run_function_remote(
+        &self,
+        udf_type: UdfType,
+        identity: Identity,
+        ts: RepeatableTimestamp,
+        existing_writes: FunctionWrites,
+        log_line_sender: Option<mpsc::UnboundedSender<LogLine>>,
+        function_metadata: Option<FunctionMetadata>,
+        default_system_env_vars: BTreeMap<EnvVarName, EnvVarValue>,
+        in_memory_index_last_modified: BTreeMap<IndexId, Timestamp>,
+        context: ExecutionContext,
+    ) -> anyhow::Result<(
+        Option<FunctionFinalTransaction>,
+        FunctionOutcome,
+        FunctionUsageStats,
+    )> {
+        let inert_identity: InertIdentity = identity.clone().into();
+        let path_and_args = function_metadata.as_ref().map(|m| m.path_and_args.clone());
+        let request = self.run_function_request(
+            udf_type,
+            identity,
+            ts,
+            existing_writes,
+            function_metadata,
+            default_system_env_vars,
+            in_memory_index_last_modified,
+            context,
+        )?;
+        let _pin = has_deadline(udf_type)
+            .then(|| self.snapshot_pins.pin(ts))
+            .flatten();
+        let mut attempt: u32 = 1;
+        let mut not_sent: u32 = 0;
+        let result = loop {
+            let mut parts_received = false;
+            let failure = match self
+                .run_function_attempt(udf_type, &request, &log_line_sender, &mut parts_received)
+                .await
+            {
+                Ok(result) => break result,
+                Err(failure) => failure,
+            };
+            match failure.retry_reason(udf_type) {
+                Some(reason @ "not_sent") if not_sent < FUNRUN_MAX_NOT_SENT_RETRIES => {
+                    log_funrun_client_retry(reason);
+                    self.rt.wait(retry_backoff(1)).await;
+                    not_sent += 1;
+                },
+                Some(reason) if attempt < FUNRUN_MAX_ATTEMPTS && !parts_received => {
+                    log_funrun_client_retry(reason);
+                    self.rt.wait(retry_backoff(attempt)).await;
+                    attempt += 1;
+                },
+                _ => return Err(failure.into_error("funrun RunFunction failed")),
+            }
+        };
+        let pb::funrun::RunFunctionResult {
+            outcome,
+            final_transaction,
+            usage_stats,
+        } = result;
+        let outcome = FunctionOutcome::from_proto(
+            outcome.context("funrun response missing outcome")?,
+            path_and_args,
+            None,
+            inert_identity,
+        )?;
+        let final_transaction = final_transaction
+            .map(FunctionFinalTransaction::try_from)
+            .transpose()?;
+        let usage_stats = usage_stats
+            .map(FunctionUsageStats::try_from)
+            .transpose()?
+            .unwrap_or_default();
+        Ok((final_transaction, outcome, usage_stats))
+    }
+
+    async fn http_action_attempt(
+        &self,
+        request: pb::funrun::RunHttpActionRequest,
+    ) -> Result<
+        (
+            tonic::Streaming<pb::funrun::HttpActionResponsePart>,
+            Option<pb::funrun::HttpActionResponsePart>,
+        ),
+        AttemptFailure,
+    > {
+        self.wait_for_endpoints().await?;
+        let req = self.authenticated_request(request)?;
+        let mut stream = timeout(FUNRUN_RESPONSE_TIMEOUT, self.client().run_http_action(req))
+            .await
+            .map_err(|_| AttemptFailure::TimedOut)?
+            .map_err(AttemptFailure::from_status)?
+            .into_inner();
+        let first = stream
+            .message()
+            .await
+            .map_err(AttemptFailure::from_status)?;
+        Ok((stream, first))
+    }
+
+    async fn open_http_action(
+        &self,
+        mut request: pb::funrun::RunHttpActionRequest,
+    ) -> anyhow::Result<(
+        tonic::Streaming<pb::funrun::HttpActionResponsePart>,
+        Option<pb::funrun::HttpActionResponsePart>,
+    )> {
+        let mut attempt: u32 = 1;
+        let mut not_sent: u32 = 0;
+        loop {
+            let last_attempt =
+                attempt >= FUNRUN_MAX_ATTEMPTS && not_sent >= FUNRUN_MAX_NOT_SENT_RETRIES;
+            let message = if last_attempt {
+                std::mem::take(&mut request)
+            } else {
+                request.clone()
+            };
+            let failure = match self.http_action_attempt(message).await {
+                Ok(opened) => return Ok(opened),
+                Err(failure) => failure,
+            };
+            match failure.retry_reason(UdfType::HttpAction) {
+                Some(reason @ "not_sent") if not_sent < FUNRUN_MAX_NOT_SENT_RETRIES => {
+                    log_funrun_client_retry(reason);
+                    self.rt.wait(retry_backoff(1)).await;
+                    not_sent += 1;
+                },
+                Some(reason) if attempt < FUNRUN_MAX_ATTEMPTS => {
+                    log_funrun_client_retry(reason);
+                    self.rt.wait(retry_backoff(attempt)).await;
+                    attempt += 1;
+                },
+                _ => return Err(failure.into_error("funrun RunHttpAction failed")),
+            }
+        }
+    }
+
+    async fn run_http_action_remote(
+        &self,
+        identity: Identity,
+        ts: RepeatableTimestamp,
+        existing_writes: FunctionWrites,
+        log_line_sender: Option<mpsc::UnboundedSender<LogLine>>,
+        http_action_metadata: HttpActionMetadata,
+        default_system_env_vars: BTreeMap<EnvVarName, EnvVarValue>,
+        in_memory_index_last_modified: BTreeMap<IndexId, Timestamp>,
+        context: ExecutionContext,
+    ) -> anyhow::Result<(
+        Option<FunctionFinalTransaction>,
+        FunctionOutcome,
+        FunctionUsageStats,
+    )> {
+        let HttpActionMetadata {
+            mut http_response_streamer,
+            http_module_path,
+            routed_path,
+            http_request,
+        } = http_action_metadata;
+        let request_head = http_request.head;
+        let http_path_for_outcome = http_module_path.clone();
+        let component = http_module_path.path().component;
+        let inert_identity: InertIdentity =
+            propagate_component_auth(&identity, component, component.is_root()).into();
+        let auth_header = token_to_authorization_header(identity.clone().into())?;
+        let callback_token = self
+            .key_broker
+            .issue_action_token_at(component, callback_token_issued_at(&identity));
+        let http_request_head = request_head.clone().into();
+        let http_body = http_request.body;
+        let dispatch = async move {
+            self.wait_for_endpoints()
+                .await
+                .map_err(|failure| failure.into_error("funrun RunHttpAction failed"))?;
+            let http_request_body = match http_body {
+                Some(mut body) => {
+                    let mut buf = Vec::new();
+                    while let Some(chunk) = body.next().await {
+                        buf.extend_from_slice(&chunk?);
+                    }
+                    Some(buf)
+                },
+                None => None,
+            };
+            let existing_writes = existing_writes
+                .updates
+                .into_iter()
+                .map(pb::common::PendingDocumentUpdate::try_from)
+                .collect::<anyhow::Result<Vec<_>>>()?;
+            let request = pb::funrun::RunHttpActionRequest {
+                instance_name: self.instance_name.clone(),
+                identity: Some(identity.try_into()?),
+                ts: Some(ts.into()),
+                existing_writes,
+                default_system_env_vars: default_system_env_vars
+                    .into_iter()
+                    .map(|(name, value)| pb::funrun::EnvVar {
+                        name: name.to_string(),
+                        value: String::from(value),
+                    })
+                    .collect(),
+                in_memory_index_last_modified: in_memory_index_last_modified
+                    .into_iter()
+                    .map(|(index_id, ts)| pb::funrun::IndexLastModified {
+                        index_id: String::from(index_id),
+                        last_modified_ts: ts.into(),
+                    })
+                    .collect(),
+                context: Some(context.into()),
+                backend_callback_url: Some(self.convex_origin.to_string()),
+                callback_transport_url: self.callback_transport_url.clone(),
+                callback_token: Some(callback_token),
+                auth_header,
+                http_module_path: Some(http_module_path.try_into()?),
+                routed_path: routed_path.0,
+                http_request_head: Some(http_request_head),
+                http_request_body,
+            };
+            self.open_http_action(request).await
+        }
+        .fuse();
+        futures::pin_mut!(dispatch);
+        let (mut stream, first) = select_biased! {
+            _ = http_response_streamer.sender.closed().fuse() => {
+                anyhow::bail!(ErrorMetadata::client_disconnect());
+            },
+            opened = dispatch => opened?,
+        };
+        let mut result: Option<pb::funrun::RunFunctionResult> = None;
+        if let Some(part) = first {
+            forward_http_action_part(
+                part,
+                &mut result,
+                &log_line_sender,
+                &mut http_response_streamer,
+            )?;
+            loop {
+                let message = stream.message().fuse();
+                futures::pin_mut!(message);
+                let part = select_biased! {
+                    _ = http_response_streamer.sender.closed().fuse() => {
+                        anyhow::bail!(ErrorMetadata::client_disconnect());
+                    },
+                    part = message => part
+                        .map_err(status_into_anyhow)
+                        .context("funrun RunHttpAction stream error")?,
+                };
+                let Some(part) = part else {
+                    break;
+                };
+                forward_http_action_part(
+                    part,
+                    &mut result,
+                    &log_line_sender,
+                    &mut http_response_streamer,
+                )?;
+            }
+        }
+        let pb::funrun::RunFunctionResult {
+            outcome,
+            final_transaction: _,
+            usage_stats,
+        } = result.context("funrun HttpAction stream ended without a terminal result")?;
+        let outcome = FunctionOutcome::from_proto(
+            outcome.context("funrun response missing outcome")?,
+            None,
+            Some((http_path_for_outcome, request_head)),
+            inert_identity,
+        )?;
+        let usage_stats = usage_stats
+            .map(FunctionUsageStats::try_from)
+            .transpose()?
+            .unwrap_or_default();
+        Ok((None, outcome, usage_stats))
+    }
+}
+
+fn forward_http_action_part(
+    part: pb::funrun::HttpActionResponsePart,
+    result: &mut Option<pb::funrun::RunFunctionResult>,
+    log_line_sender: &Option<mpsc::UnboundedSender<LogLine>>,
+    http_response_streamer: &mut HttpActionResponseStreamer,
+) -> anyhow::Result<()> {
+    match part.part {
+        Some(pb::funrun::http_action_response_part::Part::LogLine(log_line)) => {
+            let log_line = LogLine::try_from(log_line)?;
+            if let Some(sender) = log_line_sender {
+                let _ = sender.send(log_line);
+            }
+        },
+        Some(pb::funrun::http_action_response_part::Part::Response(response)) => {
+            let part = http_action_response_part_from_proto(response)?;
+            if http_response_streamer.send_part(part)?.is_err() {
+                anyhow::bail!(ErrorMetadata::client_disconnect());
+            }
+        },
+        Some(pb::funrun::http_action_response_part::Part::Result(r)) => {
+            anyhow::ensure!(
+                result.is_none(),
+                "funrun sent more than one terminal result"
+            );
+            *result = Some(r);
+        },
+        None => anyhow::bail!("funrun sent an empty HttpActionResponsePart"),
+    }
+    Ok(())
+}
+
+fn http_action_response_part_from_proto(
+    response: pb::common::HttpActionResponse,
+) -> anyhow::Result<udf::HttpActionResponsePart> {
+    use pb::common::http_action_response::MessageType;
+    let message_type = response
+        .message_type
+        .context("HttpActionResponse missing message_type")?;
+    Ok(match message_type {
+        MessageType::Head(head) => {
+            udf::HttpActionResponsePart::Head(udf::HttpActionResponseHead::try_from(head)?)
+        },
+        MessageType::Body(bytes) => udf::HttpActionResponsePart::BodyChunk(bytes.into()),
+    })
+}
