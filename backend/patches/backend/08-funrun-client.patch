+#[cfg(test)]
+mod tests {
+    use errors::ErrorMetadata;
+    use pb::error_metadata::ErrorMetadataStatusExt;
+    use tonic::transport::Endpoint;
+
+    use super::{
+        AttemptFailure,
+        UdfType,
+    };
+
+    const ALL: [UdfType; 5] = [
+        UdfType::Query,
+        UdfType::Mutation,
+        UdfType::Init,
+        UdfType::Action,
+        UdfType::HttpAction,
+    ];
+
+    fn reasons(failure: &AttemptFailure) -> Vec<Option<&'static str>> {
+        ALL.iter().map(|t| failure.retry_reason(*t)).collect()
+    }
+
+    #[tokio::test]
+    async fn refused_connection_is_not_sent_for_every_udf_type() {
+        let channel = Endpoint::from_static("http://127.0.0.1:1").connect_lazy();
+        let status = pb::funrun::funrun_client::FunrunClient::new(channel)
+            .run_function(pb::funrun::RunFunctionRequest::default())
+            .await
+            .unwrap_err();
+        let failure = AttemptFailure::from_status(status);
+        assert!(matches!(failure, AttemptFailure::NotSent(_)));
+        assert_eq!(reasons(&failure), vec![Some("not_sent"); 5]);
+        let error = failure.into_error("funrun RunFunction failed");
+        assert!(error
+            .downcast_ref::<ErrorMetadata>()
+            .is_some_and(|metadata| metadata.is_rejected_before_execution()));
+    }
+
+    #[test]
+    fn mid_flight_failures_keep_at_most_once_for_actions() {
+        let transport = AttemptFailure::from_status(tonic::Status::unavailable("reset"));
+        let deadline = Some("transport");
+        assert_eq!(
+            reasons(&transport),
+            vec![deadline, deadline, deadline, None, None]
+        );
+        let rejected = AttemptFailure::from_status(tonic::Status::from_anyhow(
+            ErrorMetadata::rejected_before_execution("ExpiredInQueue", "queue full").into(),
+        ));
+        assert_eq!(
+            reasons(&rejected),
+            vec![Some("rejected_before_execution"); 5]
+        );
+        let internal = AttemptFailure::from_status(tonic::Status::internal("boom"));
+        assert_eq!(reasons(&internal), vec![None; 5]);
+        let timeout = Some("timeout");
+        assert_eq!(
+            reasons(&AttemptFailure::TimedOut),
+            vec![timeout, timeout, timeout, None, None]
+        );
+    }
+}
