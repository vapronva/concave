+fn callback_token_issued_at(identity: &Identity) -> SystemTime {
+    let now = SystemTime::now();
+    match identity {
+        Identity::User(user) => user
+            .expiration
+            .checked_sub(Duration::from_secs(1))
+            .map_or(now, |last_valid| now.min(last_valid)),
+        _ => now,
+    }
+}
