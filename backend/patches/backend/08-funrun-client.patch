+fn parse_funrun_target(addr: &str) -> anyhow::Result<(String, u16)> {
+    anyhow::ensure!(
+        !addr.starts_with("https://"),
+        "CONVEX_FUNRUN_ADDR is plaintext (http:// or host:port); the funrun hop has no TLS: {addr}"
+    );
+    let rest = addr
+        .strip_prefix("http://")
+        .unwrap_or(addr)
+        .trim_end_matches('/');
+    let (host, port) = if let Some(bracketed) = rest.strip_prefix('[') {
+        let (host, after) = bracketed
+            .split_once(']')
+            .with_context(|| format!("unclosed IPv6 bracket in {addr}"))?;
+        let port = after
+            .strip_prefix(':')
+            .with_context(|| format!("CONVEX_FUNRUN_ADDR must include a port: {addr}"))?;
+        (host, port)
+    } else {
+        rest.rsplit_once(':')
+            .with_context(|| format!("CONVEX_FUNRUN_ADDR must include a port: {addr}"))?
+    };
+    let port: u16 = port
+        .parse()
+        .with_context(|| format!("invalid funrun port in {addr}"))?;
+    anyhow::ensure!(!host.is_empty(), "empty funrun host in {addr}");
+    Ok((host.to_string(), port))
+}
+
+pub fn preflight(funrun_addr: &str) -> anyhow::Result<()> {
+    parse_funrun_target(funrun_addr)?;
+    isolate::client::initialize_v8();
+    Ok(())
+}
+
+fn funrun_endpoint(uri: &str) -> anyhow::Result<Endpoint> {
+    Ok(Endpoint::from_shared(uri.to_string())
+        .with_context(|| format!("invalid funrun endpoint {uri}"))?
+        .tcp_nodelay(true)
+        .connect_timeout(FUNRUN_CONNECT_TIMEOUT)
+        .http2_keep_alive_interval(FUNRUN_KEEPALIVE_INTERVAL)
+        .keep_alive_timeout(FUNRUN_KEEPALIVE_TIMEOUT)
+        .keep_alive_while_idle(true)
+        .http2_max_local_error_reset_streams(None))
+}
+
+fn spawn_endpoint_refresher<RT: Runtime>(
+    rt: &RT,
+    host: String,
+    port: u16,
+    tx: tokio::sync::mpsc::Sender<Change<SocketAddr, Endpoint>>,
+    empty_since: watch::Sender<Option<Instant>>,
+) {
+    let refresh_rt = rt.clone();
+    rt.spawn_background("funrun_lb_refresh", async move {
+        let mut current = BTreeSet::new();
+        loop {
+            match lookup_host((host.as_str(), port)).await {
+                Ok(addrs) => {
+                    let unique: BTreeSet<SocketAddr> = addrs.collect();
+                    if !unique.is_empty() {
+                        let mut next: BTreeSet<SocketAddr> =
+                            unique.intersection(&current).copied().collect();
+                        for addr in unique.difference(&current) {
+                            if let Ok(endpoint) = funrun_endpoint(&format!("http://{addr}"))
+                                && tx.send(Change::Insert(*addr, endpoint)).await.is_ok()
+                            {
+                                next.insert(*addr);
+                            }
+                        }
+                        for addr in current.difference(&unique) {
+                            let _ = tx.send(Change::Remove(*addr)).await;
+                        }
+                        if next != current {
+                            tracing::info!("[funrun-lb] p2c across {} endpoint(s)", next.len());
+                            current = next;
+                        }
+                    }
+                },
+                Err(e) => {
+                    tracing::warn!("[funrun-lb] DNS resolution for {host}:{port} failed: {e}")
+                },
+            }
+            if !current.is_empty() {
+                empty_since.send_if_modified(|since| since.take().is_some());
+            }
+            refresh_rt.wait(*FUNRUN_LB_REFRESH_INTERVAL).await;
+        }
+    });
+}
