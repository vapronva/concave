+use std::time::Duration;
+
+use common::knobs::FUNRUN_ISOLATE_ACTIVE_THREADS;
+use isolate::{
+    isolate_worker::FunctionRunnerIsolateWorker,
+    ConcurrencyLimiter,
+    IsolateConfig,
+};
+
+use super::*;
+
+const ACTIVE_CONCURRENCY_PERMITS_LOG_FREQUENCY: Duration = Duration::from_secs(10);
+
+pub fn funrun_isolate_worker<RT: Runtime>(rt: &RT) -> FunctionRunnerIsolateWorker<RT> {
+    let concurrency_limiter = if *FUNRUN_ISOLATE_ACTIVE_THREADS > 0 {
+        ConcurrencyLimiter::new(*FUNRUN_ISOLATE_ACTIVE_THREADS)
+    } else {
+        ConcurrencyLimiter::unlimited()
+    };
+    rt.spawn_background(
+        "concurrency_logger",
+        concurrency_limiter.go_log(rt.clone(), ACTIVE_CONCURRENCY_PERMITS_LOG_FREQUENCY),
+    );
+    FunctionRunnerIsolateWorker::new(
+        rt.clone(),
+        IsolateConfig::new("funrun", concurrency_limiter),
+    )
+}
+
+impl<RT: Runtime, S: StorageForDeployment<RT>> FunctionRunnerCore<RT, S> {
+    pub fn new_with_isolate_client(rt: RT, storage: S, isolate_client: IsolateClient<RT>) -> Self {
+        let index_cache = InMemoryIndexCache::new(rt.clone());
+        let module_cache = ModuleCache::new(rt.clone());
+        let code_cache = CodeCache::new();
+        Self {
+            rt,
+            storage,
+            index_cache,
+            module_cache,
+            code_cache,
+            isolate_client,
+        }
+    }
+}
