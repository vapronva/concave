+use std::sync::{
+    atomic::{
+        AtomicBool,
+        AtomicU64,
+        Ordering,
+    },
+    Arc,
+};
+
+use anyhow::Context;
+use async_trait::async_trait;
+use axum::{
+    extract::RawQuery,
+    response::{
+        IntoResponse,
+        Response,
+    },
+};
+use common::{
+    http::extract::MtState,
+    knobs::{
+        FUNCTION_LIMIT_WARNING_RATIO,
+        TRANSACTION_MAX_READ_SIZE_BYTES,
+        TRANSACTION_MAX_READ_SIZE_ROWS,
+    },
+};
+use events::usage::{
+    NoOpUsageEventLogger,
+    UsageEvent,
+    UsageEventLogger,
+};
+use http::StatusCode;
+use metrics::{
+    log_counter,
+    register_convex_counter,
+};
+use parking_lot::Mutex;
+use reqwest::Client;
+use roles::RequireDeploymentOp;
+use tokio::{
+    sync::{
+        mpsc,
+        oneshot,
+    },
+    time::{
+        timeout,
+        Duration,
+    },
+};
+
+use crate::{
+    authentication::ExtractIdentity,
+    LocalAppState,
+};
+
+const USAGE_FORWARDER_CHANNEL_CAPACITY: usize = 2048;
+const USAGE_FORWARDER_MAX_BATCHES_PER_POST: usize = 32;
+const USAGE_FORWARDER_MAX_POST_BYTES: usize = 4 << 20;
+const SELF_HOSTED_USAGE_QUERY_PATH: &str = "/api/dashboard/teams/0/usage/query";
+
+register_convex_counter!(
+    USAGE_FORWARDER_DROPPED_BATCHES_TOTAL,
+    "Usage-event batches dropped because the forwarder channel was full or closed"
+);
+
+fn is_insight(event: &UsageEvent) -> bool {
+    match event {
+        UsageEvent::FunctionCall { fields } => fields.is_occ,
+        UsageEvent::InsightReadLimit { .. } => true,
+        UsageEvent::FunctionStorageCalls { .. }
+        | UsageEvent::FunctionStorageBandwidth { .. }
+        | UsageEvent::StorageCall { .. }
+        | UsageEvent::StorageBandwidth { .. }
+        | UsageEvent::DatabaseBandwidth { .. }
+        | UsageEvent::NetworkBandwidth { .. }
+        | UsageEvent::VectorBandwidth { .. }
+        | UsageEvent::TextWrites { .. }
+        | UsageEvent::TextQuery { .. }
+        | UsageEvent::VectorQuery { .. }
+        | UsageEvent::AuditLogBandwidth { .. }
+        | UsageEvent::CurrentVectorStorage { .. }
+        | UsageEvent::CurrentTextStorage { .. }
+        | UsageEvent::CurrentDatabaseStorage { .. }
+        | UsageEvent::CurrentFileStorage { .. }
+        | UsageEvent::CurrentDocumentCounts { .. }
+        | UsageEvent::CurrentBackendState { .. } => false,
+    }
+}
+
+fn usage_sink_token() -> Option<String> {
+    std::env::var("CONVEX_USAGE_SINK_TOKEN")
+        .ok()
+        .filter(|t| !t.is_empty())
+}
+
+pub fn usage_event_logger_from_env(
+    deployment: String,
+) -> anyhow::Result<Arc<dyn UsageEventLogger>> {
+    let Some(raw) = std::env::var("CONVEX_USAGE_SINK_URL")
+        .ok()
+        .filter(|u| !u.is_empty())
+    else {
+        return Ok(Arc::new(NoOpUsageEventLogger));
+    };
+    let url = reqwest::Url::parse(&raw).context("CONVEX_USAGE_SINK_URL is not a URL")?;
+    let token = usage_sink_token();
+    if token.is_none() {
+        tracing::warn!(
+            "[concave] CONVEX_USAGE_SINK_TOKEN is unset; the usage sink will reject every batch"
+        );
+    }
+    let mut shown = url.clone();
+    let _ = shown.set_username("");
+    let _ = shown.set_password(None);
+    tracing::info!("[concave] forwarding usage events to {shown}");
+    Ok(Arc::new(HttpUsageForwarder::new(url, token, deployment)?))
+}
+
+#[derive(Debug)]
+pub struct HttpUsageForwarder {
+    tx: mpsc::Sender<Vec<UsageEvent>>,
+    shutdown_tx: Mutex<Option<oneshot::Sender<()>>>,
+    worker: Mutex<Option<tokio::task::JoinHandle<()>>>,
+    dropping: AtomicBool,
+    outstanding: Arc<AtomicU64>,
+}
+
+struct Sink {
+    client: Client,
+    url: reqwest::Url,
+    token: Option<String>,
+    deployment: String,
+}
+
+fn json_len(events: &[UsageEvent]) -> usize {
+    serde_json::to_vec(events).map_or(usize::MAX, |body| body.len())
+}
+
+fn coalesce_batches(
+    rx: &mut mpsc::Receiver<Vec<UsageEvent>>,
+    mut events: Vec<UsageEvent>,
+) -> (Vec<UsageEvent>, u64, Option<Vec<UsageEvent>>) {
+    let mut batches: u64 = 1;
+    let mut bytes = json_len(&events);
+    while batches < USAGE_FORWARDER_MAX_BATCHES_PER_POST as u64 {
+        let Ok(more) = rx.try_recv() else {
+            break;
+        };
+        let more_bytes = json_len(&more);
+        if bytes.saturating_add(more_bytes) > USAGE_FORWARDER_MAX_POST_BYTES {
+            return (events, batches, Some(more));
+        }
+        bytes += more_bytes;
+        events.extend(more);
+        batches += 1;
+    }
+    (events, batches, None)
+}
+
+impl Sink {
+    async fn post(&self, events: Vec<UsageEvent>, batches: u64) {
+        if events.is_empty() {
+            return;
+        }
+        let body = serde_json::json!({
+            "deployment": self.deployment,
+            "read_limits": {
+                "documents": *TRANSACTION_MAX_READ_SIZE_ROWS,
+                "bytes": *TRANSACTION_MAX_READ_SIZE_BYTES,
+                "warning_ratio": *FUNCTION_LIMIT_WARNING_RATIO,
+            },
+            "events": events,
+        });
+        for attempt in 1..=3 {
+            let mut req = self.client.post(self.url.clone()).json(&body);
+            if let Some(token) = &self.token {
+                req = req.bearer_auth(token);
+            }
+            match req.send().await {
+                Ok(resp) if resp.status().is_success() => return,
+                Ok(resp) => {
+                    let status = resp.status();
+                    let body = resp.text().await.unwrap_or_default();
+                    let body: String = body.trim().chars().take(200).collect();
+                    if status.is_client_error() {
+                        tracing::error!(
+                            "usage sink rejected the batch ({status}: {body}); dropping it"
+                        );
+                        log_counter(&USAGE_FORWARDER_DROPPED_BATCHES_TOTAL, batches);
+                        return;
+                    }
+                    tracing::warn!("usage sink returned {status} ({body}) (attempt {attempt}/3)");
+                },
+                Err(e) => tracing::warn!("usage sink post failed (attempt {attempt}/3): {e}"),
+            }
+            if attempt < 3 {
+                tokio::time::sleep(Duration::from_millis(100 * attempt)).await;
+            }
+        }
+        tracing::error!("usage sink batch permanently failed after 3 attempts");
+        log_counter(&USAGE_FORWARDER_DROPPED_BATCHES_TOTAL, batches);
+    }
+
+    async fn post_coalesced(
+        &self,
+        rx: &mut mpsc::Receiver<Vec<UsageEvent>>,
+        events: Vec<UsageEvent>,
+        outstanding: &AtomicU64,
+    ) -> Option<Vec<UsageEvent>> {
+        let (events, batches, carry) = coalesce_batches(rx, events);
+        self.post(events, batches).await;
+        outstanding.fetch_sub(batches, Ordering::Relaxed);
+        carry
+    }
+
+    async fn drain(&self, rx: &mut mpsc::Receiver<Vec<UsageEvent>>, outstanding: &AtomicU64) {
+        let mut carry = None;
+        loop {
+            let events = match carry.take().or_else(|| rx.try_recv().ok()) {
+                Some(events) => events,
+                None => return,
+            };
+            carry = self.post_coalesced(rx, events, outstanding).await;
+        }
+    }
+}
+
+impl HttpUsageForwarder {
+    pub fn new(
+        url: reqwest::Url,
+        token: Option<String>,
+        deployment: String,
+    ) -> anyhow::Result<Self> {
+        let sink = Sink {
+            client: Client::builder()
+                .timeout(Duration::from_secs(30))
+                .connect_timeout(Duration::from_secs(10))
+                .build()?,
+            url,
+            token,
+            deployment,
+        };
+        let (tx, mut rx) = mpsc::channel::<Vec<UsageEvent>>(USAGE_FORWARDER_CHANNEL_CAPACITY);
+        let (shutdown_tx, mut shutdown_rx) = oneshot::channel::<()>();
+        let outstanding = Arc::new(AtomicU64::new(0));
+        let worker_outstanding = outstanding.clone();
+        let worker = tokio::spawn(async move {
+            let mut carry: Option<Vec<UsageEvent>> = None;
+            loop {
+                let events = match carry.take() {
+                    Some(events) => events,
+                    None => tokio::select! {
+                        Some(events) = rx.recv() => events,
+                        _ = &mut shutdown_rx => {
+                            rx.close();
+                            sink.drain(&mut rx, &worker_outstanding).await;
+                            break;
+                        },
+                        else => break,
+                    },
+                };
+                carry = sink
+                    .post_coalesced(&mut rx, events, &worker_outstanding)
+                    .await;
+            }
+        });
+        Ok(Self {
+            tx,
+            shutdown_tx: Mutex::new(Some(shutdown_tx)),
+            worker: Mutex::new(Some(worker)),
+            dropping: AtomicBool::new(false),
+            outstanding,
+        })
+    }
+}
+
+#[async_trait]
+impl UsageEventLogger for HttpUsageForwarder {
+    async fn record_async(&self, events: Vec<UsageEvent>) {
+        let events: Vec<UsageEvent> = events.into_iter().filter(is_insight).collect();
+        if events.is_empty() {
+            return;
+        }
+        match self.tx.try_send(events) {
+            Ok(()) => {
+                self.outstanding.fetch_add(1, Ordering::Relaxed);
+                if self.dropping.swap(false, Ordering::Relaxed) {
+                    tracing::info!("usage forwarder accepting Insights events again");
+                }
+            },
+            Err(e) => {
+                let state = match e {
+                    mpsc::error::TrySendError::Full(_) => "full",
+                    mpsc::error::TrySendError::Closed(_) => "closed",
+                };
+                log_counter(&USAGE_FORWARDER_DROPPED_BATCHES_TOTAL, 1);
+                if !self.dropping.swap(true, Ordering::Relaxed) {
+                    tracing::warn!("usage forwarder {state}; dropping Insights events");
+                }
+            },
+        }
+    }
+
+    async fn shutdown(&self) -> anyhow::Result<()> {
+        if let Some(tx) = self.shutdown_tx.lock().take() {
+            let _ = tx.send(());
+        }
+        let Some(mut handle) = self.worker.lock().take() else {
+            return Ok(());
+        };
+        if timeout(Duration::from_secs(5), &mut handle).await.is_err() {
+            handle.abort();
+            let abandoned = self.outstanding.load(Ordering::Relaxed);
+            if abandoned > 0 {
+                log_counter(&USAGE_FORWARDER_DROPPED_BATCHES_TOTAL, abandoned);
+            }
+            tracing::error!(
+                "usage forwarder shutdown timed out; {abandoned} Insights batches abandoned"
+            );
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone)]
+pub struct InsightsProxy {
+    base_url: reqwest::Url,
+    token: Option<String>,
+    client: Client,
+}
+
+impl InsightsProxy {
+    pub fn from_env() -> anyhow::Result<Option<Self>> {
+        let Some(base_url) = std::env::var("CONVEX_USAGE_SINK_URL")
+            .ok()
+            .filter(|u| !u.is_empty())
+        else {
+            return Ok(None);
+        };
+        Ok(Some(Self {
+            base_url: reqwest::Url::parse(&base_url)
+                .context("CONVEX_USAGE_SINK_URL is not a URL")?,
+            token: usage_sink_token(),
+            client: Client::builder()
+                .timeout(Duration::from_secs(15))
+                .connect_timeout(Duration::from_secs(10))
+                .build()?,
+        }))
+    }
+}
+
+pub async fn insights_query(
+    MtState(st): MtState<LocalAppState>,
+    ExtractIdentity(identity): ExtractIdentity,
+    RawQuery(query): RawQuery,
+) -> Response {
+    if identity
+        .require_operation(keybroker::DeploymentOp::ViewUsage)
+        .is_err()
+    {
+        return (
+            StatusCode::FORBIDDEN,
+            "insights requires a key that may view usage",
+        )
+            .into_response();
+    }
+    let Some(proxy) = &st.insights_proxy else {
+        return (
+            StatusCode::NOT_FOUND,
+            "insights query endpoint not configured",
+        )
+            .into_response();
+    };
+    let upstream = build_insights_url(&proxy.base_url, &st.instance_name, query.as_deref());
+    let mut req = proxy.client.get(upstream);
+    if let Some(token) = &proxy.token {
+        req = req.bearer_auth(token);
+    }
+    match req.send().await {
+        Ok(resp) => {
+            let status = resp.status();
+            if status == StatusCode::NOT_FOUND {
+                tracing::warn!(
+                    "[concave] insights upstream returned 404 for deployment {}",
+                    st.instance_name
+                );
+                return (StatusCode::BAD_GATEWAY, "insights upstream returned 404").into_response();
+            }
+            let content_type = resp.headers().get(http::header::CONTENT_TYPE).cloned();
+            let body = match resp.bytes().await {
+                Ok(body) => body,
+                Err(e) => {
+                    tracing::warn!("[concave] insights upstream body read failed: {e}");
+                    return (
+                        StatusCode::BAD_GATEWAY,
+                        "insights upstream body read failed",
+                    )
+                        .into_response();
+                },
+            };
+            let mut response = (status, body).into_response();
+            if let Some(content_type) = content_type {
+                response
+                    .headers_mut()
+                    .insert(http::header::CONTENT_TYPE, content_type);
+            }
+            response
+        },
+        Err(e) => {
+            tracing::warn!("[concave] insights query proxy failed: {e}");
+            (StatusCode::BAD_GATEWAY, "insights upstream error").into_response()
+        },
+    }
+}
+
+fn build_insights_url(
+    base: &reqwest::Url,
+    deployment: &str,
+    raw_query: Option<&str>,
+) -> reqwest::Url {
+    let mut url = base.clone();
+    url.set_path(SELF_HOSTED_USAGE_QUERY_PATH);
+    url.set_query(None);
+    {
+        let mut pairs = url.query_pairs_mut();
+        if let Some(raw_query) = raw_query {
+            for (key, value) in url::form_urlencoded::parse(raw_query.as_bytes()) {
+                if key == "from" || key == "to" {
+                    pairs.append_pair(&key, &value);
+                }
+            }
+        }
+        pairs.append_pair("deploymentName", deployment);
+    }
+    url
+}
+
+#[cfg(test)]
+mod tests {
+    use super::build_insights_url;
+
+    #[test]
+    fn insights_url_pins_deployment_name() {
+        let url = build_insights_url(
+            &reqwest::Url::parse("http://bigbrain:8081/ignored").unwrap(),
+            "real deployment",
+            Some("from=2026-01-01&deploymentName=evil&to=2026-01-02"),
+        );
+        let pairs = url.query_pairs().collect::<Vec<_>>();
+        assert_eq!(
+            pairs
+                .iter()
+                .filter(|(key, _)| key == "deploymentName")
+                .count(),
+            1
+        );
+        assert!(pairs
+            .iter()
+            .any(|(key, value)| key == "deploymentName" && value == "real deployment"));
+    }
+}
