diff --git a/crates/pb/protos/funrun.proto b/crates/pb/protos/funrun.proto
new file mode 100644
index 000000000..1579de679
--- /dev/null
+++ b/crates/pb/protos/funrun.proto
@@ -0,0 +1,199 @@
+syntax = "proto3";
+
+package funrun;
+
+import "common.proto";
+import "convex_identity.proto";
+import "convex_query_journal.proto";
+import "errors.proto";
+import "outcome.proto";
+import "searchlight.proto";
+import "usage.proto";
+
+service Funrun {
+  rpc RunFunction(RunFunctionRequest) returns (stream RunFunctionResponsePart);
+
+  rpc RunHttpAction(RunHttpActionRequest) returns (stream HttpActionResponsePart);
+}
+
+message RunFunctionRequest {
+  string instance_name = 1;
+
+  common.UdfType udf_type = 2;
+
+  convex_identity.UncheckedIdentity identity = 3;
+
+  common.RepeatableTimestamp ts = 4;
+
+  repeated common.PendingDocumentUpdate existing_writes = 5;
+
+  optional common.ValidatedPathAndArgs path_and_args = 6;
+  optional convex_query_journal.QueryJournal journal = 7;
+
+  repeated EnvVar default_system_env_vars = 8;
+
+  repeated IndexLastModified in_memory_index_last_modified = 9;
+
+  common.ExecutionContext context = 10;
+
+  optional string backend_callback_url = 11;
+  optional string callback_token = 12;
+  optional string auth_header = 13;
+  optional string callback_transport_url = 14;
+}
+
+message EnvVar {
+  string name = 1;
+  string value = 2;
+}
+
+message IndexLastModified {
+  string index_id = 1;
+  uint64 last_modified_ts = 2;
+}
+
+message RunFunctionResponsePart {
+  oneof part {
+    outcome.LogLine log_line = 1;
+    RunFunctionResult result = 2;
+  }
+}
+
+message RunFunctionResult {
+  outcome.FunctionOutcome outcome = 1;
+  optional FunctionFinalTransaction final_transaction = 2;
+  usage.FunctionUsageStats usage_stats = 3;
+}
+
+message RunHttpActionRequest {
+  string instance_name = 1;
+
+  convex_identity.UncheckedIdentity identity = 2;
+
+  common.RepeatableTimestamp ts = 3;
+
+  repeated common.PendingDocumentUpdate existing_writes = 4;
+
+  repeated EnvVar default_system_env_vars = 5;
+
+  repeated IndexLastModified in_memory_index_last_modified = 6;
+
+  common.ExecutionContext context = 7;
+
+  optional string backend_callback_url = 8;
+  optional string callback_token = 9;
+  optional string auth_header = 10;
+
+  common.ValidatedHttpPath http_module_path = 11;
+  string routed_path = 12;
+  common.HttpActionRequestHead http_request_head = 13;
+  optional bytes http_request_body = 14;
+  optional string callback_transport_url = 15;
+}
+
+message HttpActionResponsePart {
+  oneof part {
+    common.HttpActionResponse response = 1;
+    RunFunctionResult result = 2;
+    outcome.LogLine log_line = 3;
+  }
+}
+
+message FunctionFinalTransaction {
+  uint64 begin_timestamp = 1;
+  FunctionReads reads = 2;
+  repeated common.PendingDocumentUpdate writes = 3;
+  repeated RowsReadByTablet rows_read_by_tablet = 4;
+  repeated UploadedFile uploaded_files = 5;
+}
+
+message UploadedFile {
+  common.ResolvedDocumentId id = 1;
+  uint64 size = 2;
+}
+
+message FunctionReads {
+  repeated IndexedReads indexed = 1;
+  uint64 num_intervals = 2;
+  ReadSize user_tx_size = 3;
+  ReadSize system_tx_size = 4;
+  repeated SearchReads search = 5;
+}
+
+message IndexedReads {
+  string index_name = 1;
+  repeated common.FieldPath fields = 2;
+  repeated common.Interval intervals = 3;
+}
+
+message SearchReads {
+  string index_name = 1;
+  repeated TextQueryTermRead text_queries = 2;
+  repeated FilterConditionRead filter_conditions = 3;
+}
+
+message TextQueryTermRead {
+  common.FieldPath field_path = 1;
+  TextQueryTerm term = 2;
+}
+
+message TextQueryTerm {
+  oneof term {
+    string exact = 1;
+    string prefix = 2;
+  }
+}
+
+message FilterConditionRead {
+  common.FieldPath field_path = 1;
+  bytes value = 2;
+}
+
+message ReadSize {
+  uint64 total_document_size = 1;
+  uint64 total_document_count = 2;
+}
+
+message RowsReadByTablet {
+  string tablet_id = 1;
+  uint64 rows_read = 2;
+}
+
+message SnapshotTableCountsRequest {
+  common.RepeatableTimestamp ts = 1;
+}
+
+message SnapshotTableCountsResponse {
+  bool available = 1;
+  repeated TabletCount tablets = 2;
+  SnapshotError error = 3;
+}
+
+message TabletCount {
+  string tablet_id = 1;
+  uint64 count = 2;
+}
+
+message SnapshotTextSearchRequest {
+  common.RepeatableTimestamp ts = 1;
+  string index_id = 2;
+  string printable_index_name = 3;
+  searchlight.TextQuery query = 4;
+  repeated common.DocumentUpdate pending_updates = 5;
+}
+
+message SnapshotTextSearchResponse {
+  repeated TextSearchCandidate candidates = 1;
+  uint64 filtered_bytes_searched = 2;
+  SnapshotError error = 3;
+}
+
+message TextSearchCandidate {
+  searchlight.CandidateRevision revision = 1;
+  bytes index_key = 2;
+}
+
+message SnapshotError {
+  string message = 1;
+  errors.ErrorMetadata metadata = 2;
+}
diff --git a/crates/pb/src/funrun_status.rs b/crates/pb/src/funrun_status.rs
new file mode 100644
index 000000000..896635392
--- /dev/null
+++ b/crates/pb/src/funrun_status.rs
@@ -0,0 +1,124 @@
+use std::error::Error as _;
+
+use anyhow::Context;
+use errors::{
+    ErrorMetadata,
+    INTERNAL_SERVER_ERROR,
+    INTERNAL_SERVER_ERROR_MSG,
+};
+use prost::Message;
+
+use crate::errors::StatusDetails;
+
+fn decode_details(details: &[u8]) -> anyhow::Result<Option<ErrorMetadata>> {
+    let details = StatusDetails::decode(details).context("Failed to decode StatusDetails proto")?;
+    details
+        .error_metadata
+        .map(|metadata| {
+            ErrorMetadata::try_from(metadata).context("Failed to parse ErrorMetadata proto")
+        })
+        .transpose()
+}
+
+fn has_connection_reset_source(status: &tonic::Status) -> bool {
+    let mut source = status.source();
+    while let Some(error) = source {
+        if error
+            .downcast_ref::<std::io::Error>()
+            .is_some_and(|error| error.kind() == std::io::ErrorKind::ConnectionReset)
+        {
+            return true;
+        }
+        source = error.source();
+    }
+    false
+}
+
+pub fn status_error_metadata(status: &tonic::Status) -> Option<ErrorMetadata> {
+    decode_details(status.details()).ok().flatten()
+}
+
+pub fn status_into_anyhow(status: tonic::Status) -> anyhow::Error {
+    let code = status.code();
+    let (metadata, details_error) = match decode_details(status.details()) {
+        Ok(metadata) => (metadata, None),
+        Err(error) => (None, Some(error)),
+    };
+    let mut source_chain = String::new();
+    let mut source = status.source();
+    while let Some(s) = source {
+        source_chain.push_str(&format!(": {s}"));
+        source = s.source();
+    }
+    if let Some(error) = details_error {
+        source_chain.push_str(&format!("; undecodable status details: {error:#}"));
+    }
+    let error = anyhow::anyhow!(
+        "status: {code:?}, message: {:?}{source_chain}",
+        status.message()
+    );
+    match metadata {
+        Some(metadata) => error.context(metadata),
+        None if code == tonic::Code::ResourceExhausted
+            || (code == tonic::Code::Unknown && has_connection_reset_source(&status)) =>
+        {
+            error.context(ErrorMetadata::overloaded(
+                INTERNAL_SERVER_ERROR,
+                INTERNAL_SERVER_ERROR_MSG,
+            ))
+        },
+        None => error,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use errors::{
+        ErrorMetadata,
+        INTERNAL_SERVER_ERROR,
+        INTERNAL_SERVER_ERROR_MSG,
+    };
+
+    use super::{
+        status_error_metadata,
+        status_into_anyhow,
+    };
+    use crate::error_metadata::ErrorMetadataStatusExt;
+
+    #[test]
+    fn plain_metadata_round_trips() {
+        let metadata = ErrorMetadata::bad_request("BadRobot", "robot was bad");
+        let status = tonic::Status::from_anyhow(metadata.clone().into());
+        assert_eq!(status.code(), tonic::Code::InvalidArgument);
+        assert_eq!(status_error_metadata(&status), Some(metadata.clone()));
+        let error = status_into_anyhow(status);
+        assert_eq!(error.downcast_ref::<ErrorMetadata>(), Some(&metadata));
+    }
+
+    #[test]
+    fn rejected_before_execution_survives_the_wire() {
+        let metadata = ErrorMetadata::rejected_before_execution("FunrunRejected", "try elsewhere");
+        let status = tonic::Status::from_anyhow(metadata.clone().into());
+        assert_eq!(status.code(), tonic::Code::ResourceExhausted);
+        let decoded = status_error_metadata(&status).unwrap();
+        assert!(decoded.is_rejected_before_execution());
+        assert_eq!(decoded, metadata);
+    }
+
+    #[test]
+    fn bare_resource_exhausted_decodes_as_overloaded() {
+        let overloaded =
+            ErrorMetadata::overloaded(INTERNAL_SERVER_ERROR, INTERNAL_SERVER_ERROR_MSG);
+        let error = status_into_anyhow(tonic::Status::resource_exhausted("quota exhausted"));
+        assert_eq!(error.downcast_ref::<ErrorMetadata>(), Some(&overloaded));
+        let undecodable = tonic::Status::with_details(
+            tonic::Code::ResourceExhausted,
+            "quota exhausted",
+            vec![0xff, 0xff, 0xff].into(),
+        );
+        assert_eq!(status_error_metadata(&undecodable), None);
+        let error = status_into_anyhow(undecodable);
+        assert!(format!("{error:#}").contains("undecodable status details"));
+        assert_eq!(error.downcast_ref::<ErrorMetadata>(), Some(&overloaded));
+    }
+}
