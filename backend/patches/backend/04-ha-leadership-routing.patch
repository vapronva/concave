+const MAX_NON_TRANSIENT_PROBE_FAILURES: usize = 3;
+const TRANSIENT_HEARTBEAT_EVERY: usize = 20;
+
+#[derive(Copy, Clone)]
+enum BackendRole {
+    Leader,
+    Follower,
+}
+
+impl BackendRole {
+    fn from_env() -> anyhow::Result<Self> {
+        match std::env::var("CONVEX_BACKEND_ROLE")
+            .unwrap_or_default()
+            .as_str()
+        {
+            "" | "leader" => Ok(Self::Leader),
+            "follower" => Ok(Self::Follower),
+            other => anyhow::bail!("CONVEX_BACKEND_ROLE must be leader or follower, got {other:?}"),
+        }
+    }
+}
+
+enum Role {
+    Follower,
+    Promoting,
+    Leader(Arc<dyn Persistence>),
+}
+
+struct RoleState {
+    role: parking_lot::Mutex<Role>,
+    lease_probe_last_ok: parking_lot::Mutex<Option<Instant>>,
+    preempt_signal: ShutdownSignal,
+}
+
+enum PromotionAttempt {
+    Started,
+    AlreadyInProgress,
+    AlreadyLeader,
+}
+
+enum DemotionCheck {
+    Leader,
+    Follower,
+    Promoting,
+    LeaseChanged,
+}
+
+struct RoleSnapshot {
+    label: &'static str,
+    is_leader: bool,
+    lease_ts: Option<u64>,
+}
+
+impl RoleState {
+    fn new(preempt_signal: ShutdownSignal) -> Self {
+        Self {
+            role: parking_lot::Mutex::new(Role::Follower),
+            lease_probe_last_ok: parking_lot::Mutex::new(None),
+            preempt_signal,
+        }
+    }
+
+    fn snapshot(&self) -> RoleSnapshot {
+        let role = self.role.lock();
+        let (label, lease_ts) = match &*role {
+            Role::Follower => ("follower", None),
+            Role::Promoting => ("promoting", None),
+            Role::Leader(persistence) => ("leader", persistence.lease_ts()),
+        };
+        RoleSnapshot {
+            label,
+            is_leader: matches!(&*role, Role::Leader(_)),
+            lease_ts,
+        }
+    }
+
+    fn is_leader(&self) -> bool {
+        matches!(&*self.role.lock(), Role::Leader(_))
+    }
+
+    fn begin_promotion(&self) -> PromotionAttempt {
+        let mut role = self.role.lock();
+        match &*role {
+            Role::Follower => {},
+            Role::Promoting => return PromotionAttempt::AlreadyInProgress,
+            Role::Leader(_) => return PromotionAttempt::AlreadyLeader,
+        }
+        *role = Role::Promoting;
+        PromotionAttempt::Started
+    }
+
+    fn install(&self, persistence: Arc<dyn Persistence>) {
+        *self.role.lock() = Role::Leader(persistence);
+    }
+
+    fn abort_promotion(&self) {
+        *self.role.lock() = Role::Follower;
+    }
+
+    fn check_demotion(&self, expected_lease_ts: Option<u64>) -> DemotionCheck {
+        let persistence = match &*self.role.lock() {
+            Role::Leader(persistence) => persistence.clone(),
+            Role::Promoting => return DemotionCheck::Promoting,
+            Role::Follower => return DemotionCheck::Follower,
+        };
+        if expected_lease_ts.is_some_and(|expected| persistence.lease_ts() != Some(expected)) {
+            return DemotionCheck::LeaseChanged;
+        }
+        DemotionCheck::Leader
+    }
+
+    fn lease_unverified_secs(&self) -> Option<u64> {
+        self.lease_probe_last_ok
+            .lock()
+            .map(|t| t.elapsed().as_secs())
+    }
+
+    fn record_lease_probe(&self) {
+        *self.lease_probe_last_ok.lock() = Some(Instant::now());
+    }
+
+    async fn watch_lease(&self, runtime: ProdRuntime, rw_persistence: Arc<dyn Persistence>) {
+        let mut non_transient_failures = 0;
+        let mut transient_failures: usize = 0;
+        loop {
+            match rw_persistence.lease_held().await {
+                Ok(true) => {
+                    non_transient_failures = 0;
+                    transient_failures = 0;
+                    self.record_lease_probe();
+                },
+                Ok(false) => {
+                    self.record_lease_probe();
+                    break;
+                },
+                Err(e) if common::errors::is_transient_db_error(&e) => {
+                    non_transient_failures = 0;
+                    transient_failures += 1;
+                    if transient_failures % TRANSIENT_HEARTBEAT_EVERY == 0 {
+                        tracing::warn!(
+                            "[lease-watch] {transient_failures} consecutive transient probe \
+                             errors; lease ownership unverified: {e:#}"
+                        );
+                    }
+                },
+                Err(e) => {
+                    transient_failures = 0;
+                    non_transient_failures += 1;
+                    if non_transient_failures >= MAX_NON_TRANSIENT_PROBE_FAILURES {
+                        tracing::error!(
+                            "[lease-watch] probe failed {non_transient_failures} times with \
+                             non-transient errors; firing preempt: {e:#}"
+                        );
+                        self.preempt_signal.signal(anyhow::anyhow!(
+                            "lease-watch cannot verify lease ownership after \
+                             {non_transient_failures} non-transient failures: {e:#}"
+                        ));
+                        return;
+                    }
+                    tracing::warn!(
+                        "[lease-watch] non-transient probe error \
+                         ({non_transient_failures}/{MAX_NON_TRANSIENT_PROBE_FAILURES}): {e:#}"
+                    );
+                },
+            }
+            runtime.wait(LEASE_POLL_INTERVAL).await;
+        }
+        self.preempt_signal
+            .signal(anyhow::anyhow!("lease lost; restarting"));
+    }
+}
+
+pub struct HaNode {
+    runtime: ProdRuntime,
+    config: LocalConfig,
+    zombify_rx: async_broadcast::Receiver<()>,
+    role: RoleState,
+    configured_role: BackendRole,
+    control_plane_token: Option<String>,
+    database: Database<ProdRuntime>,
+    searcher: Arc<InProcessSearcher<ProdRuntime>>,
+    app: OnceLock<LocalAppState>,
+    router: Arc<OnceLock<Router>>,
+}
+
+pub async fn boot(
+    runtime: ProdRuntime,
+    config: LocalConfig,
+    zombify_rx: async_broadcast::Receiver<()>,
+    preempt_signal: ShutdownSignal,
+) -> anyhow::Result<Arc<HaNode>> {
+    let configured_role = BackendRole::from_env()?;
+    let control_plane_token = control_plane_token_from_env();
+    anyhow::ensure!(
+        control_plane_token.is_some() || matches!(configured_role, BackendRole::Leader),
+        "a follower requires CONVEX_CONTROL_PLANE_TOKEN: without it nothing can promote it"
+    );
+    anyhow::ensure!(
+        control_plane_token.is_none() || matches!(config.db, DbDriverTag::Postgres(_)),
+        "dynamic backend roles require Postgres because MySQL/SQLite do not implement the HA \
+         lease fencing contract"
+    );
+    let boot_as_follower = match configured_role {
+        BackendRole::Follower => true,
+        BackendRole::Leader => {
+            control_plane_token.is_some()
+                && postgres_database_initialized(&config, runtime.clone()).await?
+        },
+    };
+    let rw_persistence = if boot_as_follower {
+        None
+    } else {
+        Some(connect_rw(&config, runtime.clone(), preempt_signal.clone()).await?)
+    };
+    let searcher = Arc::new(InProcessSearcher::new(runtime.clone())?);
+    let (deleted_tablet_sender, deleted_tablet_receiver) = tokio::sync::mpsc::channel(100);
+    let database = match &rw_persistence {
+        Some(rw_persistence) => {
+            Database::load(
+                rw_persistence.clone(),
+                runtime.clone(),
+                searcher.clone(),
+                preempt_signal.clone(),
+                virtual_system_mapping().clone(),
+                IndexCache::new(*INDEX_CACHE_SIZE).new_handle(),
+                Arc::new(new_rate_limiter(
+                    runtime.clone(),
+                    Quota::per_second(*DOCUMENT_RETENTION_RATE_LIMIT),
+                )),
+                deleted_tablet_sender,
+                config.name(),
+            )
+            .await?
+        },
+        None => {
+            if matches!(configured_role, BackendRole::Leader) {
+                tracing::info!(
+                    "[concave] database already initialized; booting as follower and awaiting \
+                     promotion"
+                );
+            }
+            let reader = connect_persistence_reader(
+                config.db,
+                &config.db_spec,
+                !config.do_not_require_ssl,
+                &config.name(),
+                deployment_id(&config),
+                runtime.clone(),
+            )
+            .await?;
+            tracing::info!("[concave] starting in FOLLOWER mode (read-only, no lease)");
+            Database::load_follower(
+                reader,
+                runtime.clone(),
+                searcher.clone(),
+                virtual_system_mapping().clone(),
+                database::FollowerOptions::BACKEND,
+            )
+            .await?
+        },
+    };
+    let node = Arc::new(HaNode {
+        runtime: runtime.clone(),
+        config: config.clone(),
+        zombify_rx: zombify_rx.clone(),
+        role: RoleState::new(preempt_signal.clone()),
+        configured_role,
+        control_plane_token,
+        database: database.clone(),
+        searcher: searcher.clone(),
+        app: OnceLock::new(),
+        router: Arc::default(),
+    });
+    let Some(rw_persistence) = rw_persistence else {
+        preflight(&runtime, &config, &database).await?;
+        return Ok(node);
+    };
+    node.start_lease_watch(rw_persistence.clone());
+    let app = make_app(
+        runtime,
+        config,
+        rw_persistence.clone(),
+        database,
+        searcher,
+        deleted_tablet_receiver,
+        zombify_rx,
+        preempt_signal,
+    )
+    .await?;
+    node.install_leader(app, rw_persistence)?;
+    Ok(node)
+}
+
+impl HaNode {
+    pub async fn shutdown(&self) -> anyhow::Result<()> {
+        match self.app.get() {
+            Some(app) => app.clone().shutdown().await,
+            None => self.database.shutdown().await,
+        }
+    }
+
+    fn start_lease_watch(self: &Arc<Self>, rw_persistence: Arc<dyn Persistence>) {
+        if rw_persistence.lease_ts().is_none() {
+            tracing::info!("[concave] no lease; skipping lease-watch (commit-time fencing)");
+            return;
+        }
+        self.role.record_lease_probe();
+        let node = self.clone();
+        self.runtime.spawn_background("lease_watch", async move {
+            node.role
+                .watch_lease(node.runtime.clone(), rw_persistence)
+                .await
+        });
+    }
+
+    async fn start_leader(
+        self: &Arc<Self>,
+        rw_persistence: Arc<dyn Persistence>,
+    ) -> anyhow::Result<()> {
+        let deleted_tablet_receiver = self
+            .database
+            .become_leader(
+                rw_persistence.clone(),
+                self.role.preempt_signal.clone(),
+                self.config.name(),
+            )
+            .await?;
+        let app = make_app(
+            self.runtime.clone(),
+            self.config.clone(),
+            rw_persistence.clone(),
+            self.database.clone(),
+            self.searcher.clone(),
+            deleted_tablet_receiver,
+            self.zombify_rx.clone(),
+            self.role.preempt_signal.clone(),
+        )
+        .await?;
+        tracing::info!("[promote] leader app built");
+        self.install_leader(app, rw_persistence)
+    }
+
+    fn install_leader(
+        self: &Arc<Self>,
+        app: LocalAppState,
+        rw_persistence: Arc<dyn Persistence>,
+    ) -> anyhow::Result<()> {
+        let router = admitted(
+            crate::router::router(app.clone()),
+            "backend",
+            *HTTP_SERVER_MAX_CONCURRENT_REQUESTS,
+            control_routes(self.clone()).nest(
+                "/api/actions",
+                crate::node_action_callbacks::funrun_snapshot_routes(app.clone()),
+            ),
+        );
+        anyhow::ensure!(
+            self.app.set(app).is_ok() && self.router.set(router).is_ok(),
+            "a leader is already installed in this process"
+        );
+        self.role.install(rw_persistence);
+        Ok(())
+    }
+}
+
+async fn preflight(
+    runtime: &ProdRuntime,
+    config: &LocalConfig,
+    database: &Database<ProdRuntime>,
+) -> anyhow::Result<()> {
+    config.key_broker()?;
+    config.convex_origin_url()?.parse::<EnvVarValue>()?;
+    config.convex_site_url()?.parse::<EnvVarValue>()?;
+    InsightsProxy::from_env()?;
+    isolate::client::initialize_v8();
+    if let Ok(funrun_addr) = std::env::var("CONVEX_FUNRUN_ADDR")
+        && !funrun_addr.is_empty()
+    {
+        function_runner::remote::preflight(&funrun_addr)?;
+    }
+    let mut tx = database.begin_system().await?;
+    if !tx
+        .table_mapping()
+        .namespace(TableNamespace::Global)
+        .name_exists(&DATABASE_GLOBALS_TABLE)
+    {
+        return Ok(());
+    }
+    let Some(storage_type) = DatabaseGlobalsModel::new(&mut tx)
+        .database_globals()
+        .await?
+        .into_value()
+        .storage_type
+    else {
+        return Ok(());
+    };
+    match (config.storage_tag_initializer(), &storage_type) {
+        (StorageTagInitializer::Local { dir }, StorageType::Local { dir: db_dir })
+            if dir.to_string_lossy() == db_dir.as_str() => {},
+        (StorageTagInitializer::S3, StorageType::S3 { s3_prefix })
+            if s3_prefix.starts_with(&format!("{}-", config.name())) => {},
+        (configured, _) => anyhow::bail!(
+            "database storage is {storage_type:?} but this backend is configured for \
+             {configured:?}"
+        ),
+    }
+    for use_case in [
+        StorageUseCase::Files,
+        StorageUseCase::Modules,
+        StorageUseCase::SearchIndexes,
+        StorageUseCase::Exports,
+        StorageUseCase::SnapshotImports,
+    ] {
+        application::create_storage(runtime.clone(), &storage_type, use_case)
+            .await
+            .with_context(|| format!("preflight: {use_case} storage for {storage_type:?}"))?;
+    }
+    tracing::info!("[concave] follower preflight passed");
+    Ok(())
+}
+
+pub fn with_funrun(
+    local: Arc<dyn FunctionRunner<ProdRuntime>>,
+    config: &LocalConfig,
+    database: &Database<ProdRuntime>,
+    runtime: ProdRuntime,
+) -> anyhow::Result<Arc<dyn FunctionRunner<ProdRuntime>>> {
+    let Some(funrun_addr) = std::env::var("CONVEX_FUNRUN_ADDR")
+        .ok()
+        .filter(|addr| !addr.is_empty())
+    else {
+        return Ok(local);
+    };
+    tracing::info!("[funrun] offloading UDF execution to remote funrun fleet at {funrun_addr}");
+    Ok(Arc::new(RemoteFunctionRunner::new(
+        funrun_addr,
+        config.name(),
+        config.key_broker()?,
+        config.secret()?,
+        config.convex_origin_url()?,
+        runtime,
+        local,
+        database.clone(),
+    )?))
+}
+
+fn deployment_id(config: &LocalConfig) -> Option<DeploymentId> {
+    Some(DeploymentId::stable_from_name(&config.name()))
+}
+
+async fn connect_rw(
+    config: &LocalConfig,
+    runtime: ProdRuntime,
+    preempt_signal: ShutdownSignal,
+) -> anyhow::Result<Arc<dyn Persistence>> {
+    connect_persistence(
+        config.db,
+        &config.db_spec,
+        ConnectPersistenceFlags {
+            require_ssl: !config.do_not_require_ssl,
+            allow_read_only: false,
+            skip_index_creation: false,
+        },
+        &config.name(),
+        deployment_id(config),
+        runtime,
+        preempt_signal,
+    )
+    .await
+}
+
+async fn postgres_database_initialized(
+    config: &LocalConfig,
+    runtime: ProdRuntime,
+) -> anyhow::Result<bool> {
+    match persistence_seed(
+        config.db,
+        &config.db_spec,
+        ConnectPersistenceFlags {
+            require_ssl: !config.do_not_require_ssl,
+            allow_read_only: true,
+            skip_index_creation: false,
+        },
+        &config.name(),
+        None,
+        runtime,
+    )? {
+        PersistenceSeed::Postgres {
+            config: pg_config,
+            options,
+        } => {
+            let pool = PostgresPersistence::create_pool(pg_config)
+                .context("failed to create postgres pool")?;
+            let reader_options = PostgresReaderOptions {
+                version: options.version,
+                schema: options.schema,
+                instance_name: options.instance_name,
+                multitenant: options.multitenant,
+            };
+            PostgresPersistence::schema_initialized(pool, reader_options).await
+        },
+        PersistenceSeed::Sqlite { .. } | PersistenceSeed::MySql { .. } => {
+            anyhow::bail!("the boot-role probe requires a Postgres persistence backend")
+        },
+    }
+}
+
+fn control_plane_token_from_env() -> Option<String> {
+    let token = std::env::var("CONVEX_CONTROL_PLANE_TOKEN")
+        .ok()
+        .filter(|t| !t.is_empty());
+    if token.is_some() {
+        tracing::info!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN set; /instance/promote and /instance/demote \
+             require the X-Convex-Control-Plane-Token header"
+        );
+    } else {
+        tracing::warn!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN is unset; all /instance control-plane requests \
+             will be rejected"
+        );
+    }
+    token
+}
+
+#[derive(Clone)]
+pub struct RoleRouter {
+    follower: Router,
+    leader: Arc<OnceLock<Router>>,
+}
+
+impl Service<Request> for RoleRouter {
+    type Error = Infallible;
+    type Future = Oneshot<Router, Request>;
+    type Response = Response;
+
+    fn poll_ready(&mut self, _cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn call(&mut self, req: Request) -> Self::Future {
+        let router = match self.leader.get() {
+            Some(leader) => leader.clone(),
+            None => self.follower.clone(),
+        };
+        router.oneshot(req)
+    }
+}
+
+impl RoleRouter {
+    pub async fn serve<F: Future<Output = ()> + Send + 'static>(
+        self,
+        addr: SocketAddr,
+        shutdown: F,
+    ) -> anyhow::Result<()> {
+        let socket = addr.make_socket()?;
+        let local_addr = socket.local_addr()?;
+        tracing::info!("backend listening on {local_addr}");
+        let make_svc =
+            axum::ServiceExt::<Request>::into_make_service_with_connect_info::<SocketAddr>(self);
+        serve_http(make_svc, socket, shutdown)
+            .await
+            .with_context(|| format!("Could not start backend on {local_addr}"))
+    }
+}
+
+pub fn http_service(node: &Arc<HaNode>) -> RoleRouter {
+    let follower = match node.router.get() {
+        Some(_) => Router::new(),
+        None => admitted(
+            follower_routes(node.config.name()),
+            "backend_follower",
+            *HTTP_SERVER_MAX_CONCURRENT_REQUESTS,
+            control_routes(node.clone()),
+        ),
+    };
+    RoleRouter {
+        follower,
+        leader: node.router.clone(),
+    }
+}
+
+fn admitted(
+    router: Router,
+    service_name: &'static str,
+    max_concurrency: usize,
+    control: Router,
+) -> Router {
+    ConvexHttpService::new(
+        router,
+        service_name,
+        SERVER_VERSION_STR.to_string(),
+        max_concurrency,
+        *HTTP_SERVER_TIMEOUT_DURATION,
+        HttpActionRouteMapper,
+    )
+    .into_router()
+    .merge(control)
+}
+
+fn follower_routes(instance_name: String) -> Router {
+    let version = SERVER_VERSION_STR.to_string();
+    Router::new()
+        .route(
+            "/",
+            get(|| async { "This Convex deployment is running. See https://docs.convex.dev/." }),
+        )
+        .route("/instance_name", get(|| async move { instance_name }))
+        .route("/instance_version", get(|| async move { version }))
+        .layer(crate::router::cors())
+        .fallback(follower_gate)
+}
+
+async fn follower_gate() -> Response {
+    (
+        StatusCode::MISDIRECTED_REQUEST,
+        [(FOLLOWER_GATE_HEADER, "1")],
+        "This backend is a follower (warm standby) and does not serve client traffic. Route to \
+         the leader (or POST /instance/promote to promote it).",
+    )
+        .into_response()
+}
+
+fn control_routes(node: Arc<HaNode>) -> Router {
+    let gated = Router::new()
+        .route("/instance/promote", post(promote))
+        .route("/instance/demote", post(demote))
+        .route_layer(axum::middleware::from_fn_with_state(
+            node.clone(),
+            control_plane_gate,
+        ));
+    Router::new()
+        .route("/readyz", get(readyz))
+        .route("/instance/leadership", get(leadership))
+        .merge(gated)
+        .with_state(node)
+}
+
+async fn control_plane_gate(
+    State(node): State<Arc<HaNode>>,
+    headers: http::HeaderMap,
+    req: Request<Body>,
+    next: Next,
+) -> Response {
+    let Some(expected) = node.control_plane_token.as_ref() else {
+        return (
+            StatusCode::FORBIDDEN,
+            "Control plane is disabled because CONVEX_CONTROL_PLANE_TOKEN is unset.",
+        )
+            .into_response();
+    };
+    let presented = headers
+        .get(CONTROL_PLANE_TOKEN_HEADER)
+        .map(|v| v.as_bytes())
+        .unwrap_or_default();
+    if keybroker::constant_time_eq_sha256(presented, expected.as_bytes()) {
+        return next.run(req).await;
+    }
+    tracing::warn!(
+        "[concave] rejected {} {}: missing or invalid control-plane token",
+        req.method(),
+        req.uri().path()
+    );
+    (
+        StatusCode::FORBIDDEN,
+        "Missing or invalid X-Convex-Control-Plane-Token.",
+    )
+        .into_response()
+}
+
+#[derive(Serialize)]
+struct LeadershipResponse {
+    role: &'static str,
+    is_leader: bool,
+    lease_ts: Option<u64>,
+    lease_unverified_secs: Option<u64>,
+    latest_ts: u64,
+    tailer_healthy: Option<bool>,
+}
+
+async fn leadership(State(node): State<Arc<HaNode>>) -> Response {
+    let latest_ts = *node.database.now_ts_for_reads();
+    let role = node.role.snapshot();
+    let lease_unverified_secs = if role.is_leader {
+        node.role.lease_unverified_secs()
+    } else {
+        None
+    };
+    let tailer_healthy = node
+        .database
+        .follower_tailer_client()
+        .await
+        .ok()
+        .map(|tailer| tailer.is_healthy());
+    axum::Json(LeadershipResponse {
+        role: role.label,
+        is_leader: role.is_leader,
+        lease_ts: role.lease_ts,
+        lease_unverified_secs,
+        latest_ts: u64::from(latest_ts),
+        tailer_healthy,
+    })
+    .into_response()
+}
+
+async fn readyz(State(node): State<Arc<HaNode>>) -> Response {
+    let healthy = match node.configured_role {
+        BackendRole::Leader => node.role.is_leader(),
+        BackendRole::Follower => !node.role.is_leader(),
+    };
+    if healthy {
+        return (StatusCode::OK, "ready").into_response();
+    }
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        "not ready for configured role",
+    )
+        .into_response()
+}
+
+async fn promote(State(node): State<Arc<HaNode>>) -> Response {
+    match node.role.begin_promotion() {
+        PromotionAttempt::AlreadyLeader => {
+            return (StatusCode::OK, "already leader").into_response();
+        },
+        PromotionAttempt::AlreadyInProgress => {
+            return (StatusCode::ACCEPTED, "promotion already in progress").into_response();
+        },
+        PromotionAttempt::Started => {},
+    }
+    let runtime = node.runtime.clone();
+    runtime.spawn_background("in_process_promotion", async move {
+        let promotion = perform_promotion(node.clone()).fuse();
+        let deadline = node.runtime.wait(PROMOTION_TIMEOUT).fuse();
+        futures::pin_mut!(promotion, deadline);
+        futures::select_biased! {
+            _ = promotion => {},
+            _ = deadline => node.role.preempt_signal.signal(anyhow::anyhow!(
+                "in-process promotion did not finish within {PROMOTION_TIMEOUT:?}"
+            )),
+        }
+    });
+    (StatusCode::ACCEPTED, "promotion started").into_response()
+}
+
+async fn perform_promotion(node: Arc<HaNode>) {
+    tracing::info!("[concave] promotion started; acquiring read-write lease");
+    let rw_persistence = match connect_rw(
+        &node.config,
+        node.runtime.clone(),
+        node.role.preempt_signal.clone(),
+    )
+    .await
+    {
+        Ok(p) => p,
+        Err(e) => {
+            tracing::warn!(
+                "[concave] promotion could not acquire the lease; staying follower: {e:#}"
+            );
+            node.role.abort_promotion();
+            return;
+        },
+    };
+    tracing::info!("[concave] promotion lease acquired; promoting in-process");
+    node.start_lease_watch(rw_persistence.clone());
+    match node.start_leader(rw_persistence).await {
+        Ok(()) => tracing::info!("[concave] promotion succeeded; now serving as leader"),
+        Err(e) => {
+            tracing::error!("[concave] promotion failed after lease acquisition: {e:#}");
+            node.role.preempt_signal.signal(anyhow::anyhow!(
+                "in-process promotion failed after acquiring the lease: {e:#}"
+            ));
+        },
+    }
+}
+
+#[derive(Deserialize)]
+struct DemoteParams {
+    lease_ts: Option<u64>,
+}
+
+async fn demote(State(node): State<Arc<HaNode>>, Query(params): Query<DemoteParams>) -> Response {
+    match node.role.check_demotion(params.lease_ts) {
+        DemotionCheck::Leader => {},
+        DemotionCheck::LeaseChanged => {
+            return (
+                StatusCode::CONFLICT,
+                "the lease changed since this demotion was decided; not demoting",
+            )
+                .into_response();
+        },
+        DemotionCheck::Follower => {
+            return (
+                StatusCode::CONFLICT,
+                "already a follower; nothing to demote",
+            )
+                .into_response();
+        },
+        DemotionCheck::Promoting => {
+            return (
+                StatusCode::CONFLICT,
+                "a promotion is in progress; retry after it completes",
+            )
+                .into_response();
+        },
+    };
+    node.role
+        .preempt_signal
+        .signal(anyhow::anyhow!("backend demoted; restarting"));
+    (StatusCode::ACCEPTED, "demotion started").into_response()
+}
