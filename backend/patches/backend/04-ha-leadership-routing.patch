+
+    async fn status_of(router: Router, method: &str, path: &str) -> StatusCode {
+        let req = http::Request::builder()
+            .method(method)
+            .uri(path)
+            .body(axum::body::Body::empty())
+            .unwrap();
+        router.oneshot(req).await.unwrap().status()
+    }
+
+    #[tokio::test]
+    async fn leader_serves_clients_and_control_plane() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let role = leader(&dir);
+        assert!(role.is_leader());
+        for (method, path) in [
+            ("POST", "/api/query"),
+            ("GET", "/instance_name"),
+            ("GET", "/instance/leadership"),
+            ("POST", "/instance/demote"),
+        ] {
+            assert_eq!(
+                status_of(gated_router(role.clone()), method, path).await,
+                StatusCode::OK,
+                "{method} {path}"
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn follower_is_gated_but_promotable() {
+        let role = follower();
+        assert_eq!(
+            status_of(gated_router(role.clone()), "POST", "/api/query").await,
+            StatusCode::MISDIRECTED_REQUEST,
+        );
+        for (method, path) in [
+            ("GET", "/"),
+            ("GET", "/instance_name"),
+            ("GET", "/instance_version"),
+            ("GET", "/instance/leadership"),
+            ("POST", "/instance/promote"),
+            ("POST", "/instance/demote"),
+        ] {
+            assert_eq!(
+                status_of(gated_router(role.clone()), method, path).await,
+                StatusCode::OK,
+                "{method} {path}"
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn demoted_leader_is_gated_then_repromotable() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let role = leader(&dir);
+        assert_eq!(
+            status_of(gated_router(role.clone()), "POST", "/api/query").await,
+            StatusCode::OK,
+        );
+        let DemotionAttempt::Started(persistence) = role.begin_demotion() else {
+            panic!("leader must be demotable");
+        };
+        assert_eq!(role.current_label(), "demoting");
+        assert!(matches!(
+            role.begin_demotion(),
+            DemotionAttempt::AlreadyInProgress
+        ));
+        role.finish_demotion();
+        assert!(!role.is_leader());
+        assert!(matches!(
+            role.begin_demotion(),
+            DemotionAttempt::AlreadyFollower
+        ));
+        assert_eq!(
+            status_of(gated_router(role.clone()), "POST", "/api/query").await,
+            StatusCode::MISDIRECTED_REQUEST,
+        );
+        assert!(matches!(role.begin_promotion(), PromotionAttempt::Started));
+        assert_eq!(role.current_label(), "promoting");
+        assert!(matches!(
+            role.begin_promotion(),
+            PromotionAttempt::AlreadyInProgress
+        ));
+        assert!(matches!(
+            role.begin_demotion(),
+            DemotionAttempt::PromotionInProgress
+        ));
+        role.lease_acquired(persistence.clone());
+        role.finish_promotion(persistence);
+        assert!(role.is_leader());
+        assert!(matches!(
+            role.begin_promotion(),
+            PromotionAttempt::AlreadyLeader
+        ));
+        assert_eq!(
+            status_of(gated_router(role), "POST", "/api/query").await,
+            StatusCode::OK,
+        );
+    }
+
+    #[test]
+    fn aborted_promotion_returns_to_follower() {
+        let role = follower();
+        assert!(matches!(role.begin_promotion(), PromotionAttempt::Started));
+        role.abort_promotion();
+        assert!(!role.is_leader());
+        assert_eq!(role.current_label(), "follower");
+        assert!(matches!(role.begin_promotion(), PromotionAttempt::Started));
+    }
+}
