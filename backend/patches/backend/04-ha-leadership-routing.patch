--- /dev/null
+++ b/crates/local_backend/src/cors.rs
@@ -0,0 +1,60 @@
+use std::sync::LazyLock;
+
+use tower_http::cors::{
+    AllowOrigin,
+    CorsLayer,
+};
+
+static LAYER: LazyLock<CorsLayer> =
+    LazyLock::new(|| restrict_origins(crate::router::upstream_cors()));
+
+pub fn layer() -> CorsLayer {
+    LAYER.clone()
+}
+
+fn allowed_origins() -> Vec<http::HeaderValue> {
+    let Ok(raw) = std::env::var("CONVEX_ALLOWED_ORIGINS") else {
+        return Vec::new();
+    };
+    raw.split(',')
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .filter_map(|s| match url::Url::parse(s) {
+            Ok(url)
+                if matches!(url.scheme(), "http" | "https")
+                    && url.path() == "/"
+                    && url.query().is_none()
+                    && url.fragment().is_none() =>
+            {
+                url.origin()
+                    .ascii_serialization()
+                    .parse::<http::HeaderValue>()
+                    .ok()
+            },
+            Ok(_) => {
+                tracing::warn!("[concave] skipping invalid CONVEX_ALLOWED_ORIGINS entry {s:?}");
+                None
+            },
+            Err(e) => {
+                tracing::warn!(
+                    "[concave] skipping invalid CONVEX_ALLOWED_ORIGINS entry {s:?}: {e}"
+                );
+                None
+            },
+        })
+        .collect()
+}
+
+fn restrict_origins(layer: CorsLayer) -> CorsLayer {
+    let allowed = allowed_origins();
+    if allowed.is_empty() {
+        tracing::warn!(
+            "[concave] CONVEX_ALLOWED_ORIGINS unset; CORS responses will include no \
+             Access-Control-Allow-Origin header"
+        );
+        return layer
+            .allow_credentials(false)
+            .allow_origin(AllowOrigin::list(Vec::<http::HeaderValue>::new()));
+    }
+    layer.allow_origin(AllowOrigin::list(allowed))
+}
