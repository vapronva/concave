+        String::from_utf8(bytes.to_vec()).unwrap()
+    }
+
+    #[tokio::test]
+    async fn follower_gates_everything_but_the_exempt_paths() {
+        let service = admitted(
+            follower_routes("instance".to_string()),
+            "test_follower_gate",
+            16,
+            control(),
+        );
+        let gated = service
+            .clone()
+            .oneshot(request("POST", "/api/query"))
+            .await
+            .unwrap();
+        assert_eq!(gated.status(), StatusCode::MISDIRECTED_REQUEST);
+        assert_eq!(
+            gated
+                .headers()
+                .get(FOLLOWER_GATE_HEADER)
+                .map(|v| v.as_bytes()),
+            Some(b"1".as_slice()),
+        );
+        for (method, path) in [
+            ("GET", "/"),
+            ("GET", "/instance_name"),
+            ("GET", "/instance_version"),
+            ("GET", "/version"),
+            ("GET", "/readyz"),
+            ("POST", "/instance/promote"),
+        ] {
+            let response = service
+                .clone()
+                .oneshot(request(method, path))
+                .await
+                .unwrap();
+            assert_eq!(response.status(), StatusCode::OK, "{method} {path}");
+        }
+    }
+
+    #[tokio::test]
+    async fn control_routes_bypass_admission() {
+        let entered = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let held = Router::new().route(
+            "/hold",
+            get({
+                let entered = entered.clone();
+                let release = release.clone();
+                move || async move {
+                    entered.notify_one();
+                    release.notified().await;
+                    "held"
+                }
+            }),
+        );
+        let service = admitted(held, "test_admission", 1, control());
+        let holder = tokio::spawn(service.clone().oneshot(request("GET", "/hold")));
+        entered.notified().await;
+        let ready = tokio::time::timeout(
+            Duration::from_secs(5),
+            service.clone().oneshot(request("GET", "/readyz")),
+        )
+        .await
+        .expect("a control route waited behind the concurrency limit")
+        .unwrap();
+        assert_eq!(ready.status(), StatusCode::OK);
+        let queued = tokio::time::timeout(
+            Duration::from_millis(200),
+            service.clone().oneshot(request("GET", "/hold")),
+        )
+        .await;
+        assert!(queued.is_err(), "the limiter admitted a second request");
+        release.notify_one();
+        assert_eq!(holder.await.unwrap().unwrap().status(), StatusCode::OK);
+    }
+
+    #[tokio::test]
+    async fn role_router_switches_on_the_next_request_of_a_connection() {
+        let leader = Arc::new(OnceLock::new());
+        let mut connection = RoleRouter {
+            follower: Router::new().fallback(|| async { "follower" }),
+            leader: leader.clone(),
+        };
+        let before = connection
+            .ready()
+            .await
+            .unwrap()
+            .call(request("GET", "/api/query"))
+            .await
+            .unwrap();
+        assert_eq!(text(before).await, "follower");
+        assert!(leader
+            .set(Router::new().fallback(|| async { "leader" }))
+            .is_ok());
+        let after = connection
+            .ready()
+            .await
+            .unwrap()
+            .call(request("GET", "/api/query"))
+            .await
+            .unwrap();
+        assert_eq!(text(after).await, "leader");
+    }
+
+    #[tokio::test]
+    async fn demotion_is_compared_against_the_current_lease() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let path = dir.path().join("role.sqlite3");
+        let persistence: Arc<dyn Persistence> =
+            Arc::new(sqlite::SqlitePersistence::new(path.to_str().unwrap()).unwrap());
+        let role = RoleState::new(ShutdownSignal::panic());
+        assert!(matches!(role.check_demotion(None), DemotionCheck::Follower));
+        role.install(persistence);
+        assert!(matches!(
+            role.check_demotion(Some(7)),
+            DemotionCheck::LeaseChanged
+        ));
+        assert!(matches!(role.check_demotion(None), DemotionCheck::Leader));
+        assert!(matches!(
+            role.begin_promotion(),
+            PromotionAttempt::AlreadyLeader
+        ));
+    }
+}
