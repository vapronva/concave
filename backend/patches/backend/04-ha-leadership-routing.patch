+use tower_http::cors::{
+    AllowOrigin,
+    CorsLayer,
+};
+
+fn dashboard_origins() -> Vec<http::HeaderValue> {
+    let Ok(raw) = std::env::var("CONVEX_DASHBOARD_ORIGIN") else {
+        return Vec::new();
+    };
+    raw.split(',')
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .filter_map(|s| match url::Url::parse(s) {
+            Ok(url)
+                if matches!(url.scheme(), "http" | "https")
+                    && url.path() == "/"
+                    && url.query().is_none()
+                    && url.fragment().is_none() =>
+            {
+                url.origin()
+                    .ascii_serialization()
+                    .parse::<http::HeaderValue>()
+                    .ok()
+            },
+            Ok(_) => {
+                tracing::warn!("[concave] skipping invalid CONVEX_DASHBOARD_ORIGIN entry {s:?}");
+                None
+            },
+            Err(e) => {
+                tracing::warn!(
+                    "[concave] skipping invalid CONVEX_DASHBOARD_ORIGIN entry {s:?}: {e}"
+                );
+                None
+            },
+        })
+        .collect()
+}
+
+pub fn restrict_origins(layer: CorsLayer) -> CorsLayer {
+    let allowed = dashboard_origins();
+    if allowed.is_empty() {
+        tracing::warn!(
+            "[concave] CONVEX_DASHBOARD_ORIGIN unset; CORS responses will include no \
+             Access-Control-Allow-Origin header"
+        );
+        return layer.allow_origin(AllowOrigin::list(Vec::<http::HeaderValue>::new()));
+    }
+    layer
+        .allow_credentials(true)
+        .allow_origin(AllowOrigin::list(allowed))
+}
