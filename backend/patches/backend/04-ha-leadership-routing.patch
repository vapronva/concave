+
+const CONTROL_PLANE_TOKEN_HEADER: &str = "X-Convex-Control-Plane-Token";
+const FOLLOWER_GATE_HEADER: &str = "X-Concave-Follower-Gate";
+
+pub enum RolePersistence {
+    Leader(Arc<dyn Persistence>),
+    Follower(Arc<dyn PersistenceReader>),
+}
+
+impl RolePersistence {
+    pub fn reader(&self) -> Arc<dyn PersistenceReader> {
+        match self {
+            RolePersistence::Leader(p) => p.reader(),
+            RolePersistence::Follower(r) => r.clone(),
+        }
+    }
+
+    pub fn as_persistence(&self) -> Option<Arc<dyn Persistence>> {
+        match self {
+            RolePersistence::Leader(p) => Some(p.clone()),
+            RolePersistence::Follower(_) => None,
+        }
+    }
+
+    pub fn boot_role(&self) -> BackendRole {
+        match self {
+            RolePersistence::Leader(_) => BackendRole::Leader,
+            RolePersistence::Follower(_) => BackendRole::Follower,
+        }
+    }
+}
+
+enum Role {
+    Follower,
+    Promoting(Option<Arc<dyn Persistence>>),
+    Leader(Arc<dyn Persistence>),
+    Demoting(Arc<dyn Persistence>),
+}
+
+pub struct RoleState {
+    role: parking_lot::Mutex<Role>,
+    pub preempt_signal: ShutdownSignal,
+}
+
+enum PromotionAttempt {
+    Started,
+    AlreadyInProgress,
+    AlreadyLeader,
+    DemotionInProgress,
+}
+
+pub(crate) enum DemotionAttempt {
+    Started(Arc<dyn Persistence>),
+    AlreadyInProgress,
+    AlreadyFollower,
+    PromotionInProgress,
+}
+
+impl RoleState {
+    pub fn new(
+        rw_persistence: Option<Arc<dyn Persistence>>,
+        preempt_signal: ShutdownSignal,
+    ) -> Self {
+        let role = match rw_persistence {
+            Some(persistence) => Role::Leader(persistence),
+            None => Role::Follower,
+        };
+        Self {
+            role: parking_lot::Mutex::new(role),
+            preempt_signal,
+        }
+    }
+
+    pub fn current_label(&self) -> &'static str {
+        match &*self.role.lock() {
+            Role::Follower => "follower",
+            Role::Promoting(_) => "promoting",
+            Role::Leader(_) => "leader",
+            Role::Demoting(_) => "demoting",
+        }
+    }
+
+    pub fn is_leader(&self) -> bool {
+        matches!(&*self.role.lock(), Role::Leader(_))
+    }
+
+    pub fn rw_persistence(&self) -> Option<Arc<dyn Persistence>> {
+        match &*self.role.lock() {
+            Role::Leader(persistence) => Some(persistence.clone()),
+            _ => None,
+        }
+    }
+
+    pub fn lease_ts(&self) -> Option<u64> {
+        match &*self.role.lock() {
+            Role::Follower | Role::Promoting(None) => None,
+            Role::Promoting(Some(persistence))
+            | Role::Leader(persistence)
+            | Role::Demoting(persistence) => persistence.lease_ts(),
+        }
+    }
+
+    fn begin_promotion(&self) -> PromotionAttempt {
+        let mut role = self.role.lock();
+        match &*role {
+            Role::Follower => {},
+            Role::Promoting(_) => return PromotionAttempt::AlreadyInProgress,
+            Role::Leader(_) => return PromotionAttempt::AlreadyLeader,
+            Role::Demoting(_) => return PromotionAttempt::DemotionInProgress,
+        }
+        *role = Role::Promoting(None);
+        PromotionAttempt::Started
+    }
+
+    fn lease_acquired(&self, persistence: Arc<dyn Persistence>) {
+        *self.role.lock() = Role::Promoting(Some(persistence));
+    }
+
+    fn finish_promotion(&self, persistence: Arc<dyn Persistence>) {
+        *self.role.lock() = Role::Leader(persistence);
+    }
+
+    fn abort_promotion(&self) {
+        *self.role.lock() = Role::Follower;
+    }
+
+    pub(crate) fn begin_demotion(&self) -> DemotionAttempt {
+        let mut role = self.role.lock();
+        let persistence = match &*role {
+            Role::Leader(persistence) => persistence.clone(),
+            Role::Demoting(_) => return DemotionAttempt::AlreadyInProgress,
+            Role::Promoting(_) => return DemotionAttempt::PromotionInProgress,
+            Role::Follower => return DemotionAttempt::AlreadyFollower,
+        };
+        *role = Role::Demoting(persistence.clone());
+        DemotionAttempt::Started(persistence)
+    }
+
+    pub(crate) fn finish_demotion(&self) {
+        *self.role.lock() = Role::Follower;
+    }
+}
+
+pub type PersistenceFactory =
+    Arc<dyn Fn() -> BoxFuture<'static, anyhow::Result<Arc<dyn Persistence>>> + Send + Sync>;
+
+pub struct PromoteContext {
+    pub persistence_factory: PersistenceFactory,
+    pub retention_rate_limiter: Arc<RateLimiter<ProdRuntime>>,
+}
+
+pub fn promote_context(
+    config: &LocalConfig,
+    runtime: ProdRuntime,
+    preempt: ShutdownSignal,
+) -> Arc<PromoteContext> {
+    let db = config.db;
+    let db_spec = config.db_spec.clone();
+    let require_ssl = !config.do_not_require_ssl;
+    let name = config.name();
+    let factory_runtime = runtime.clone();
+    let persistence_factory: PersistenceFactory = Arc::new(move || {
+        let db_spec = db_spec.clone();
+        let name = name.clone();
+        let runtime = factory_runtime.clone();
+        let preempt = preempt.clone();
+        Box::pin(async move {
+            let persistence = connect_persistence(
+                db,
+                &db_spec,
+                ConnectPersistenceFlags {
+                    require_ssl,
+                    allow_read_only: false,
+                    skip_index_creation: false,
+                },
+                &name,
+                None,
+                runtime,
+                preempt,
+            )
+            .await?;
+            anyhow::ensure!(
+                persistence.supports_lease(),
+                "HA promotion requires a lease-capable persistence backend (Postgres); this \
+                 backend does not support the lease primitive, so single-writer fencing would be \
+                 a no-op"
+            );
+            Ok(persistence)
+        })
+    });
+    Arc::new(PromoteContext {
+        persistence_factory,
+        retention_rate_limiter: Arc::new(new_rate_limiter(
+            runtime,
+            Quota::per_second(*DOCUMENT_RETENTION_RATE_LIMIT),
+        )),
+    })
+}
+
+pub fn control_plane_token_from_env() -> Option<Arc<String>> {
+    let token = std::env::var("CONVEX_CONTROL_PLANE_TOKEN")
+        .ok()
+        .filter(|t| !t.is_empty())
+        .map(Arc::new);
+    if token.is_some() {
+        tracing::info!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN set; /instance/promote and /instance/demote \
+             require the X-Convex-Control-Plane-Token header"
+        );
+    } else {
+        tracing::warn!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN is unset; all /instance control-plane requests \
+             will be rejected"
+        );
+    }
+    token
+}
+
+pub fn install_boot_lease_watch(st: &LocalAppState) {
+    let Some(rw_persistence) = st.role.rw_persistence() else {
+        return;
+    };
+    if !rw_persistence.supports_lease() {
+        tracing::info!("[concave] no lease primitive; skipping lease-watch (commit-time fencing)");
+        return;
+    }
+    install_lease_lost_handler(st);
+    st.application
+        .database()
+        .spawn_lease_watch(rw_persistence, st.role.preempt_signal.clone());
+}
+
+fn reject_unauthorized_control_plane(
+    control_plane_token: &Option<Arc<String>>,
+    headers: &http::HeaderMap,
+) -> Option<Response> {
+    let Some(expected) = control_plane_token.as_ref() else {
+        return Some(
+            (
+                StatusCode::FORBIDDEN,
+                "Control plane is disabled because CONVEX_CONTROL_PLANE_TOKEN is unset.",
+            )
+                .into_response(),
+        );
+    };
+    let presented = headers
+        .get(CONTROL_PLANE_TOKEN_HEADER)
+        .map(|v| v.as_bytes())
+        .unwrap_or_default();
+    if keybroker::constant_time_eq_sha256(presented, expected.as_bytes()) {
+        return None;
+    }
+    Some(
+        (
+            StatusCode::FORBIDDEN,
+            "Missing or invalid X-Convex-Control-Plane-Token.",
+        )
+            .into_response(),
+    )
+}
+
+#[derive(Serialize)]
+pub struct LeadershipResponse {
+    pub role: String,
+    pub is_leader: bool,
+    pub lease_ts: Option<u64>,
+    pub lease_unverified_secs: Option<u64>,
+    pub latest_ts: u64,
+}
+
+pub async fn leadership(MtState(st): MtState<LocalAppState>) -> Response {
+    let latest_ts: Timestamp = *st.application.now_ts_for_reads();
+    let is_leader = st.role.is_leader();
+    let lease_unverified_secs = if is_leader {
+        st.application.database().lease_unverified_secs()
+    } else {
+        None
+    };
+    axum::Json(LeadershipResponse {
+        role: st.role.current_label().to_string(),
+        is_leader,
+        lease_ts: st.role.lease_ts(),
+        lease_unverified_secs,
+        latest_ts: u64::from(latest_ts),
+    })
+    .into_response()
+}
+
+pub async fn readyz<S>(MtState(st): MtState<LocalAppState>) -> Response
+where
+    LocalAppState: FromMtState<S>,
+{
+    let healthy = match st.configured_role {
+        BackendRole::Leader => st.role.is_leader(),
+        BackendRole::Follower => !st.role.is_leader(),
+    };
+    if healthy {
+        return (StatusCode::OK, "ready").into_response();
+    }
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        "not ready for configured role",
+    )
+        .into_response()
+}
+
+#[derive(Serialize)]
+pub struct RoleResponse {
+    pub role: String,
+    pub is_leader: bool,
+    pub message: String,
+}
+
+fn role_response(status: StatusCode, role: BackendRole, message: &str) -> Response {
+    (
+        status,
+        axum::Json(RoleResponse {
+            role: role.as_str().to_string(),
+            is_leader: role.is_leader(),
+            message: message.to_string(),
+        }),
+    )
+        .into_response()
+}
+
+pub async fn promote(MtState(st): MtState<LocalAppState>) -> Response {
+    match st.role.begin_promotion() {
+        PromotionAttempt::AlreadyLeader => {
+            return role_response(StatusCode::OK, BackendRole::Leader, "already leader");
+        },
+        PromotionAttempt::AlreadyInProgress => {
+            return role_response(
+                StatusCode::ACCEPTED,
+                BackendRole::Follower,
+                "promotion already in progress",
+            );
+        },
+        PromotionAttempt::DemotionInProgress => {
+            return role_response(
+                StatusCode::CONFLICT,
+                BackendRole::Follower,
+                "a demotion is in progress; retry after it completes",
+            );
+        },
+        PromotionAttempt::Started => {},
+    }
+    let promote_ctx = st.promote_ctx.clone();
+    st.application
+        .runtime()
+        .spawn_background("in_process_promotion", async move {
+            perform_promotion(st, promote_ctx).await;
+        });
+    role_response(
+        StatusCode::ACCEPTED,
+        BackendRole::Follower,
+        "promotion started",
+    )
+}
+
+async fn perform_promotion(st: LocalAppState, promote_ctx: Arc<PromoteContext>) {
+    tracing::info!("[concave] promotion started; acquiring read-write lease");
+    let rw_persistence = match (promote_ctx.persistence_factory)().await {
+        Ok(p) => p,
+        Err(e) => {
+            tracing::warn!("[concave] promotion lease acquisition failed; staying follower: {e:#}");
+            st.role.abort_promotion();
+            return;
+        },
+    };
+    tracing::info!("[concave] promotion lease acquired; promoting in-process");
+    st.role.lease_acquired(rw_persistence.clone());
+    install_lease_lost_handler(&st);
+    match st
+        .application
+        .become_leader(
+            rw_persistence.clone(),
+            promote_ctx.retention_rate_limiter.clone(),
+            st.role.preempt_signal.clone(),
+        )
+        .await
+    {
+        Ok(()) => {
+            st.role.finish_promotion(rw_persistence);
+            tracing::info!("[concave] promotion succeeded; now serving as leader");
+        },
+        Err(e) => {
+            tracing::error!("[concave] promotion failed after lease acquisition: {e:#}");
+            st.role.preempt_signal.signal(anyhow::anyhow!(
+                "in-process promotion failed after acquiring the lease: {e:#}"
+            ));
+        },
+    }
+}
+
+pub async fn demote(MtState(st): MtState<LocalAppState>) -> Response {
+    let rw_persistence = match st.role.begin_demotion() {
+        DemotionAttempt::Started(rw_persistence) => rw_persistence,
+        DemotionAttempt::AlreadyFollower => {
+            return role_response(
+                StatusCode::CONFLICT,
+                BackendRole::Follower,
+                "already a follower; nothing to demote",
+            );
+        },
+        DemotionAttempt::AlreadyInProgress => {
+            return role_response(
+                StatusCode::CONFLICT,
+                BackendRole::Follower,
+                "demotion already in progress",
+            );
+        },
+        DemotionAttempt::PromotionInProgress => {
+            return role_response(
+                StatusCode::CONFLICT,
+                BackendRole::Follower,
+                "a promotion is in progress; retry after it completes",
+            );
+        },
+    };
+    st.application.database().stop_lease_watch();
+    st.application
+        .runtime()
+        .spawn_background("in_process_demotion", async move {
+            tracing::info!("[concave] demotion started; stepping down in-process");
+            match step_down(&st, rw_persistence).await {
+                Ok(()) => tracing::info!("[concave] demotion succeeded; now a warm follower"),
+                Err(e) => {
+                    tracing::error!(
+                        "[concave] demotion FAILED (firing preempt, restart-as-follower): {e:#}"
+                    );
+                    st.role
+                        .preempt_signal
+                        .signal(anyhow::anyhow!("in-process demotion failed: {e:#}"));
+                },
+            }
+        });
+    role_response(
+        StatusCode::ACCEPTED,
+        BackendRole::Follower,
+        "demotion started",
+    )
+}
+
+async fn step_down(st: &LocalAppState, rw_persistence: Arc<dyn Persistence>) -> anyhow::Result<()> {
+    st.application.become_follower(rw_persistence).await?;
+    st.role.finish_demotion();
+    Ok(())
+}
+
+pub(crate) fn install_lease_lost_handler(st: &LocalAppState) {
+    let state = st.clone();
+    let handler: database::LeaseLostHandler = Arc::new(move || {
+        let st = state.clone();
+        Box::pin(async move {
+            let rw_persistence = match st.role.begin_demotion() {
+                DemotionAttempt::Started(rw_persistence) => rw_persistence,
+                DemotionAttempt::AlreadyFollower | DemotionAttempt::AlreadyInProgress => {
+                    return true;
+                },
+                DemotionAttempt::PromotionInProgress => return false,
+            };
+            match step_down(&st, rw_persistence).await {
+                Ok(()) => {
+                    tracing::info!("[concave] in-process self-demote SUCCESS; now a warm follower");
+                    true
+                },
+                Err(e) => {
+                    tracing::error!("[concave] in-process self-demote failed: {e:#}");
+                    false
+                },
+            }
+        })
+    });
+    st.application.database().set_lease_lost_handler(handler);
+}
+
+async fn control_plane_gate(
+    axum::extract::State(control_plane_token): axum::extract::State<Option<Arc<String>>>,
+    headers: http::HeaderMap,
+    req: Request<Body>,
+    next: Next,
+) -> Response {
+    if let Some(rejection) = reject_unauthorized_control_plane(&control_plane_token, &headers) {
+        return rejection;
+    }
+    next.run(req).await
+}
+
+pub fn leadership_routes(control_plane_token: Option<Arc<String>>) -> Router<LocalAppState> {
+    let control = Router::new()
+        .route("/instance/promote", post(promote))
+        .route("/instance/demote", post(demote))
+        .layer(axum::middleware::from_fn_with_state(
+            control_plane_token,
+            control_plane_gate,
+        ));
+    Router::new()
+        .route("/instance/leadership", get(leadership))
+        .merge(control)
+}
+
+pub fn follower_router(st: LocalAppState) -> Router {
+    let role = st.role.clone();
+    crate::router::router(st).layer(axum::middleware::from_fn_with_state(role, role_gate))
+}
+
+fn is_gate_exempt(path: &str) -> bool {
+    matches!(
+        path,
+        "/" | "/readyz"
+            | "/instance/leadership"
+            | "/instance/promote"
+            | "/instance/demote"
+            | "/instance_name"
+            | "/instance_version"
+    )
+}
+
+async fn role_gate(
+    axum::extract::State(role): axum::extract::State<Arc<RoleState>>,
+    req: Request<Body>,
+    next: Next,
+) -> Response {
+    if role.is_leader() || is_gate_exempt(req.uri().path()) {
+        return next.run(req).await;
+    }
+    (
+        StatusCode::MISDIRECTED_REQUEST,
+        [(FOLLOWER_GATE_HEADER, "1")],
+        "This backend is a follower (warm standby) and does not serve client traffic. Route to \
+         the leader (or POST /instance/promote to promote it).",
+    )
+        .into_response()
+}
