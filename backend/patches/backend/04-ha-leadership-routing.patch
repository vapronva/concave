@@ -0,0 +1,616 @@
+use std::sync::Arc;
+
+use axum::{
+    body::Body,
+    extract::{
+        Query,
+        Request,
+    },
+    middleware::Next,
+    response::{
+        IntoResponse,
+        Response,
+    },
+    routing::{
+        get,
+        post,
+    },
+    Router,
+};
+use common::{
+    http::extract::{
+        FromMtState,
+        MtState,
+    },
+    knobs::PROMOTION_TIMEOUT,
+    persistence::{
+        Persistence,
+        PersistenceReader,
+    },
+    runtime::Runtime,
+    shutdown::ShutdownSignal,
+    types::{
+        BackendRole,
+        Timestamp,
+    },
+};
+use db_connection::{
+    connect_persistence,
+    ConnectPersistenceFlags,
+};
+use futures::{
+    future::BoxFuture,
+    FutureExt,
+};
+use http::StatusCode;
+use runtime::prod::ProdRuntime;
+use serde::{
+    Deserialize,
+    Serialize,
+};
+
+use crate::{
+    config::LocalConfig,
+    LocalAppState,
+};
+
+const CONTROL_PLANE_TOKEN_HEADER: &str = "X-Convex-Control-Plane-Token";
+const FOLLOWER_GATE_HEADER: &str = "X-Concave-Follower-Gate";
+
+pub enum RolePersistence {
+    Leader(Arc<dyn Persistence>),
+    Follower(Arc<dyn PersistenceReader>),
+}
+
+impl RolePersistence {
+    pub fn reader(&self) -> Arc<dyn PersistenceReader> {
+        match self {
+            RolePersistence::Leader(p) => p.reader(),
+            RolePersistence::Follower(r) => r.clone(),
+        }
+    }
+
+    pub fn as_persistence(&self) -> Option<Arc<dyn Persistence>> {
+        match self {
+            RolePersistence::Leader(p) => Some(p.clone()),
+            RolePersistence::Follower(_) => None,
+        }
+    }
+
+    pub fn boot_role(&self) -> BackendRole {
+        match self {
+            RolePersistence::Leader(_) => BackendRole::Leader,
+            RolePersistence::Follower(_) => BackendRole::Follower,
+        }
+    }
+}
+
+enum Role {
+    Follower,
+    Promoting(Option<Arc<dyn Persistence>>),
+    Leader(Arc<dyn Persistence>),
+}
+
+pub struct RoleState {
+    role: parking_lot::Mutex<Role>,
+    pub preempt_signal: ShutdownSignal,
+}
+
+enum PromotionAttempt {
+    Started,
+    AlreadyInProgress,
+    AlreadyLeader,
+}
+
+pub(crate) enum DemotionCheck {
+    Leader,
+    Follower,
+    Promoting,
+    LeaseChanged,
+}
+
+pub struct RoleSnapshot {
+    pub label: &'static str,
+    pub is_leader: bool,
+    pub lease_ts: Option<u64>,
+}
+
+impl RoleState {
+    pub fn new(
+        rw_persistence: Option<Arc<dyn Persistence>>,
+        preempt_signal: ShutdownSignal,
+    ) -> Self {
+        let role = match rw_persistence {
+            Some(persistence) => Role::Leader(persistence),
+            None => Role::Follower,
+        };
+        Self {
+            role: parking_lot::Mutex::new(role),
+            preempt_signal,
+        }
+    }
+
+    pub fn snapshot(&self) -> RoleSnapshot {
+        let role = self.role.lock();
+        let (label, lease_ts) = match &*role {
+            Role::Follower => ("follower", None),
+            Role::Promoting(None) => ("promoting", None),
+            Role::Promoting(Some(persistence)) => ("promoting", persistence.lease_ts()),
+            Role::Leader(persistence) => ("leader", persistence.lease_ts()),
+        };
+        RoleSnapshot {
+            label,
+            is_leader: matches!(&*role, Role::Leader(_)),
+            lease_ts,
+        }
+    }
+
+    pub fn is_leader(&self) -> bool {
+        matches!(&*self.role.lock(), Role::Leader(_))
+    }
+
+    pub fn rw_persistence(&self) -> Option<Arc<dyn Persistence>> {
+        match &*self.role.lock() {
+            Role::Leader(persistence) => Some(persistence.clone()),
+            _ => None,
+        }
+    }
+
+    fn begin_promotion(&self) -> PromotionAttempt {
+        let mut role = self.role.lock();
+        match &*role {
+            Role::Follower => {},
+            Role::Promoting(_) => return PromotionAttempt::AlreadyInProgress,
+            Role::Leader(_) => return PromotionAttempt::AlreadyLeader,
+        }
+        *role = Role::Promoting(None);
+        PromotionAttempt::Started
+    }
+
+    fn lease_acquired(&self, persistence: Arc<dyn Persistence>) {
+        *self.role.lock() = Role::Promoting(Some(persistence));
+    }
+
+    fn finish_promotion(&self, persistence: Arc<dyn Persistence>) {
+        *self.role.lock() = Role::Leader(persistence);
+    }
+
+    fn abort_promotion(&self) {
+        *self.role.lock() = Role::Follower;
+    }
+
+    pub(crate) fn check_demotion(&self, expected_lease_ts: Option<u64>) -> DemotionCheck {
+        let persistence = match &*self.role.lock() {
+            Role::Leader(persistence) => persistence.clone(),
+            Role::Promoting(_) => return DemotionCheck::Promoting,
+            Role::Follower => return DemotionCheck::Follower,
+        };
+        if expected_lease_ts.is_some_and(|expected| persistence.lease_ts() != Some(expected)) {
+            return DemotionCheck::LeaseChanged;
+        }
+        DemotionCheck::Leader
+    }
+}
+
+pub type PersistenceFactory =
+    Arc<dyn Fn() -> BoxFuture<'static, anyhow::Result<Arc<dyn Persistence>>> + Send + Sync>;
+
+pub fn persistence_factory(
+    config: &LocalConfig,
+    runtime: ProdRuntime,
+    preempt: ShutdownSignal,
+) -> PersistenceFactory {
+    let db = config.db;
+    let db_spec = config.db_spec.clone();
+    let require_ssl = !config.do_not_require_ssl;
+    let name = config.name();
+    let factory_runtime = runtime.clone();
+    Arc::new(move || {
+        let db_spec = db_spec.clone();
+        let name = name.clone();
+        let runtime = factory_runtime.clone();
+        let preempt = preempt.clone();
+        Box::pin(async move {
+            let persistence = connect_persistence(
+                db,
+                &db_spec,
+                ConnectPersistenceFlags {
+                    require_ssl,
+                    allow_read_only: false,
+                    skip_index_creation: false,
+                },
+                &name,
+                None,
+                runtime,
+                preempt,
+            )
+            .await?;
+            anyhow::ensure!(
+                persistence.supports_lease(),
+                "HA promotion requires a lease-capable persistence backend (Postgres); this \
+                 backend does not support the lease primitive, so single-writer fencing would be \
+                 a no-op"
+            );
+            Ok(persistence)
+        })
+    })
+}
+
+pub fn control_plane_token_from_env() -> Option<Arc<String>> {
+    let token = std::env::var("CONVEX_CONTROL_PLANE_TOKEN")
+        .ok()
+        .filter(|t| !t.is_empty())
+        .map(Arc::new);
+    if token.is_some() {
+        tracing::info!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN set; /instance/promote and /instance/demote \
+             require the X-Convex-Control-Plane-Token header"
+        );
+    } else {
+        tracing::warn!(
+            "[concave] CONVEX_CONTROL_PLANE_TOKEN is unset; all /instance control-plane requests \
+             will be rejected"
+        );
+    }
+    token
+}
+
+pub fn install_boot_lease_watch(st: &LocalAppState) {
+    let Some(rw_persistence) = st.role.rw_persistence() else {
+        return;
+    };
+    if !rw_persistence.supports_lease() {
+        tracing::info!("[concave] no lease primitive; skipping lease-watch (commit-time fencing)");
+        return;
+    }
+    st.application
+        .database()
+        .spawn_lease_watch(rw_persistence, st.role.preempt_signal.clone());
+}
+
+fn reject_unauthorized_control_plane(
+    control_plane_token: &Option<Arc<String>>,
+    headers: &http::HeaderMap,
+) -> Option<Response> {
+    let Some(expected) = control_plane_token.as_ref() else {
+        return Some(
+            (
+                StatusCode::FORBIDDEN,
+                "Control plane is disabled because CONVEX_CONTROL_PLANE_TOKEN is unset.",
+            )
+                .into_response(),
+        );
+    };
+    let presented = headers
+        .get(CONTROL_PLANE_TOKEN_HEADER)
+        .map(|v| v.as_bytes())
+        .unwrap_or_default();
+    if keybroker::constant_time_eq_sha256(presented, expected.as_bytes()) {
+        return None;
+    }
+    Some(
+        (
+            StatusCode::FORBIDDEN,
+            "Missing or invalid X-Convex-Control-Plane-Token.",
+        )
+            .into_response(),
+    )
+}
+
+#[derive(Serialize)]
+pub struct LeadershipResponse {
+    pub role: String,
+    pub is_leader: bool,
+    pub lease_ts: Option<u64>,
+    pub lease_unverified_secs: Option<u64>,
+    pub latest_ts: u64,
+}
+
+pub async fn leadership(MtState(st): MtState<LocalAppState>) -> Response {
+    let latest_ts: Timestamp = *st.application.now_ts_for_reads();
+    let role = st.role.snapshot();
+    let lease_unverified_secs = if role.is_leader {
+        st.application.database().lease_unverified_secs()
+    } else {
+        None
+    };
+    axum::Json(LeadershipResponse {
+        role: role.label.to_string(),
+        is_leader: role.is_leader,
+        lease_ts: role.lease_ts,
+        lease_unverified_secs,
+        latest_ts: u64::from(latest_ts),
+    })
+    .into_response()
+}
+
+pub async fn readyz<S>(MtState(st): MtState<LocalAppState>) -> Response
+where
+    LocalAppState: FromMtState<S>,
+{
+    let healthy = match st.configured_role {
+        BackendRole::Leader => st.role.is_leader(),
+        BackendRole::Follower => !st.role.is_leader(),
+    };
+    if healthy {
+        return (StatusCode::OK, "ready").into_response();
+    }
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        "not ready for configured role",
+    )
+        .into_response()
+}
+
+pub async fn promote(MtState(st): MtState<LocalAppState>) -> Response {
+    match st.role.begin_promotion() {
+        PromotionAttempt::AlreadyLeader => {
+            return (StatusCode::OK, "already leader").into_response();
+        },
+        PromotionAttempt::AlreadyInProgress => {
+            return (StatusCode::ACCEPTED, "promotion already in progress").into_response();
+        },
+        PromotionAttempt::Started => {},
+    }
+    st.application
+        .runtime()
+        .spawn_background("in_process_promotion", async move {
+            let budget = *PROMOTION_TIMEOUT;
+            let promotion = perform_promotion(st.clone()).fuse();
+            let deadline = st.application.runtime().wait(budget).fuse();
+            futures::pin_mut!(promotion, deadline);
+            futures::select_biased! {
+                _ = promotion => {},
+                _ = deadline => st.role.preempt_signal.signal(anyhow::anyhow!(
+                    "in-process promotion did not finish within {budget:?}"
+                )),
+            }
+        });
+    (StatusCode::ACCEPTED, "promotion started").into_response()
+}
+
+async fn perform_promotion(st: LocalAppState) {
+    tracing::info!("[concave] promotion started; acquiring read-write lease");
+    let rw_persistence = match (st.persistence_factory)().await {
+        Ok(p) => p,
+        Err(e) => {
+            tracing::warn!("[concave] promotion lease acquisition failed; staying follower: {e:#}");
+            st.role.abort_promotion();
+            return;
+        },
+    };
+    tracing::info!("[concave] promotion lease acquired; promoting in-process");
+    st.role.lease_acquired(rw_persistence.clone());
+    match st
+        .application
+        .become_leader(rw_persistence.clone(), st.role.preempt_signal.clone())
+        .await
+    {
+        Ok(()) => {
+            st.role.finish_promotion(rw_persistence);
+            tracing::info!("[concave] promotion succeeded; now serving as leader");
+        },
+        Err(e) => {
+            tracing::error!("[concave] promotion failed after lease acquisition: {e:#}");
+            st.role.preempt_signal.signal(anyhow::anyhow!(
+                "in-process promotion failed after acquiring the lease: {e:#}"
+            ));
+        },
+    }
+}
+
+#[derive(Deserialize)]
+pub struct DemoteParams {
+    lease_ts: Option<u64>,
+}
+
+pub async fn demote(
+    MtState(st): MtState<LocalAppState>,
+    Query(params): Query<DemoteParams>,
+) -> Response {
+    match st.role.check_demotion(params.lease_ts) {
+        DemotionCheck::Leader => {},
+        DemotionCheck::LeaseChanged => {
+            return (
+                StatusCode::CONFLICT,
+                "the lease changed since this demotion was decided; not demoting",
+            )
+                .into_response();
+        },
+        DemotionCheck::Follower => {
+            return (
+                StatusCode::CONFLICT,
+                "already a follower; nothing to demote",
+            )
+                .into_response();
+        },
+        DemotionCheck::Promoting => {
+            return (
+                StatusCode::CONFLICT,
+                "a promotion is in progress; retry after it completes",
+            )
+                .into_response();
+        },
+    };
+    st.role
+        .preempt_signal
+        .signal(anyhow::anyhow!("backend demoted; restarting"));
+    (StatusCode::ACCEPTED, "demotion started").into_response()
+}
+
+async fn control_plane_gate(
+    axum::extract::State(control_plane_token): axum::extract::State<Option<Arc<String>>>,
+    headers: http::HeaderMap,
+    req: Request<Body>,
+    next: Next,
+) -> Response {
+    if let Some(rejection) = reject_unauthorized_control_plane(&control_plane_token, &headers) {
+        return rejection;
+    }
+    next.run(req).await
+}
+
+pub fn leadership_routes(control_plane_token: Option<Arc<String>>) -> Router<LocalAppState> {
+    let control = Router::new()
+        .route("/instance/promote", post(promote))
+        .route("/instance/demote", post(demote))
+        .layer(axum::middleware::from_fn_with_state(
+            control_plane_token,
+            control_plane_gate,
+        ));
+    Router::new()
+        .route("/instance/leadership", get(leadership))
+        .merge(control)
+}
+
+pub fn follower_router(st: LocalAppState) -> Router {
+    let role = st.role.clone();
+    crate::router::router(st).layer(axum::middleware::from_fn_with_state(role, role_gate))
+}
+
+fn is_gate_exempt(path: &str) -> bool {
+    matches!(
+        path,
+        "/" | "/readyz"
+            | "/instance/leadership"
+            | "/instance/promote"
+            | "/instance/demote"
+            | "/instance_name"
+            | "/instance_version"
+    )
+}
+
+async fn role_gate(
+    axum::extract::State(role): axum::extract::State<Arc<RoleState>>,
+    req: Request<Body>,
+    next: Next,
+) -> Response {
+    if role.is_leader() || is_gate_exempt(req.uri().path()) {
+        return next.run(req).await;
+    }
+    (
+        StatusCode::MISDIRECTED_REQUEST,
+        [(FOLLOWER_GATE_HEADER, "1")],
+        "This backend is a follower (warm standby) and does not serve client traffic. Route to \
+         the leader (or POST /instance/promote to promote it).",
+    )
+        .into_response()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use axum::{
+        response::Response,
+        routing::{
+            get,
+            post,
+        },
+        Router,
+    };
+    use common::{
+        persistence::Persistence,
+        shutdown::ShutdownSignal,
+    };
+    use http::StatusCode;
+    use tower::ServiceExt;
+
+    use super::{
+        role_gate,
+        DemotionCheck,
+        PromotionAttempt,
+        RoleState,
+        FOLLOWER_GATE_HEADER,
+    };
+
+    fn sqlite_persistence(dir: &tempfile::TempDir) -> Arc<dyn Persistence> {
+        let path = dir.path().join("role.sqlite3");
+        Arc::new(sqlite::SqlitePersistence::new(path.to_str().unwrap()).unwrap())
+    }
+
+    fn leader(dir: &tempfile::TempDir) -> Arc<RoleState> {
+        Arc::new(RoleState::new(
+            Some(sqlite_persistence(dir)),
+            ShutdownSignal::panic(),
+        ))
+    }
+
+    fn follower() -> Arc<RoleState> {
+        Arc::new(RoleState::new(None, ShutdownSignal::panic()))
+    }
+
+    fn gated_router(role: Arc<RoleState>) -> Router {
+        Router::new()
+            .route("/api/query", post(|| async { "ok" }))
+            .route("/instance_name", get(|| async { "name" }))
+            .route("/instance_version", get(|| async { "version" }))
+            .route("/instance/leadership", get(|| async { "leadership" }))
+            .route("/instance/promote", post(|| async { "promote" }))
+            .route("/instance/demote", post(|| async { "demote" }))
+            .route("/", get(|| async { "health" }))
+            .route("/readyz", get(|| async { "ready" }))
+            .layer(axum::middleware::from_fn_with_state(role, role_gate))
+    }
+
+    async fn respond(router: Router, method: &str, path: &str) -> Response {
+        let req = http::Request::builder()
+            .method(method)
+            .uri(path)
+            .body(axum::body::Body::empty())
+            .unwrap();
+        router.oneshot(req).await.unwrap()
+    }
+
+    async fn status_of(router: Router, method: &str, path: &str) -> StatusCode {
+        respond(router, method, path).await.status()
+    }
+
+    #[tokio::test]
+    async fn follower_is_gated_but_promotable() {
+        let role = follower();
+        let gated = respond(gated_router(role.clone()), "POST", "/api/query").await;
+        assert_eq!(gated.status(), StatusCode::MISDIRECTED_REQUEST);
+        assert_eq!(
+            gated
+                .headers()
+                .get(FOLLOWER_GATE_HEADER)
+                .map(|v| v.as_bytes()),
+            Some(b"1".as_slice()),
+        );
+        for (method, path) in [
+            ("GET", "/"),
+            ("GET", "/readyz"),
+            ("GET", "/instance_name"),
+            ("GET", "/instance_version"),
+            ("GET", "/instance/leadership"),
+            ("POST", "/instance/promote"),
+            ("POST", "/instance/demote"),
+        ] {
+            assert_eq!(
+                status_of(gated_router(role.clone()), method, path).await,
+                StatusCode::OK,
+                "{method} {path}"
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn demotion_is_compared_against_the_current_lease() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let role = leader(&dir);
+        assert_eq!(
+            status_of(gated_router(role.clone()), "POST", "/api/query").await,
+            StatusCode::OK,
+        );
+        assert!(matches!(
+            role.check_demotion(Some(7)),
+            DemotionCheck::LeaseChanged
+        ));
+        assert!(matches!(role.check_demotion(None), DemotionCheck::Leader));
+        assert!(matches!(
+            role.begin_promotion(),
+            PromotionAttempt::AlreadyLeader
+        ));
+    }
+}
