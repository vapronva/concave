@@ -0,0 +1,42 @@
+use super::*;
+use crate::function_log::ActionCompletion;
+
+impl<RT: Runtime> CronJobContext<RT> {
+    pub(super) async fn requeue(
+        &self,
+        completion: anyhow::Result<ActionCompletion>,
+        job: &CronJob,
+        updated_job: &CronJob,
+    ) -> anyhow::Result<ActionCompletion> {
+        let error = match completion {
+            Ok(completion) => return Ok(completion),
+            Err(error) => error,
+        };
+        if error.is_rejected_before_execution() {
+            let mut backoff = Backoff::new(INITIAL_BACKOFF, MAX_BACKOFF);
+            while let Err(mut err) = self.reset_rejected(job, updated_job).await {
+                let delay = backoff.fail(&mut self.rt.rng());
+                tracing::error!(
+                    "[concave] failed to requeue a rejected action, sleeping {delay:?}"
+                );
+                report_error(&mut err).await;
+                self.rt.wait(delay).await;
+            }
+        }
+        Err(error)
+    }
+
+    async fn reset_rejected(&self, job: &CronJob, updated_job: &CronJob) -> anyhow::Result<()> {
+        let Some(mut tx) = self
+            .new_transaction_for_job_state(updated_job, FunctionUsageTracker::new())
+            .await?
+        else {
+            return Ok(());
+        };
+        CronModel::new(&mut tx, job.component)
+            .update_job_state(job.cron_next_run())
+            .await?;
+        self.database.commit(tx, "cron_action_rejected").await?;
+        Ok(())
+    }
+}
