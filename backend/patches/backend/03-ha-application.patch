diff --git a/crates/application/src/scheduled_jobs/rejected.rs b/crates/application/src/scheduled_jobs/rejected.rs
new file mode 100644
index 000000000..67fd6e721
--- /dev/null
+++ b/crates/application/src/scheduled_jobs/rejected.rs
@@ -0,0 +1,49 @@
+use super::*;
+use crate::function_log::ActionCompletion;
+
+impl<RT: Runtime> ScheduledJobContext<RT> {
+    pub(super) async fn requeue(
+        &self,
+        completion: anyhow::Result<ActionCompletion>,
+        job_id: ResolvedDocumentId,
+        updated_job: &ScheduledJobMetadata,
+    ) -> anyhow::Result<ActionCompletion> {
+        let error = match completion {
+            Ok(completion) => return Ok(completion),
+            Err(error) => error,
+        };
+        if error.is_rejected_before_execution() {
+            let mut backoff =
+                Backoff::new(*SCHEDULED_JOB_INITIAL_BACKOFF, *SCHEDULED_JOB_MAX_BACKOFF);
+            while let Err(mut err) = self.reset_rejected(job_id, updated_job).await {
+                let delay = backoff.fail(&mut self.rt.rng());
+                tracing::error!(
+                    "[concave] failed to requeue a rejected action, sleeping {delay:?}"
+                );
+                report_error(&mut err).await;
+                self.rt.wait(delay).await;
+            }
+        }
+        Err(error)
+    }
+
+    async fn reset_rejected(
+        &self,
+        job_id: ResolvedDocumentId,
+        updated_job: &ScheduledJobMetadata,
+    ) -> anyhow::Result<()> {
+        let Some((mut tx, mut job)) = self
+            .new_transaction_for_job_state(job_id, updated_job, FunctionUsageTracker::new())
+            .await?
+        else {
+            return Ok(());
+        };
+        let namespace = tx.table_mapping().tablet_namespace(job_id.tablet_id)?;
+        job.state = ScheduledJobState::Pending;
+        SchedulerModel::new(&mut tx, namespace)
+            .replace(job_id, job)
+            .await?;
+        self.database.commit(tx, "scheduled_job_rejected").await?;
+        Ok(())
+    }
+}
