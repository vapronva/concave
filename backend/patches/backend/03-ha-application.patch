new file mode 100644
index 000000000..c4873bee0
--- /dev/null
+++ b/crates/application/src/ha.rs
@@ -0,0 +1,123 @@
+use ::integrations::LogManager;
+use database::SCHEMAS_TABLE;
+use model::initialize_application_system_tables;
+
+use super::*;
+
+#[derive(Debug, thiserror::Error)]
+#[error(
+    "database storage tag is not initialized: the leader has not finished initializing this \
+     database"
+)]
+pub struct StorageTagUninitialized;
+
+impl<RT: Runtime> Application<RT> {
+    pub(super) async fn open_application_storage(
+        runtime: RT,
+        database: &Database<RT>,
+        storage_type: &model::database_globals::types::StorageType,
+    ) -> anyhow::Result<ApplicationStorage> {
+        let files_storage =
+            create_storage(runtime.clone(), storage_type, StorageUseCase::Files).await?;
+        let modules_storage =
+            create_storage(runtime.clone(), storage_type, StorageUseCase::Modules).await?;
+        let search_storage =
+            create_storage(runtime.clone(), storage_type, StorageUseCase::SearchIndexes).await?;
+        let exports_storage =
+            create_storage(runtime.clone(), storage_type, StorageUseCase::Exports).await?;
+        let snapshot_imports_storage = create_storage(
+            runtime.clone(),
+            storage_type,
+            StorageUseCase::SnapshotImports,
+        )
+        .await?;
+        // Search storage needs to be set for Database to be fully initialized
+        database.set_search_storage(search_storage.clone());
+        Ok(ApplicationStorage {
+            files_storage,
+            modules_storage,
+            search_storage,
+            exports_storage,
+            snapshot_imports_storage,
+        })
+    }
+
+    pub async fn initialize_storage_readonly(
+        runtime: RT,
+        database: &Database<RT>,
+    ) -> anyhow::Result<ApplicationStorage> {
+        let storage_type = {
+            let mut tx = database.begin_system().await?;
+            if !tx
+                .table_mapping()
+                .namespace(value::TableNamespace::Global)
+                .name_exists(&model::database_globals::DATABASE_GLOBALS_TABLE)
+            {
+                anyhow::bail!(StorageTagUninitialized);
+            }
+            DatabaseGlobalsModel::new(&mut tx)
+                .database_globals()
+                .await?
+                .into_value()
+                .storage_type
+                .context(StorageTagUninitialized)?
+        };
+        let storage = Self::open_application_storage(runtime, database, &storage_type).await?;
+        tracing::info!(
+            "{:?} storage is configured (follower, read-only).",
+            storage_type
+        );
+        Ok(storage)
+    }
+
+    pub async fn become_leader(
+        &self,
+        rw_persistence: Arc<dyn Persistence>,
+        preempt_signal: ShutdownSignal,
+    ) -> anyhow::Result<()> {
+        tracing::info!("[promote] Application::become_leader: promoting Database");
+        let deleted_tablet_receiver = self
+            .database
+            .become_leader(
+                rw_persistence.clone(),
+                preempt_signal.clone(),
+                self.deployment.name.clone(),
+            )
+            .await?;
+        initialize_application_system_tables(&self.database).await?;
+        self.database
+            .load_indexes_into_memory(btreeset! { SCHEMAS_TABLE.clone() })
+            .await?;
+        self.start_log_manager().await?;
+        tracing::info!("[promote] Application::become_leader: starting leader workers");
+        self.start_leader_workers(rw_persistence, preempt_signal, deleted_tablet_receiver)
+            .await?;
+        tracing::info!("[promote] Application::become_leader complete");
+        Ok(())
+    }
+
+    pub(crate) async fn start_log_manager(&self) -> anyhow::Result<()> {
+        let log_streaming_allowed = {
+            let mut tx = self.database.begin(Identity::system()).await?;
+            let mut bi = BackendInfoModel::new(&mut tx);
+            bi.is_log_streaming_allowed().await?
+        };
+        let client = LogManager::start(
+            self.runtime.clone(),
+            self.database.clone(),
+            self.fetch_client.clone(),
+            self.sentry_transport.clone(),
+            self.deployment.name.clone(),
+            self.deployment.region.as_ref().map(|r| r.to_string()),
+            log_streaming_allowed,
+            self.usage_counter.clone(),
+        )
+        .await;
+        self.log_manager_client.replace_with(&client);
+        Ok(())
+    }
+
+    pub fn database(&self) -> &Database<RT> {
+        &self.database
+    }
+}
