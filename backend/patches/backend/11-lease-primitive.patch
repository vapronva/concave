@@ -0,0 +1,93 @@
+use common::errors::database_operational_error;
+
+use super::*;
+
+impl PostgresPersistence {
+    pub async fn schema_initialized(
+        pool: Arc<ConvexPgPool>,
+        options: PostgresReaderOptions,
+    ) -> anyhow::Result<bool> {
+        let schema = match &options.schema {
+            Some(s) => SchemaName::new(s)?,
+            None => SchemaName::new(&get_current_schema(&pool).await?)?,
+        };
+        let client = pool
+            .get_connection("schema_initialized", &schema, &options.instance_name)
+            .await?;
+        if client
+            .query_opt(sql::CHECK_LEASES_TABLE_SQL, &[])
+            .await?
+            .is_none()
+        {
+            return Ok(false);
+        }
+        let mut params = vec![];
+        if options.multitenant {
+            params.push(&options.instance_name.raw as &(dyn ToSql + Sync));
+        }
+        if client
+            .query_opt(sql::check_lease_row_exists(options.multitenant), &params)
+            .await?
+            .is_none()
+        {
+            return Ok(false);
+        }
+        Ok(client
+            .query_opt(sql::check_newly_created(options.multitenant), &params)
+            .await?
+            .is_some())
+    }
+}
+
+impl Lease {
+    pub(super) fn lease_ts(&self) -> i64 {
+        self.lease_ts
+    }
+
+    pub(super) async fn fatal_on_err<T>(
+        &self,
+        probe: impl std::future::Future<Output = anyhow::Result<T>>,
+    ) -> anyhow::Result<T> {
+        probe.await.inspect_err(|e| {
+            self.lease_lost_shutdown.signal(anyhow::anyhow!(
+                "persistence failed to initialize after acquiring the lease: {e:#}"
+            ))
+        })
+    }
+
+    pub(super) async fn lease_held(&self) -> anyhow::Result<bool> {
+        self.probe_lease_row().await.map_err(|e| {
+            let unreachable = e.downcast_ref::<tokio_postgres::Error>().is_some_and(|pg| {
+                pg.code()
+                    .is_none_or(|c| matches!(c.code().get(..2), Some("08" | "53" | "57")))
+            });
+            if unreachable {
+                database_operational_error(e)
+            } else {
+                e
+            }
+        })
+    }
+
+    async fn probe_lease_row(&self) -> anyhow::Result<bool> {
+        let lease_ts = self.lease_ts;
+        let mut client = self
+            .pool
+            .get_connection("lease_held", &self.schema, &self.instance_name)
+            .await?;
+        let multitenant = self.multitenant;
+        let instance_name = self.instance_name.clone();
+        let row = client
+            .with_retry(async move |client| {
+                let mut params = vec![&lease_ts as &(dyn ToSql + Sync)];
+                if multitenant {
+                    params.push(&instance_name.raw as &(dyn ToSql + Sync));
+                }
+                client
+                    .query_opt(sql::advisory_lease_check(multitenant), params.as_slice())
+                    .await
+            })
+            .await?;
+        Ok(row.is_some())
+    }
+}
