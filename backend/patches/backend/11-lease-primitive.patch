diff --git a/crates/postgres/src/ha.rs b/crates/postgres/src/ha.rs
new file mode 100644
index 000000000..04b74ae17
--- /dev/null
+++ b/crates/postgres/src/ha.rs
@@ -0,0 +1,124 @@
+use common::errors::database_operational_error;
+
+use super::*;
+
+const CHECK_LEASES_TABLE_SQL: &str = r"SELECT 1 WHERE to_regclass('@db_name.leases') IS NOT NULL";
+const LOCK_LEASES_SQL: &str = r"LOCK TABLE @db_name.leases IN EXCLUSIVE MODE";
+
+impl PostgresPersistence {
+    pub async fn schema_initialized(
+        pool: Arc<ConvexPgPool>,
+        options: PostgresReaderOptions,
+    ) -> anyhow::Result<bool> {
+        let schema = match &options.schema {
+            Some(s) => SchemaName::new(s)?,
+            None => SchemaName::new(&get_current_schema(&pool).await?)?,
+        };
+        let client = pool
+            .get_connection("schema_initialized", &schema, &options.instance_name)
+            .await?;
+        if client
+            .query_opt(CHECK_LEASES_TABLE_SQL, &[])
+            .await?
+            .is_none()
+        {
+            return Ok(false);
+        }
+        let newly_created =
+            Self::check_newly_created(&client, options.multitenant, &options.instance_name).await?;
+        Ok(!newly_created)
+    }
+}
+
+impl Lease {
+    pub(super) fn lease_ts(&self) -> i64 {
+        self.lease_ts
+    }
+
+    pub(super) async fn fatal_on_err<T>(
+        &self,
+        probe: impl std::future::Future<Output = anyhow::Result<T>>,
+    ) -> anyhow::Result<T> {
+        probe.await.inspect_err(|e| {
+            self.lease_lost_shutdown.signal(anyhow::anyhow!(
+                "persistence failed to initialize after acquiring the lease: {e:#}"
+            ))
+        })
+    }
+
+    pub(super) async fn lease_held(&self) -> anyhow::Result<bool> {
+        self.probe_lease_row().await.map_err(|e| {
+            let unreachable = e.downcast_ref::<tokio_postgres::Error>().is_some_and(|pg| {
+                pg.code()
+                    .is_none_or(|c| matches!(c.code().get(..2), Some("08" | "53" | "57")))
+            });
+            if unreachable {
+                database_operational_error(e)
+            } else {
+                e
+            }
+        })
+    }
+
+    async fn probe_lease_row(&self) -> anyhow::Result<bool> {
+        let lease_ts = self.lease_ts;
+        let mut client = self
+            .pool
+            .get_connection("lease_held", &self.schema, &self.instance_name)
+            .await?;
+        let multitenant = self.multitenant;
+        let instance_name = self.instance_name.clone();
+        let row = client
+            .with_retry(async move |client| {
+                let mut params = vec![&lease_ts as &(dyn ToSql + Sync)];
+                if multitenant {
+                    params.push(&instance_name.raw as &(dyn ToSql + Sync));
+                }
+                client
+                    .query_opt(sql::advisory_lease_check(multitenant), params.as_slice())
+                    .await
+            })
+            .await?;
+        Ok(row.is_some())
+    }
+}
+
+impl PostgresConnection<'_> {
+    pub(super) async fn steal_lease(
+        &mut self,
+        ts: i64,
+        instance_name: &PgInstanceName,
+        multitenant: bool,
+        allow_read_only: bool,
+    ) -> anyhow::Result<i64> {
+        let instance_name = instance_name.raw.clone();
+        let rows = assert_send(self.with_retry(async move |client| {
+            let lock = client.prepare_cached(LOCK_LEASES_SQL).await?;
+            let acquire = client
+                .prepare_cached(sql::lease_acquire(multitenant, allow_read_only))
+                .await?;
+            let mut params = vec![Param::Ts(ts)];
+            if multitenant {
+                params.push(Param::Text(instance_name.clone()));
+            }
+            let ((), _, rows, ()) = futures::try_join!(
+                client.batch_execute("BEGIN"),
+                client.execute(&lock, &[]),
+                async {
+                    client
+                        .query_raw(&acquire, &params)
+                        .await?
+                        .try_collect::<Vec<_>>()
+                        .await
+                },
+                client.batch_execute("COMMIT"),
+            )?;
+            Ok(rows)
+        }))
+        .await?;
+        Ok(rows
+            .first()
+            .context("failed to acquire lease: leases row missing, or read-only")?
+            .get(0))
+    }
+}
